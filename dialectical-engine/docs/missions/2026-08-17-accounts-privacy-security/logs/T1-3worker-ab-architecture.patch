+      .toBe(T1_N3_AB_PLATEAU_TRIPWIRE_MIB);
+    expect(safety.rssSafetyExceeded, "T1_N3_AB_RSS_SAFETY_EXCEEDED").toBe(false);
+    expect(safety.peakBytes, "T1_N3_AB_RSS_SAFETY_EXCEEDED")
+      .toBeLessThanOrEqual(T1_N3_AB_RSS_SAFETY_LIMIT_BYTES);
+    expect(opacityLeaks(), "T1_N3_AB_OPACITY").toBe(0);
+    if (positiveControl) {
+      expect(report.retainedMibPerWave, "T1_N3_AB_POSITIVE_CONTROL_RETAINS_4_MIB").toBe(4);
+      expect(plateau.red, "T1_N3_AB_POSITIVE_CONTROL_DRIVES_PLATEAU_RED").toBe(true);
+      return;
+    }
+    expect(report.retainedMibPerWave, "T1_N3_AB_ORDINARY_CELL_RETAINS_NOTHING").toBe(0);
+    expect(plateau.red, "T1_N3_AB_ORDINARY_CELL_PLATEAU_NOT_RED").toBe(false);
+    expect(lifecycle.closeError, "T1_N3_AB_ORDINARY_CELL_CLOSES_CLEANLY").toBeNull();
+    expect(lifecycle.state, "T1_N3_AB_ORDINARY_CELL_CLOSES_CLEANLY").toBe("CLOSED");
+    expect(lifecycle.liveHandles, "T1_N3_AB_ORDINARY_CELL_ZERO_HANDLES").toBe(0);
+    expect(lifecycle.retiringHandles, "T1_N3_AB_ORDINARY_CELL_ZERO_HANDLES").toBe(0);
+    expect(lifecycle.queued, "T1_N3_AB_ORDINARY_CELL_ZERO_HANDLES").toBe(0);
+    expect(lifecycle.outstanding, "T1_N3_AB_ORDINARY_CELL_ZERO_HANDLES").toBe(0);
+    expect(lifecycle.restarts, "T1_N3_AB_NO_RESTART_IN_ORDINARY_CELL").toBe(0);
+  };
+
+  it("T1 N3 AB architecture resource cell", async () => {
+    installCapture();
+    await startCellClock();
+    try {
+      const report = await runResourceChild(
+        `t1-n3-ab-resource-${T1_N3_AB_WORKERS}`, T1_N3_AB_WORKERS, 0
+      );
+      assertResourceCell(report, false);
+      stopCellClock();
+      emitReport({
+        outcome: "COMPLETE",
+        header: await header(),
+        ...report
+      });
+    } finally {
