+// ---------------------------------------------------------------------------
+describe("T1 N3 AB three-worker resource and lifecycle diagnostic", () => {
+  // Identifier-safe capture: this describe prints exactly one marker line per
+  // cell through `process.stdout.write`, and every console channel including
+  // `error` is captured rather than emitted, so a child's stray diagnostic can
+  // never smuggle a path or an identifier into a durable receipt.
+  const CONSOLE_CHANNELS = ["log", "info", "debug", "warn", "error", "trace"] as const;
+  const consoleSurface = console as unknown as Record<string, (...args: unknown[]) => void>;
+  const capturedConsole = new Map<string, (...args: unknown[]) => void>();
+  const capturedLines: string[] = [];
+  const installCapture = (): void => {
+    for (const channel of CONSOLE_CHANNELS) {
+      capturedConsole.set(channel, consoleSurface[channel]!);
+      consoleSurface[channel] = (...args: unknown[]): void => {
+        capturedLines.push(args.map((value) => {
+          if (typeof value === "string") return value;
+          try {
+            return JSON.stringify(value) ?? String(value);
+          } catch {
+            return "[uninspectable]";
+          }
+        }).join(" "));
+      };
+    }
+  };
+  const removeCapture = (): void => {
+    for (const [channel, original] of capturedConsole) consoleSurface[channel] = original;
+    capturedConsole.clear();
+  };
+  const forbidden = [
+    /[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/,
+    /\b[0-9a-f]{32,}\b/i,
+    /\$argon2/i,
+    /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i,
+    /\/(?:private\/)?(?:var|tmp)\/[^\s"']+/
+  ];
+  const opacityLeaks = (): number =>
+    capturedLines.filter((line) => forbidden.some((pattern) => pattern.test(line))).length;
+
+  const kdf = passwordKdf();
+  const emitReport = (body: Record<string, unknown>): void => {
+    process.stdout.write(`[T1_N3_AB_ARCHITECTURE_REPORT]${JSON.stringify({
+      artifact: "T1-3worker-ab-architecture-cell",
+      schemaVersion: 1,
+      packetSha256: T1_N3_AB_EXPECTED_PACKET_SHA256,
+      cellId: T1_N3_AB_CELL_ID,
+      workerCount: T1_N3_AB_WORKERS,
+      runCommitment: T1_N3_AB_RUN_COMMITMENT,
+      supervisedPid: Number(process.env.T1_N3_AB_SUPERVISED_PID),
+      supervisedPgid: Number(process.env.T1_N3_AB_SUPERVISED_PGID),
+      supervisedSid: Number(process.env.T1_N3_AB_SUPERVISED_SID),
+      rssBoundStatus: "UNRATIFIED_CANDIDATE",
+      provenanceClass: "VITEST_CHILD_PROCESS",
+      ...body
+    })}\n`);
+  };
+  const emitFaultReport = (body: Record<string, unknown>): void => {
+    process.stdout.write(`[T1_N3_AB_FAULT_REPORT]${JSON.stringify({
+      artifact: "T1-3worker-ab-fault-cell",
+      schemaVersion: 1,
+      packetSha256: T1_N3_AB_EXPECTED_PACKET_SHA256,
+      cellId: T1_N3_AB_CELL_ID,
+      workerCount: T1_N3_AB_WORKERS,
+      runCommitment: T1_N3_AB_RUN_COMMITMENT,
+      supervisedPid: Number(process.env.T1_N3_AB_SUPERVISED_PID),
+      supervisedPgid: Number(process.env.T1_N3_AB_SUPERVISED_PGID),
+      supervisedSid: Number(process.env.T1_N3_AB_SUPERVISED_SID),
+      ...body
+    })}\n`);
+  };
+  // The event loop of THIS process, monitored for the life of each cell, so the
+  // two delay fields the adjudicator validates are finite members of the exact
+  // header object rather than unrelated top-level child fields.
+  let cellEventLoop: {
+    enable(): void;
+    disable(): void;
+    percentile(value: number): number;
+    readonly max: number;
+  } | undefined;
+  const startCellClock = async (): Promise<void> => {
+    const { monitorEventLoopDelay } = await import("node:perf_hooks");
+    cellEventLoop = monitorEventLoopDelay({ resolution: 1 });
+    cellEventLoop.enable();
+  };
+  const stopCellClock = (): void => { cellEventLoop?.disable(); };
+
+  const header = async (): Promise<Record<string, unknown>> => {
+    const os = await import("node:os");
+    const usage = process.resourceUsage();
+    const p99 = cellEventLoop === undefined ? 0 : cellEventLoop.percentile(99) / 1e6;
+    const max = cellEventLoop === undefined ? 0 : cellEventLoop.max / 1e6;
+    return {
+      nodeVersion: process.version,
+      platform: process.platform,
+      arch: process.arch,
+      cpuModel: os.cpus()[0]?.model ?? "UNKNOWN",
+      cpuCount: os.cpus().length,
+      processPid: process.pid,
+      loadAverageAtStart: os.loadavg(),
+      loadAverageAtEnd: os.loadavg(),
+      swapDelta: usage.swappedOut,
+      majorPageFaultDelta: usage.majorPageFault,
+      minorPageFaultDelta: usage.minorPageFault,
+      eventLoopDelayP99Ms: Number.isFinite(p99) ? Number(p99.toFixed(3)) : 0,
+      eventLoopDelayMaxMs: Number.isFinite(max) ? Number(max.toFixed(3)) : 0
+    };
+  };
+
+  /**
+   * The matched resource child.
+   *
+   * One plain Node process per cell, identical for both worker counts except
+   * for the count itself: same eight maximum-cost jobs, same eight waves, same
+   * 5 ms sampler, same warm-up rule. Every RSS read goes through `observeRss`,
+   * which is also the 512 MiB safety stop, so no code path can read memory
+   * without the ceiling seeing it, and no wave starts after a breach.
+   */
+  const resourceChildSource = (workers: number, retainMib: number): string => `
+      const { Argon2WorkerPool } = await import(${JSON.stringify(`file://${poolPath}`)});
+      const { performance, monitorEventLoopDelay } = await import("node:perf_hooks");
+      const KDF = { memoryCostKiB: ${kdf.memoryCostKiB}, timeCost: ${kdf.timeCost},
+        parallelism: ${kdf.parallelism}, hashLength: ${kdf.hashLength} };
+      const LIMIT = ${T1_N3_AB_RSS_SAFETY_LIMIT_BYTES};
+      const workers = ${workers};
+      const retainMib = ${retainMib};
+      const safety = {
+        measuredPid: process.pid, peak: 0, peakSamples: [], samples: 0,
+        exceeded: false, exceededAt: null, admitWork: true
+      };
+      const observeRss = () => {
+        const rss = process.memoryUsage.rss();
+        safety.samples += 1;
+        if (rss > safety.peak) {
+          safety.peak = rss;
+          safety.peakSamples.push(rss);
+          if (safety.peakSamples.length > 256) safety.peakSamples.shift();
+        }
+        if (rss > LIMIT && !safety.exceeded) {
+          safety.exceeded = true;
+          safety.exceededAt = rss;
+          safety.admitWork = false;
+        }
+        return rss;
+      };
+      const loop = monitorEventLoopDelay({ resolution: 1 });
+      loop.enable();
+      // Whole-child coverage at 5 ms: the ruled ceiling applies to this Node
+      // process for its entire life, not only while a wave is in flight.
+      const backgroundSampler = setInterval(observeRss, 5);
+      backgroundSampler.unref && backgroundSampler.unref();
+      const pool = new Argon2WorkerPool({ workers });
+      // On breach: stop admitting, let bounded active work settle, close the
+      // pool, emit a structured secret-free safety report, exit EXACTLY 3.
+      const failSafe = async () => {
+        safety.admitWork = false;
+        try { await pool.close(); } catch (closeError) { void closeError; }
+        clearInterval(backgroundSampler);
+        loop.disable();
+        process.stdout.write("[T1_N3_AB_RSS_SAFETY_EXCEEDED]" + JSON.stringify({
+          workerCount: workers, limitBytes: LIMIT, measuredPid: safety.measuredPid,
+          peakBytes: safety.peak, exceededAtBytes: safety.exceededAt,
+          sampleIntervalMs: 5, samples: safety.samples, peakSampleBytes: safety.peakSamples
+        }) + "\\n");
+        process.exit(3);
+      };
+      const assertSafe = async () => { if (safety.exceeded) await failSafe(); };
+      await pool.ready();
+      observeRss(); await assertSafe();
+      const threadIds = new Set();
+      let mainThreadFallback = false;
+      for (const slot of pool.slots) {
+        const id = slot.handle && slot.handle.threadId;
+        if (typeof id !== "number") continue;
+        if (id === 0) mainThreadFallback = true; else threadIds.add(id);
+      }
+      const hash = (label, index) => pool.hashPassword(
+        new TextEncoder().encode(label + index), new Uint8Array(16).fill((index % 250) + 1), KDF
+      );
+      // T1-N3-AB-ANCHOR-M7-WARM-UP
+      const warmUpCount = workers;
+      let warmUpMaxActive = 0;
+      const warmUpWatcher = setInterval(() => {
+        warmUpMaxActive = Math.max(warmUpMaxActive, pool.stats().active);
+        observeRss();
+      }, 5);
+      const warmed = await Promise.all(Array.from({ length: warmUpCount }, (u, i) => hash("warm-", i)));
+      clearInterval(warmUpWatcher);
+      observeRss(); await assertSafe();
+      global.gc && global.gc();
+      const baselineRssBytes = observeRss();
+      await assertSafe();
+      const retained = [];
+      const perWave = [];
+      let totalSamples = 0;
+      for (let wave = 0; wave < ${T1_N3_AB_WAVE_COUNT}; wave += 1) {
+        await assertSafe();
+        let wavePeak = 0;
+        let samples = 0;
+        let maxActive = 0, maxQueued = 0, maxOutstanding = 0;
+        const sampler = setInterval(() => {
+          samples += 1; totalSamples += 1;
+          const stats = pool.stats();
+          maxActive = Math.max(maxActive, stats.active);
+          maxQueued = Math.max(maxQueued, stats.queuedTotal);
+          maxOutstanding = Math.max(maxOutstanding, stats.outstandingTotal);
+          // T1-N3-AB-ANCHOR-M6-RSS-SAMPLE
+          wavePeak = Math.max(wavePeak, observeRss());
+        }, 5);
+        const loopBefore = loop.count;
+        const results = await Promise.all(
+          Array.from({ length: ${T1_N3_AB_JOBS_PER_WAVE} }, (u, i) => hash("wave" + wave + "-", i))
+        );
+        clearInterval(sampler);
+        const loopProgress = loop.count - loopBefore;
+        if (retainMib > 0) retained.push(Buffer.alloc(retainMib * 1024 * 1024, wave + 1));
+        global.gc && global.gc();
+        await new Promise((resolve) => setImmediate(resolve));
+        const quiescentRssBytes = observeRss();
+        perWave.push({
+          waveIndex: wave, jobCount: results.length, sampleCount: samples,
+          inFlightPeakRssBytes: wavePeak, quiescentRssBytes,
+          maxActive, maxQueued, maxOutstanding, eventLoopProgressTicks: loopProgress
+        });
+        await assertSafe();
+      }
+      const settledRssBytes = observeRss();
+      const statsAtSettle = pool.stats();
+      const closeStartedAt = performance.now();
+      let closeError = null;
+      try { await pool.close(); } catch (error) { closeError = String(error && error.code || "UNTYPED"); }
+      const closeLatencyMs = performance.now() - closeStartedAt;
+      const closed = pool.stats();
+      global.gc && global.gc();
+      const postCloseRssBytes = observeRss();
+      // Measurement only. This is the monotonic close-initiation-to-teardown
+      // duration, NOT a prompt-exit bound: no such threshold is ratified.
+      const closeInitiationToTeardownCompleteMs = performance.now() - closeStartedAt;
+      clearInterval(backgroundSampler);
+      loop.disable();
+      const lastFour = perWave.slice(-4).map((w) => w.quiescentRssBytes);
+      const spreadMib = (Math.max(...lastFour) - Math.min(...lastFour)) / 1048576;
+      process.stdout.write("[T1_N3_AB_ARCHITECTURE_CHILD]" + JSON.stringify({
+        warmUp: { warmedWorkers: warmed.length, maxActiveDuringWarmUp: warmUpMaxActive },
+        threads: { distinctNonMainThreadCount: threadIds.size, mainThreadFallback },
+        inFlight: { sampleIntervalMs: 5, sampleCount: totalSamples },
+        jobsPerWave: ${T1_N3_AB_JOBS_PER_WAVE},
+        waveCount: perWave.length,
+        baselineRssBytes, settledRssBytes, postCloseRssBytes,
+        closeLatencyMs: Number(closeLatencyMs.toFixed(3)),
+        retainedMibPerWave: retainMib,
+        retainedBuffers: retained.length,
+        perWave,
+        plateau: {
+          tripwireMib: ${T1_N3_AB_PLATEAU_TRIPWIRE_MIB},
+          lastFourWaveSpreadMib: Number(spreadMib.toFixed(3)),
+          red: spreadMib > ${T1_N3_AB_PLATEAU_TRIPWIRE_MIB}
+        },
+        lifecycle: {
+          state: closed.state, liveHandles: closed.liveHandles,
+          retiringHandles: closed.retiringHandles, queued: closed.queuedTotal,
+          outstanding: closed.outstandingTotal, restarts: closed.restartsInWindow,
+          closeError, workersAtSettle: statsAtSettle.workers,
+          closeInitiationToTeardownCompleteMs:
+            Number(closeInitiationToTeardownCompleteMs.toFixed(3))
+        },
+        eventLoopDelayP99Ms: Number((loop.percentile(99) / 1e6).toFixed(3)),
+        eventLoopDelayMaxMs: Number((loop.max / 1e6).toFixed(3)),
+        rssSafety: {
+          rssSafetyExceeded: safety.exceeded, limitBytes: LIMIT,
+          exceededAtBytes: safety.exceededAt, peakBytes: safety.peak,
+          measuredPid: safety.measuredPid, sampleIntervalMs: 5,
+          samples: safety.samples, peakSampleBytes: safety.peakSamples,
+          admittedWorkAtEnd: safety.admitWork
+        }
+      }) + "\\n");
+  `;
+
+  const runResourceChild = async (
+    name: string, workers: number, retainMib: number
+  ): Promise<Record<string, unknown>> => {
+    const script = join(scratch, `${name}.mjs`);
+    await writeFile(script, resourceChildSource(workers, retainMib), "utf8");
