+    return JSON.parse(line!.slice("[T1_N3_AB_ARCHITECTURE_CHILD]".length)) as Record<string, unknown>;
+  };
+
+  const assertResourceCell = (report: Record<string, unknown>, positiveControl: boolean): void => {
+    const warmUp = report.warmUp as { warmedWorkers: number; maxActiveDuringWarmUp: number };
+    const threads = report.threads as { distinctNonMainThreadCount: number; mainThreadFallback: boolean };
+    const inFlight = report.inFlight as { sampleIntervalMs: number; sampleCount: number };
+    const perWave = report.perWave as {
+      jobCount: number; sampleCount: number; inFlightPeakRssBytes: number;
+      quiescentRssBytes: number; maxActive: number; maxQueued: number;
+      maxOutstanding: number; eventLoopProgressTicks: number;
+    }[];
+    const plateau = report.plateau as { tripwireMib: number; red: boolean };
+    const lifecycle = report.lifecycle as {
+      state: string; liveHandles: number; retiringHandles: number;
+      queued: number; outstanding: number; restarts: number; closeError: string | null;
+    };
+    const safety = report.rssSafety as { rssSafetyExceeded: boolean; peakBytes: number };
+
+    expect(warmUp.warmedWorkers, "T1_N3_AB_WARM_UP_COVERED_EVERY_WORKER").toBe(T1_N3_AB_WORKERS);
+    expect(warmUp.maxActiveDuringWarmUp, "T1_N3_AB_WARM_UP_COVERED_EVERY_WORKER")
