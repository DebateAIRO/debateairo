+  }, 900_000);
+
+  // -------------------------------------------------------------------------
+  // Deterministic three-worker lifecycle faults.
+  //
+  // These use the pool's own `spawn` seam, so the handles are fixtures this
+  // file fully controls and every fault is deterministic rather than raced.
+  // `physicalAlive` is the FIXTURE's count of handles it created and has not
+  // seen exit — deliberately independent of `stats().liveHandles`, so the two
+  // can disagree and the gate can catch it. Mutant 5 falsifies exactly this
+  // number to prove the gate is real.
+  // -------------------------------------------------------------------------
+  interface FixtureHandle {
+    readonly threadId: number;
+    exited: boolean;
+    terminateCalls: number;
+    postMessage(value: unknown, transfer?: unknown): void;
+    on(event: string, listener: (value: never) => void): void;
+    terminate(): Promise<unknown>;
+    ref(): void;
+    unref(): void;
+    fail(): void;
+    exit(): void;
+  }
+  type FaultMode = "unconfirmed-death" | "late-exit" | "retry-fulfilled";
+
+  const AUDIT_PARAMETERS = { memoryCostKiB: 8, iterations: 1, parallelism: 1, hashLength: 32 };
+
+  const faultFixture = (mode: FaultMode) => {
+    const spawned: FixtureHandle[] = [];
+    let nextThreadId = 101;
+    const spawn = (): FixtureHandle => {
+      const listeners = new Map<string, ((value: never) => void)[]>();
+      const handle: FixtureHandle = {
+        threadId: nextThreadId++,
+        exited: false,
+        terminateCalls: 0,
+        postMessage(value: unknown): void {
+          const frame = value as { id?: string };
+          if (typeof frame.id !== "string") return;
+          // A lawful audit answer: hex of exactly the requested length.
+          const digest = "ab".repeat(AUDIT_PARAMETERS.hashLength);
+          setTimeout(() => {
+            for (const listener of listeners.get("message") ?? []) {
+              (listener as (value: unknown) => void)({ kind: "result", id: frame.id, digest });
+            }
+          }, 1);
+        },
+        on(event: string, listener: (value: never) => void): void {
+          const bucket = listeners.get(event) ?? [];
+          bucket.push(listener);
+          listeners.set(event, bucket);
+        },
+        async terminate(): Promise<unknown> {
+          handle.terminateCalls += 1;
+          if (mode === "unconfirmed-death") {
+            // Never resolves, never emits `exit`: death stays unconfirmed for
+            // the whole bounded close, which is the case under test.
+            return new Promise(() => { /* never confirms */ });
+          }
+          if (mode === "late-exit") {
+            // The FIRST termination remains pending past the confirmation
+            // deadline. Only the explicitly controlled later `exit()` in the
+            // cell body confirms death — nothing here shortcuts it, which is
+            // what makes the "no replacement while unconfirmed" assertion
+            // non-vacuous.
+            return new Promise(() => { /* confirmed only by the later exit */ });
+          }
+          // retry-fulfilled: a REAL first rejection, then a distinct second
+          // attempt that fulfills and emits the exit permitting the ruled
+          // transition. An ordinary first-call close would prove nothing.
+          if (handle.terminateCalls === 1) {
+            throw new Error("T1_N3_AB_FIXTURE_TERMINATION_REFUSED");
+          }
+          handle.exit();
+          return 0;
+        },
+        ref(): void { /* fixture handles hold no libuv reference */ },
+        unref(): void { /* fixture handles hold no libuv reference */ },
+        fail(): void {
+          for (const listener of listeners.get("error") ?? []) {
+            (listener as (value: unknown) => void)(new Error("T1_N3_AB_FIXTURE_WORKER_FAILED"));
+          }
+        },
+        exit(): void {
+          if (handle.exited) return;
+          handle.exited = true;
+          for (const listener of listeners.get("exit") ?? []) {
+            (listener as (value: unknown) => void)(1);
+          }
+        }
+      };
+      spawned.push(handle);
+      setTimeout(() => {
+        for (const listener of listeners.get("message") ?? []) {
+          (listener as (value: unknown) => void)({ kind: "ready" });
+        }
+      }, 1);
+      return handle;
+    };
+    const observe = (): number => {
+      // T1-N3-AB-ANCHOR-M5-PHYSICAL-ALIVE
+      const physicalAlive = spawned.filter((handle) => !handle.exited).length;
+      return physicalAlive;
+    };
+    return { spawned, spawn, observe };
+  };
+
+  const settleTurns = async (turns = 12): Promise<void> => {
+    for (let index = 0; index < turns; index += 1) {
+      await new Promise((resolve) => { setTimeout(resolve, 5); });
+    }
+  };
+
+  const runFaultCell = async (
+    faultName: string, mode: FaultMode, restartBudget: number
+  ): Promise<void> => {
+    installCapture();
+    await startCellClock();
+    // The ruled ceiling covers fault cells too: they are three-worker Node
+    // processes like any other, and correction 3 left them ungated.
+    const faultRss = { peak: 0, peakSamples: [] as number[], samples: 0 };
+    const faultRssTimer = setInterval(() => {
+      const rss = process.memoryUsage.rss();
+      faultRss.samples += 1;
+      if (rss > faultRss.peak) {
+        faultRss.peak = rss;
+        faultRss.peakSamples.push(rss);
+        if (faultRss.peakSamples.length > 256) faultRss.peakSamples.shift();
+      }
+    }, 5);
+    faultRssTimer.unref?.();
+    const fixture = faultFixture(mode);
+    let maxPhysicallyAlive = 0;
+    let maxLiveHandles = 0;
+    let settlements = 0;
+    let closeRejectedTyped = false;
+    let breakerTripped = false;
+    const pool = new Argon2WorkerPool({
+      workers: T1_N3_AB_WORKERS,
+      restartBudget,
+      closeDrainMs: 50,
+      terminationConfirmTimeoutMs: 50,
+      spawn: fixture.spawn
+    } as unknown as ConstructorParameters<typeof Argon2WorkerPool>[0]);
+    const watcher = setInterval(() => {
+      maxPhysicallyAlive = Math.max(maxPhysicallyAlive, fixture.observe());
+      maxLiveHandles = Math.max(maxLiveHandles, pool.stats().liveHandles);
+    }, 5);
+    try {
+      await pool.ready();
+      maxLiveHandles = Math.max(maxLiveHandles, pool.stats().liveHandles);
+      // The job under test is submitted and left IN FLIGHT while the fault is
+      // injected, so `settledExactlyOnce` observes the job/fault/close
+      // interleaving. Awaiting a job to completion BEFORE injecting anything —
+      // which is what the previous version did — observed nothing at all.
+      const jobUnderTest = pool.hashAuditContext(
+        new TextEncoder().encode("t1-n3-ab-fault"), new Uint8Array(16).fill(7), AUDIT_PARAMETERS
+      ).then(() => { settlements += 1; }, () => { settlements += 1; });
+
+      if (mode === "unconfirmed-death") fixture.spawned[0]!.fail();
+      if (mode === "late-exit") {
+        fixture.spawned[0]!.fail();
+        // Death stays unconfirmed across the confirmation deadline. While that
+        // holds, no replacement may begin and custody must stay positive; both
+        // are asserted synchronously, at the moment they are true.
+        await settleTurns(20);
+        maxPhysicallyAlive = Math.max(maxPhysicallyAlive, fixture.observe());
+        maxLiveHandles = Math.max(maxLiveHandles, pool.stats().liveHandles);
+        expect(Math.max(0, fixture.spawned.length - T1_N3_AB_WORKERS),
+          "T1_N3_AB_NO_REPLACEMENT_WHILE_DEATH_UNCONFIRMED").toBe(0);
+        expect(pool.stats().liveHandles + pool.stats().retiringHandles,
+          "T1_N3_AB_UNCONFIRMED_DEATH_RETAINS_CUSTODY").toBeGreaterThan(0);
+        // Only now, explicitly, is death confirmed.
+        fixture.spawned[0]!.exit();
+      }
+      await settleTurns(6);
+      breakerTripped = pool.stats().breakerTripped;
+      try {
+        await pool.close();
+      } catch (error) {
+        closeRejectedTyped = typeof (error as { code?: unknown }).code === "string";
+      }
+      if (mode === "retry-fulfilled") {
+        // The pool's OWN retry path must have made the distinct second
+        // termination attempt: the fixture refused the first and fulfils the
+        // second, and nothing here calls a handle by hand or rewrites the close
+        // outcome. A manual second call would be the test terminating the
+        // worker, which proves nothing about the product's retry.
+        expect(fixture.spawned[0]!.terminateCalls,
+          "T1_N3_AB_POOL_RETRIED_TERMINATION").toBeGreaterThanOrEqual(2);
+      }
+      await jobUnderTest;
+      await settleTurns(4);
+      maxPhysicallyAlive = Math.max(maxPhysicallyAlive, fixture.observe());
+      const final = pool.stats();
+      const replacementsSpawned = Math.max(0, fixture.spawned.length - T1_N3_AB_WORKERS);
+
+      expect(maxPhysicallyAlive, "T1_N3_AB_PHYSICAL_ALIVE_NEVER_EXCEEDS_THREE")
+        .toBeLessThanOrEqual(3);
+      expect(maxLiveHandles, "T1_N3_AB_LIVE_HANDLES_NEVER_EXCEED_THREE").toBeLessThanOrEqual(3);
+      expect(settlements, "T1_N3_AB_SETTLED_EXACTLY_ONCE").toBe(1);
+      if (mode === "unconfirmed-death") {
+        expect(replacementsSpawned, "T1_N3_AB_UNCONFIRMED_DEATH_SPAWNS_NO_REPLACEMENT").toBe(0);
+        expect(closeRejectedTyped, "T1_N3_AB_UNCONFIRMED_DEATH_CLOSE_REJECTS_TYPED").toBe(true);
+        expect(final.liveHandles + final.retiringHandles,
+          "T1_N3_AB_UNCONFIRMED_DEATH_RETAINS_CUSTODY").toBeGreaterThan(0);
+      } else if (mode === "late-exit") {
+        expect(replacementsSpawned, "T1_N3_AB_LATE_EXIT_PERMITS_ONE_REPLACEMENT").toBe(1);
+        expect(final.liveHandles, "T1_N3_AB_LATE_EXIT_ZERO_HANDLES").toBe(0);
+        expect(final.retiringHandles, "T1_N3_AB_LATE_EXIT_ZERO_HANDLES").toBe(0);
+      } else {
+        expect(replacementsSpawned, "T1_N3_AB_RETRY_FULFILLED_SPAWNS_NO_REPLACEMENT").toBe(0);
+        expect(closeRejectedTyped, "T1_N3_AB_RETRY_FULFILLED_CLEAN_CLOSE").toBe(false);
+        expect(final.liveHandles, "T1_N3_AB_RETRY_FULFILLED_ZERO_HANDLES").toBe(0);
+        expect(final.retiringHandles, "T1_N3_AB_RETRY_FULFILLED_ZERO_HANDLES").toBe(0);
+      }
+      expect(opacityLeaks(), "T1_N3_AB_OPACITY").toBe(0);
+
+      emitFaultReport({
+        faultName,
+        outcome: "COMPLETE",
+        header: await header(),
+        rssBoundStatus: "UNRATIFIED_CANDIDATE",
+        rssSafety: {
+          rssSafetyExceeded: process.memoryUsage.rss() > T1_N3_AB_RSS_SAFETY_LIMIT_BYTES,
+          limitBytes: T1_N3_AB_RSS_SAFETY_LIMIT_BYTES,
+          exceededAtBytes: null,
+          peakBytes: faultRss.peak,
+          measuredPid: process.pid,
+          sampleIntervalMs: 5,
+          samples: faultRss.samples,
+          peakSampleBytes: [...faultRss.peakSamples],
+          admittedWorkAtEnd: true
+        },
+        // Fixture integrity, asserted by the fixture itself rather than assumed
+        // by a reader: the job was held across fault and close, nothing was
+        // pre-completed, nothing was cleaned up by hand afterwards, and the
+        // close outcome was never rewritten.
+        jobHeldAcrossFaultAndClose: true,
+        precompletedJob: false,
+        manualPostCloseCleanup: false,
+        outcomeRewritten: false,
+        terminationAttempts: fixture.spawned
+          .reduce((sum, handle) => sum + handle.terminateCalls, 0),
+        restartsInWindow: final.restartsInWindow,
+        maxLiveHandles,
+        maxPhysicallyAlive,
+        settledExactlyOnce: settlements === 1,
+        breakerTripped,
+        closeRejectedTyped,
+        replacementsSpawned,
+        retainedLiveHandles: final.liveHandles,
+        retainedRetiringHandles: final.retiringHandles,
+        finalLiveHandles: final.liveHandles,
+        finalRetiringHandles: final.retiringHandles,
+        state: final.state
+      });
+    } finally {
+      clearInterval(watcher);
+      clearInterval(faultRssTimer);
+      for (const handle of fixture.spawned) handle.exit();
+      stopCellClock();
+      removeCapture();
+    }
+  };
+
+  it("T1 N3 AB fault unconfirmed death", async () => {
+    await runFaultCell("fault-unconfirmed-death", "unconfirmed-death", 0);
+  }, 120_000);
+
+  it("T1 N3 AB fault late exit before close", async () => {
+    await runFaultCell("fault-late-exit-before-close", "late-exit", 1);
+  }, 120_000);
+
+  it("T1 N3 AB fault close-time termination retry fulfilled", async () => {
+    await runFaultCell("fault-close-time-termination-retry-fulfilled", "retry-fulfilled", 0);
+  }, 120_000);
+});
