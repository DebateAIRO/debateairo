+
+  it("T1 N3 AB retained allocation positive control", async () => {
+    installCapture();
+    await startCellClock();
+    try {
+      // The tripwire has to be able to go RED, or the eight ordinary readings
+      // above are the output of a detector that measures nothing.
+      const report = await runResourceChild("t1-n3-ab-positive-control", T1_N3_AB_WORKERS, 4);
+      assertResourceCell(report, true);
+      stopCellClock();
+      emitReport({ outcome: "COMPLETE", header: await header(), ...report });
