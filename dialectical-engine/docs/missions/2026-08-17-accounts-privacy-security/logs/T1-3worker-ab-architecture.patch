+    expect(threads.distinctNonMainThreadCount, "T1_N3_AB_DISTINCT_THREAD_EVIDENCE")
+      .toBe(T1_N3_AB_WORKERS);
+    expect(threads.mainThreadFallback, "T1_N3_AB_MAIN_THREAD_FALLBACK").toBe(false);
+    expect(inFlight.sampleIntervalMs, "T1_N3_AB_RSS_SAMPLED_IN_FLIGHT").toBe(5);
+    expect(inFlight.sampleCount, "T1_N3_AB_RSS_SAMPLED_IN_FLIGHT").toBeGreaterThan(0);
+    expect(report.jobsPerWave, "T1_N3_AB_IDENTICAL_EIGHT_JOB_WORK").toBe(T1_N3_AB_JOBS_PER_WAVE);
+    expect(perWave, "T1_N3_AB_EIGHT_IDENTICAL_WAVES").toHaveLength(T1_N3_AB_WAVE_COUNT);
+    expect(Number.isFinite(report.baselineRssBytes as number), "T1_N3_AB_RSS_READINGS_FINITE")
+      .toBe(true);
+    expect(Number.isFinite(report.settledRssBytes as number), "T1_N3_AB_RSS_READINGS_FINITE")
+      .toBe(true);
+    expect(Number.isFinite(report.postCloseRssBytes as number), "T1_N3_AB_RSS_READINGS_FINITE")
+      .toBe(true);
+    expect(Number.isFinite(report.closeLatencyMs as number), "T1_N3_AB_CLOSE_LATENCY_MEASURED")
+      .toBe(true);
+    for (const wave of perWave) {
+      expect(wave.jobCount, "T1_N3_AB_IDENTICAL_EIGHT_JOB_WORK").toBe(T1_N3_AB_JOBS_PER_WAVE);
+      expect(wave.sampleCount, "T1_N3_AB_RSS_SAMPLED_IN_FLIGHT").toBeGreaterThan(0);
+      expect(wave.inFlightPeakRssBytes, "T1_N3_AB_RSS_SAMPLED_IN_FLIGHT")
+        .toBeGreaterThanOrEqual(wave.quiescentRssBytes);
+      expect(wave.maxActive, "T1_N3_AB_WAVE_OCCUPANCY").toBe(T1_N3_AB_WORKERS);
+      expect(wave.maxOutstanding, "T1_N3_AB_WAVE_OCCUPANCY").toBe(T1_N3_AB_JOBS_PER_WAVE);
+      expect(wave.maxQueued, "T1_N3_AB_WAVE_OCCUPANCY")
+        .toBeGreaterThanOrEqual(T1_N3_AB_JOBS_PER_WAVE - T1_N3_AB_WORKERS);
+      expect(wave.eventLoopProgressTicks, "T1_N3_AB_EVENT_LOOP_PROGRESS").toBeGreaterThan(0);
+    }
