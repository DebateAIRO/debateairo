+      expect(ordinals, "T1_N3_AB_OUTCOME_COUNT").toHaveLength(EXPECTED_OUTCOMES);
+      expect(successes, "T1_N3_AB_OUTCOME_COUNT").toBe(EXPECTED_OUTCOMES);
+      expect(Number(committedMissing.rows[0]!.count), "T1_N3_AB_DURABLE_ROWS").toBe(12);
+      expect(Number(committedExisting.rows[0]!.count), "T1_N3_AB_DURABLE_ROWS").toBe(3);
+      expect(measuredSends, "T1_N3_AB_DURABLE_ROWS").toBe(12);
+      expect(unmappedSettlements, "T1_N3_AB_ORDINAL_MAP_COVERS_EVERY_CREDENTIAL_JOB").toBe(0);
+      expect(jobSpans, "T1_N3_AB_ORDINAL_MAP_COVERS_EVERY_CREDENTIAL_JOB")
