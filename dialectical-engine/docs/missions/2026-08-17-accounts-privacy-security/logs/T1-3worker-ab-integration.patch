+      expect(duplicateEnqueueStamps, "T1_N3_AB_EXACTLY_ONE_ENQUEUE_PER_JOB").toBe(0);
+      expect(duplicateDispatchStamps, "T1_N3_AB_EXACTLY_ONE_DISPATCH_PER_JOB").toBe(0);
+      expect(identityMaxSkewMs, "T1_N3_AB_SPAN_ARITHMETIC_IDENTITY")
