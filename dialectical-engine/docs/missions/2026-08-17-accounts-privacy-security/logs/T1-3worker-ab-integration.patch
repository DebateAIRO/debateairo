+          .toBeGreaterThan(0);
+      }
+      if (observed.maxQueuedCredential >= 1) {
+        expect(Math.max(...jobSpans.map((span) => span.dispatchedAt - span.enqueuedAt)),
+          "T1_N3_AB_QUEUE_OBSERVED_BUT_NO_DWELL").toBeGreaterThan(0);
+      }
+      expect(idToOrdinal.size, "T1_N3_AB_ORDINAL_MAP_EMPTY_AFTER_DRAIN").toBe(0);
+      expect(enqueueAt.size, "T1_N3_AB_ORDINAL_MAP_EMPTY_AFTER_DRAIN").toBe(0);
+      expect(dispatchAt.size, "T1_N3_AB_ORDINAL_MAP_EMPTY_AFTER_DRAIN").toBe(0);
