{
  "schema_version": 1,
  "policy_ref": "fixagent-policy-v1",
  "production_source_globs": [
    "apps/*/src/**",
    "packages/**/src/**",
    "apps/ui/app/**",
    "apps/ui/components/**",
    "apps/ui/lib/**"
  ],
  "tier_rules": {
    "QUICK": {
      "authority": "LABEL_ONLY",
      "route": "APPROVAL_FIRST",
      "max_production_files": 1,
      "max_test_files": 1,
      "production_line_cap": 20,
      "total_line_cap": 50,
      "requires_red_green": true
    },
    "PR_FIX": {
      "authority": "LABEL_ONLY",
      "route": "APPROVAL_FIRST"
    },
    "ESCALATE": {
      "authority": "LABEL_ONLY",
      "route": "REPORT_ONLY"
    }
  },
  "floor_deny_globs": [
    "apps/api/src/registration.ts",
    "apps/api/src/mail-channel.ts",
    "apps/api/src/mfa.ts",
    "apps/api/dist/mail-channel.js",
    "apps/api/dist/mfa.js",
    "apps/api/dist/registration.js",
    "dist/apps/api/src/mail-channel.js",
    "dist/apps/api/src/mfa.js",
    "dist/apps/api/src/registration.js",
    "dist/packages/db/src/identity.js",
    "packages/db/dist/identity.js",
    "packages/db/src/identity.ts",
    "packages/db/src/obs-schema.ts",
    "packages/obs-capture/**",
    "migrations/**",
    "packages/crypto/**",
    "packages/published-arithmetic/**",
    "packages/propagation/**",
    "packages/judgement/**",
    "packages/serve/**",
    "packages/settlement/**",
    "packages/valuation/**",
    "packages/budget/**",
    "package.json",
    "**/package.json",
    "pnpm-lock.yaml",
    "**/pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "register.bootstrap.json",
    "**/register.bootstrap.json",
    "**/*register-seed*.json",
    "compose*.yaml",
    "compose*.yml",
    "**/compose*.yaml",
    "**/compose*.yml",
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    ".github/**",
    "deploy/**",
    "scripts/**",
    "packages/register/src/compose-env.ts",
    "packages/register/src/runtime-environment.ts",
    "tools/**",
    "docs/agent-protocols/**",
    ".hermes/**"
  ],
  "allowlist": [],
  "taxonomy_pin": {
    "classes": [
      "PROCESS_DEATH",
      "HTTP_FAILURE",
      "JOB_FAILURE",
      "PROVIDER_EXHAUSTED",
      "DB_FAILURE",
      "PARSE_SCHEMA_FAILURE",
      "STALL_DETECTED",
      "SILENT_NOOP",
      "SUSPICIOUS_SUCCESS",
      "CLIENT_FAILURE",
      "CAPTURE_SELF",
      "ORIGIN_UNKNOWN"
    ],
    "suspicious_success_subclasses": [
      "empty_output",
      "missing_required_fields",
      "missing_artifact_chain"
    ]
  },
  "severity_map": {
    "ladder": ["INFO", "DEGRADED", "SEVERE", "FATAL"],
    "default": "DEGRADED",
    "overrides": {},
    "severe_threshold": "SEVERE"
  },
  "routing_table": [
    { "incident_class": "SECURITY_PRIVACY", "owner": "V" },
    { "incident_class": "PERSISTENCE_MIGRATIONS", "owner": "V" },
    { "incident_class": "SPEND", "owner": "V" },
    { "incident_class": "SCORING_LIVE_DATA", "owner": "V" },
    { "incident_class": "DEFAULT", "owner": "V" }
  ],
