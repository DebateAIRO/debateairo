<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.debateai.obs-listener</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BINARY__</string>
    <string>__DIALECTICAL_ENGINE_ROOT__/tools/obs-listener/dist/src/daemon.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DIALECTICAL_ENGINE_ROOT__</string>
  <key>UserName</key>
  <string>__LISTENER_OS_USER__</string>
  <key>GroupName</key>
  <string>__LISTENER_OS_GROUP__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OBS_LISTENER_DATABASE_URL</key>
    <string>__LISTENER_DATABASE_URL__</string>
    <key>OBS_LISTENER_POLL_INTERVAL_MS</key>
    <string>__LISTENER_POLL_INTERVAL_MS__</string>
    <key>OBS_CONTROL_DIR</key>
    <string>__OBS_CONTROL_DIR__</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIRECTORY__/obs-listener.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIRECTORY__/obs-listener.stderr.log</string>
</dict>
</plist>
