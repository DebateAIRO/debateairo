{
  "name": "dialectical-engine-v2ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build && node ../../scripts/assert-auth-front-door-routes.mjs . apps-ui",
    "start": "node server.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-node-tests.mjs",
    "story:mock": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx ../../tools/story-mock.tsx",
    "story:sample-pdf": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --import tsx scripts/story-sample-pdf.ts"
  },
  "dependencies": {
    "@debateai/contract": "workspace:*",
    "@debateai/kernel": "workspace:*",
    "@debateai/legal-manifest": "workspace:*",
    "@debateai/support-kb": "workspace:*",
    "@react-pdf/renderer": "4.9.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fontkit": "2.0.4",
    "typescript": "5.9.3"
  }
}
