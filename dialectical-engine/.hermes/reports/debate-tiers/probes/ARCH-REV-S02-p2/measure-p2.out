 767| export async function migrate(pool: Pool): Promise<void> {
 768|   const directory = new URL("../../../migrations/", import.meta.url);
 769|   const migrations = (await readdir(directory)).filter((name) => /^\d+.*\.sql$/.test(name)).sort();
 770|   const client = await pool.connect();
 771|   try {
 772|     await client.query("BEGIN");
 773|     await client.query("SELECT pg_advisory_xact_lock(hashtextextended('debateai:schema-migrations', 0))");
 774|     await client.query(`
 775|       CREATE TABLE IF NOT EXISTS public.debateai_schema_migration (
 776|         name text PRIMARY KEY CHECK (length(btrim(name)) > 0),
 777|         applied_at timestamptz NOT NULL
 778|       )
 779|     `);
 780|     for (const name of migrations) {
 781|       const applied = await client.query("SELECT 1 FROM public.debateai_schema_migration WHERE name=$1", [name]);
 782|       if (applied.rowCount !== 0) continue;
 783|       await client.query(await readFile(new URL(name, directory), "utf8"));
 784|       await client.query(
 785|         "INSERT INTO public.debateai_schema_migration (name, applied_at) VALUES ($1, statement_timestamp())",
 786|         [name]
 787|       );
 788|     }
 789|     await client.query("COMMIT");
 790|   } catch (error) {
 791|     await client.query("ROLLBACK");
 792|     throw error;
 793|   } finally {
 794|     client.release();
 795|   }
 796| }

