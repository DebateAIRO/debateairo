 +  .ndRowSteering { flex-direction: column; }
 +  .ndSteerField { width: 100%; }
 +}
 +
 +/* ============================================================
 +   Sign up, MFA enrolment & recovery — the design document's
 +   Turn 8, "8a Sign up", "8b MFA enrolment", "8c Recovery code".
 +   ============================================================ */
 +
 +/* 8a — the email field carries its verification control inline. */
 +.authEmailRow { display: flex; gap: 8px; }
 +.authEmailRow input { flex: 1; }
 +.authVerifyEmail {
 +  align-self: stretch;
 +  display: grid;
 +  place-items: center;
 +  padding: 0 14px;
 +  border: 1px solid var(--gold-border);
 +  border-radius: 9px;
 +  background: var(--gold-bg);
 +  color: var(--gold-text);
 +  font-family: inherit;
 +  font-size: 11px;
 +  font-weight: 700;
 +  white-space: nowrap;
 +  cursor: pointer;
 +}
 +.authVerifyEmail:disabled { opacity: 0.55; cursor: not-allowed; }
 +
 +/* Sign-up stacks its password rules; sign-in wraps them on one line. */
 +.authRules[data-stack="true"] { flex-direction: column; gap: 3px; }
 +
 +/* 8b — the enrolment card is wider than the auth card and carries
 +   three numbered steps whose state is the real enrolment state. */
 +.mfaScreen {
 +  flex: 1;
 +  min-height: 0;
 +  overflow: auto;
 +  display: flex;
 +  align-items: flex-start;
 +  justify-content: center;
 +  padding: clamp(24px, 5vw, 56px) clamp(16px, 4vw, 40px);
 +  background-image: radial-gradient(var(--grid-dot) 1px, transparent 1.4px);
 +  background-size: 22px 22px;
 +}
 +.mfaCard {
 +  width: 720px;
 +  max-width: 100%;
 +  border-radius: 18px;
 +  overflow: hidden;
 +  border: 1px solid var(--line-strong);
 +  box-shadow: var(--shadow-auth-card);
 +  background: var(--bg);
 +  color: var(--ink);
 +}
 +.mfaBody { padding: 48px 56px; }
 +
 +.mfaEyebrow {
 +  margin: 0;
 +  font-family: var(--font-mono);
 +  font-size: 9.5px;
 +  font-weight: 700;
 +  letter-spacing: 0.22em;
 +  color: var(--gold);
 +}
 +.mfaTitle {
 +  margin: 12px 0 0;
 +  font-family: var(--font-display);
 +  font-weight: 500;
 +  font-size: 28px;
 +  letter-spacing: -0.02em;
 +}
 +.mfaLede {
 +  margin: 10px 0 0;
 +  max-width: 520px;
 +  font-size: 12px;
 +  line-height: 1.6;
 +  color: var(--text-2);
 +  text-wrap: pretty;
 +}
 +
 +.mfaStep {
 +  margin-top: 14px;
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 14px;
 +  padding: 16px 18px;
 +}
 +.mfaStep[data-state="done"] {
 +  margin-top: 22px;
 +  display: flex;
 +  align-items: center;
 +  gap: 12px;
 +  padding: 14px 18px;
 +}
 +.mfaStepHead { display: flex; align-items: center; gap: 12px; }
 +.mfaStepNum {
 +  flex: 0 0 auto;
 +  display: grid;
 +  place-items: center;
 +  width: 24px;
 +  height: 24px;
 +  border-radius: 999px;
 +  font-size: 11px;
 +  font-weight: 800;
 +}
 +.mfaStepNum[data-state="done"] { background: var(--pro); color: var(--core); }
 +.mfaStepNum[data-state="active"] { background: var(--ink); color: var(--bg); }
 +.mfaStepNum[data-state="pending"] {
 +  border: 1.5px solid var(--line-strong);
 +  color: var(--muted);
 +}
 +.mfaStepTitle { margin: 0; font-size: 12.5px; font-weight: 700; }
 +.mfaStepHint {
 +  margin: 2px 0 0;
 +  font-size: 11px;
 +  line-height: normal;
 +  color: var(--text-2);
 +}
 +/* Steps 2 and 3 indent their body under the numbered badge. */
 +.mfaStepBody { margin: 4px 0 0 36px; }
 +.mfaStepDone { margin: 0; font-size: 12px; font-weight: 700; color: var(--pro); }
 +.mfaSpacer { flex: 1; }
 +
 +.mfaSetup { display: flex; gap: 22px; margin-top: 14px; align-items: flex-start; }
 +.mfaQr {
 +  flex: 0 0 auto;
 +  width: 170px;
 +  height: 170px;
 +  background: var(--qr-paper);
 +  border: 1px solid var(--line-strong);
