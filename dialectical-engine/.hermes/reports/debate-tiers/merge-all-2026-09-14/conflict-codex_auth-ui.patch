 +.ndSelectCaret { font-size: 8px; color: var(--muted); }
 +
 +/* The legacy panel's footer sits a hair tighter than the main card's. */
 +.ndLegacy .ndProvenance { padding: 13px 0; }
 +.ndSettingsLink {
 +  padding: 0;
 +  border: 0;
 +  background: transparent;
 +  color: var(--ink);
 +  font: inherit;
 +  font-weight: 700;
 +  cursor: pointer;
 +  text-decoration: underline;
 +  text-underline-offset: 3px;
 +}
 +
 +.ndActions { display: flex; align-items: center; gap: 12px; margin-top: 22px; }
 +.ndStart {
 +  padding: 10px 22px;
 +  border: 0;
 +  border-radius: 999px;
 +  background: var(--ink);
 +  color: var(--bg);
 +  font-family: inherit;
 +  font-size: 12.5px;
