 +.mfaTypeback:focus { border-color: var(--gold); }
 +.mfaActivate {
 +  padding: 8px 15px;
 +  border: 0;
 +  border-radius: 999px;
 +  background: var(--pro);
 +  color: var(--core);
 +  font-family: inherit;
 +  font-size: 11px;
 +  font-weight: 700;
 +  white-space: nowrap;
