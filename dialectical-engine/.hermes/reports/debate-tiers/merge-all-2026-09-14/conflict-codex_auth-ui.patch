 +/* ============================================================
 +   Landing page — the design document's "Landing page — final"
 +   (Terracotta / Chamber). Values below are the document's own.
 +   The document ships two variants: Terracotta rides soft 12–20px
 +   radii at display weight 480; Chamber rides the "editorial"
 +   variant — full pill radii, lighter display weight, wider track.
 +   ============================================================ */
 +
 +.lpRoot {
 +  position: relative;
 +  overflow: hidden;
 +  background: var(--bg);
 +  color: var(--ink);
 +  font-family: var(--font-sans);
 +  -webkit-font-smoothing: antialiased;
 +}
 +
 +.lpRoot a {
 +  color: inherit;
 +  text-decoration: none;
 +}
 +
 +/* `.lpRoot a` is 0,2,0 — the button colours must match that specificity or
 +   they lose to it and the labels inherit --ink (dark on dark). */
 +.lpRoot a.lpCta { color: var(--bg); }
 +.lpRoot a.lpCtaGhost { color: var(--ink); }
 +
 +/* Section rhythm. The document authors a fixed 1280px artboard; the vw terms
 +   below reach its exact padding at 1280 and shrink proportionally under it. */
 +.lpSection {
 +  padding-left: clamp(24px, 7.5vw, 96px);
 +  padding-right: clamp(24px, 7.5vw, 96px);
 +}
 +.lpHero { padding-top: clamp(150px, 19.53vw, 250px); padding-bottom: clamp(80px, 11.72vw, 150px); }
 +.lpExchange { padding-top: clamp(72px, 10.16vw, 130px); padding-bottom: clamp(96px, 14.84vw, 190px); }
 +.lpMethod {
 +  padding-top: clamp(76px, 10.94vw, 140px);
 +  padding-bottom: clamp(76px, 10.94vw, 140px);
 +  background: var(--lp-raised);
 +  border-top: 1px solid var(--line);
 +  border-bottom: 1px solid var(--line);
 +}
 +.lpClosing {
 +  padding-top: clamp(96px, 14.06vw, 180px);
 +  padding-bottom: clamp(96px, 14.84vw, 190px);
 +  text-align: center;
 +}
 +
 +/* Display type */
 +.lpDisplay {
 +  font-family: var(--font-display);
 +  font-weight: var(--lp-fw-display);
 +  font-variation-settings: var(--fvs-display);
 +  letter-spacing: var(--lp-ls-display);
 +  text-wrap: pretty;
 +  margin: 0;
 +}
 +.lpHeroTitle { font-size: var(--t-hero); line-height: 0.92; max-width: 15ch; }
