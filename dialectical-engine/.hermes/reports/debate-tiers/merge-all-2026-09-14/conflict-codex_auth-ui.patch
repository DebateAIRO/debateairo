 +}
 +.mfaSetupBody { flex: 1; min-width: 0; }
 +.mfaSetupHint { margin: 0; font-size: 11px; line-height: 1.55; color: var(--text-2); }
 +.mfaSecret {
 +  display: block;
 +  width: 100%;
 +  margin-top: 10px;
 +  padding: 9px 12px;
 +  border-radius: 9px;
 +  border: 1px solid var(--line-strong);
 +  background: var(--shell);
 +  color: var(--muted);
 +  font-family: var(--font-mono);
 +  font-size: 10.5px;
 +  line-height: 12px;
 +}
 +.mfaGhostRow { display: flex; gap: 8px; margin-top: 10px; align-items: center; }
 +.mfaGhost {
 +  padding: 7px 14px;
 +  border-radius: 999px;
 +  border: 1px solid var(--line-strong);
 +  background: transparent;
 +  color: var(--ink);
 +  font-family: inherit;
 +  font-size: 11px;
 +  font-weight: 600;
 +  cursor: pointer;
