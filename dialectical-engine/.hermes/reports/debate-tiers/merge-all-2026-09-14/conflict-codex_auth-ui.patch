 +.ndSlider {
 +  -webkit-appearance: none;
 +  appearance: none;
 +  width: 100%;
 +  height: 14px;
 +  margin: 0;
 +  background: transparent;
 +  cursor: pointer;
 +}
 +.ndSlider::-webkit-slider-runnable-track {
 +  height: 3px;
 +  border-radius: 999px;
 +  background: linear-gradient(
 +    to right,
 +    var(--pro) 0 var(--nd-pct, 0%),
