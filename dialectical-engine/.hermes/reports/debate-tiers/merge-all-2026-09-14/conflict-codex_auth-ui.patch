 +.authSuccessWarning .authRecoveryCode { line-height: 1.17; }
 +
 +/* 8a runs a hair tighter than the other two auth cards: a 13px field rhythm
 +   and 48px of floor rather than 56px. */
 +.authForm[data-form="signup"] { gap: 13px; }
 +.authCardInner:has([data-form="signup"]) { padding-bottom: clamp(32px, 5.6vw, 48px); }
 +
 +/* ============================================================
 +   Home library — the design document's Turn 3, "3a Library".
