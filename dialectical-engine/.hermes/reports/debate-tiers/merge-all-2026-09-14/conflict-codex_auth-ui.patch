 +  font-size: 12px;
 +  font-weight: 600;
 +  cursor: pointer;
 +}
 +.ndActionsSpacer { flex: 1; }
 +.ndKeyHint { font-size: 10.5px; color: var(--muted); }
 +
 +/* === debate-tiers S01 === */
 +.ndTier {
 +  display: grid;
 +  grid-template-columns: repeat(2, minmax(0, 1fr));
 +  gap: 10px;
 +  margin-top: 20px;
 +}
 +.ndTierOption {
 +  display: flex;
 +  flex-direction: column;
 +  align-items: flex-start;
 +  gap: 9px;
 +  padding: 13px 14px;
 +  border: 1px solid var(--line);
 +  border-radius: 12px;
 +  background: var(--core);
 +  font-family: inherit;
 +  text-align: left;
 +  cursor: pointer;
