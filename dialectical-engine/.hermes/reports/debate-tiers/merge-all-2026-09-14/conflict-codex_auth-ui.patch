 +}
 +
 +/* The two steering fields sit side by side, top-aligned. */
 +.ndRowSteering { align-items: flex-start; }
 +.ndSteerField { flex: 1; min-width: 0; }
 +.ndSteerInput {
 +  display: block;
 +  width: 100%;
 +  margin-top: 8px;
 +  padding: 10px 13px;
 +  border-radius: 9px;
 +  border: 1px solid var(--line);
