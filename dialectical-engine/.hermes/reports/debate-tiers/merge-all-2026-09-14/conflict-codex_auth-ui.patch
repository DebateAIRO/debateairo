 +.ndTierOption[aria-checked="true"] {
 +  border-color: var(--line-strong);
 +  background: var(--shell);
 +}
 +.ndTierName {
 +  padding: 4px 12px;
 +  border-radius: 999px;
 +  background: transparent;
 +  color: var(--muted);
 +  font-size: 10.5px;
 +  font-weight: 600;
 +}
 +.ndTierOption[aria-checked="true"] .ndTierName {
 +  background: var(--ink);
 +  color: var(--bg);
 +  font-weight: 700;
 +}
 +.ndTierPromise {
 +  font-size: 11.5px;
 +  color: var(--text-2);
 +}
 +.ndTierModels {
