 +.ndIntro {
 +  margin: 0;
 +  padding: 14px 0;
 +  font-size: 12px;
 +  color: var(--text-2);
 +  border-bottom: 1px solid var(--line);
 +}
 +.ndProvenance {
 +  margin: 0;
 +  padding: 14px 0;
