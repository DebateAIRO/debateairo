 +  color: var(--dispute);
 +  font-size: 11.5px;
 +}
 +
 +/* ============================================================
 +   Fleet — the design document's Turn 7, "7c Fleet".
 +   ============================================================ */
 +
 +.fleetScreen { padding: clamp(28px, 5vw, 52px) clamp(20px, 6vw, 56px); }
 +.fleetCard { max-width: 540px; }
 +
 +.fleetEyebrow {
 +  margin: 0;
 +  font-family: var(--font-mono);
 +  font-size: 9.5px;
 +  font-weight: 700;
 +  letter-spacing: 0.22em;
 +  color: var(--gold);
 +}
 +.fleetTitle {
 +  margin: 12px 0 0;
 +  font-family: var(--font-display);
 +  font-weight: 500;
 +  font-size: 28px;
 +  letter-spacing: -0.02em;
 +}
 +.fleetPanel {
 +  margin-top: 24px;
 +  background: var(--shell);
 +  border: 1px solid var(--line-strong);
 +  border-radius: 16px;
 +  padding: 7px;
 +  box-shadow: var(--shadow-card);
 +}
 +.fleetPanelCore {
 +  position: relative;
 +  overflow: hidden;
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 10px;
 +  padding: 20px 22px;
 +}
 +.fleetAccent {
 +  position: absolute;
 +  top: 0;
 +  left: 22px;
 +  width: 52px;
 +  height: 4px;
 +  border-radius: 0 0 5px 5px;
 +  background: var(--gold);
 +}
 +.fleetNoticeTitle { margin: 0; font-size: 13px; font-weight: 700; }
 +.fleetNoticeBody {
 +  margin: 8px 0 0;
 +  font-size: 12px;
 +  line-height: 1.6;
 +  color: var(--text-2);
 +  text-wrap: pretty;
 +}
 +
 +/* ============================================================
 +   New debate — the design document's Turn 4, "4a New debate".
 +   ============================================================ */
 +
 +.ndScreen { padding: 44px 56px 48px; }
 +.ndInner { max-width: 660px; margin: 0 auto; }
 +
 +.ndEyebrow {
 +  margin: 0;
 +  font-family: var(--font-mono);
 +  font-size: 9.5px;
 +  font-weight: 700;
 +  letter-spacing: 0.22em;
 +  color: var(--gold);
 +}
 +.ndTitle {
 +  margin: 12px 0 0;
 +  font-family: var(--font-display);
 +  font-weight: 500;
 +  font-size: 30px;
 +  letter-spacing: -0.025em;
 +}
 +
 +/* The question sits in the approved bezel: shell around core. */
 +.ndTopicBezel {
 +  margin-top: 20px;
 +  background: var(--shell);
 +  border: 1px solid var(--line-strong);
 +  border-radius: 16px;
 +  padding: 7px;
 +  box-shadow: var(--shadow-pop);
