 +  border-radius: 10px;
 +  padding: 18px 20px;
 +}
 +.ndTopic {
 +  display: block;
 +  width: 100%;
 +  min-height: 25.5px;
 +  padding: 0;
 +  border: 0;
 +  background: transparent;
 +  color: var(--ink);
 +  caret-color: var(--gold);
