 +.lpResolution { flex: 0 0 300px; padding-bottom: 10px; }
 +.lpResolutionClaim {
 +  margin: 0;
 +  font-family: var(--font-display);
 +  font-size: 21px;
 +  line-height: 1.35;
 +  letter-spacing: -0.01em;
