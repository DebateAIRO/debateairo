 +.lpCtaNav { gap: 10px; padding: 8px 8px 8px 20px; font-size: 13.5px; }
 +.lpCtaHero { gap: 14px; padding: 12px 12px 12px 30px; font-size: 15.5px; box-shadow: var(--lp-btn-shadow); }
 +.lpCtaClosing { gap: 14px; padding: 14px 14px 14px 34px; font-size: 16.5px; box-shadow: var(--lp-btn-shadow); }
 +.lpCtaNav:hover { transform: scale(1.04); }
 +.lpCtaHero:hover { transform: translateY(-3px) scale(1.03); }
