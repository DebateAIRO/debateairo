 +  line-height: 1;
 +}
 +.lpCtaNav .lpArrow { width: 26px; height: 26px; font-size: 12px; }
 +.lpCtaClosing .lpArrow { width: 36px; height: 36px; font-size: 15px; }
 +
 +.lpCtaGhost {
 +  display: inline-flex;
 +  align-items: center;
 +  gap: 12px;
 +  padding: 12px 26px;
 +  border-radius: var(--lp-r-btn);
 +  border: 1px solid var(--line-strong);
 +  font-size: 15.5px;
 +  font-weight: 500;
 +  color: var(--ink);
 +  transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
 +}
 +.lpCtaGhost:hover { transform: translateY(-3px); }
 +
 +/* Floating glass nav */
 +.lpNav {
 +  display: flex;
 +  align-items: center;
