 +.lpLegend {
 +  display: flex;
 +  align-items: center;
 +  gap: 16px;
 +  margin-top: 20px;
 +  font-size: 12.5px;
 +  color: var(--muted);
 +}
 +.lpLegend > span { display: inline-flex; align-items: center; gap: 7px; }
 +.lpSwatch { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
 +.lpSwatch[data-stance="pro"] { background: var(--pro); }
 +.lpSwatch[data-stance="con"] { background: var(--con); }
 +.lpSwatch[data-stance="reasoning"] { background: var(--reasoning); }
 +
 +/* The cascade */
 +.lpCascade { max-width: 880px; margin: 0 auto; padding: 40px 0; }
 +.lpCard {
 +  position: relative;
 +  transform: var(--lp-tf);
 +  transition: transform 0.72s cubic-bezier(0.34, 1.56, 0.64, 1),
 +    box-shadow 0.72s cubic-bezier(0.34, 1.56, 0.64, 1);
