 +.lpCardAccent { position: absolute; top: 0; left: 0; width: 64px; height: 3px; }
 +.lpCardAccent[data-stance="pro"] { background: var(--pro); }
 +.lpCardAccent[data-stance="con"] { background: var(--con); }
 +.lpCardAccent[data-stance="reasoning"] { background: var(--reasoning); }
 +
 +.lpCardHead { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin-bottom: 20px; }
 +.lpCardFoot {
 +  display: flex;
 +  align-items: center;
 +  gap: 9px;
 +  flex-wrap: wrap;
 +  margin-top: 24px;
 +  padding-top: 18px;
 +  border-top: 1px solid var(--line);
 +}
 +.lpSpacer { flex: 1; }
 +
 +.lpCardClaim {
 +  margin: 0;
 +  font-family: var(--font-display);
 +  font-weight: 400;
 +  font-size: 19px;
 +  line-height: 1.5;
 +  letter-spacing: -0.012em;
 +  text-wrap: pretty;
 +  color: var(--ink);
 +}
 +.lpTurn { font-family: var(--font-display); font-size: 13px; color: var(--muted); letter-spacing: 0.04em; }
 +
 +/* Chips */
 +.lpChip {
 +  display: inline-flex;
 +  align-items: center;
 +  white-space: nowrap;
 +  border-radius: var(--r-pill);
 +  font-family: var(--font-sans);
 +  font-weight: 700;
 +}
 +.lpChipStance {
 +  padding: 5px 12px;
 +  border-width: 1.5px;
 +  border-style: solid;
 +  font-size: 11px;
 +  letter-spacing: 0.1em;
 +  text-transform: uppercase;
 +}
 +.lpChipStance[data-stance="pro"] { background: var(--pro-bg); border-color: var(--pro-border); color: var(--pro-text); }
 +.lpChipStance[data-stance="con"] { background: var(--con-bg); border-color: var(--con-border); color: var(--con-text); }
 +.lpChipStance[data-stance="reasoning"] { background: var(--reasoning-bg); border-color: var(--reasoning-border); color: var(--reasoning-text); }
 +
 +.lpChipBase {
 +  padding: 4px 11px;
 +  border: 1px solid var(--gold-border);
 +  background: var(--gold-bg);
 +  color: var(--gold-text);
 +  font-size: 10.5px;
 +}
 +.lpChipModel { gap: 7px; padding: 4px 12px 4px 9px; border: 1px solid; font-size: 12px; color: var(--ink); }
 +.lpChipReviewer {
 +  gap: 7px;
 +  padding: 4px 12px 4px 9px;
 +  background: var(--lp-raised);
 +  border: 1px solid var(--line-strong);
 +  font-size: 11.5px;
 +  color: var(--ink);
 +}
 +.lpChipReview { padding: 5px 11px; border: 1px solid; font-size: 10px; letter-spacing: 0.06em; }
 +.lpChipReview[data-review="agree"] { background: var(--agree-bg); border-color: var(--agree-border); color: var(--agree-text); }
 +.lpChipReview[data-review="dispute"] { background: var(--dispute-bg); border-color: var(--dispute-border); color: var(--dispute-text); }
 +
 +.lpChipModel[data-model="claude"] { background: var(--m-claude-bg); border-color: var(--m-claude-border); }
 +.lpChipModel[data-model="gpt"] { background: var(--m-gpt-bg); border-color: var(--m-gpt-border); }
 +.lpChipModel[data-model="gemini"] { background: var(--m-gemini-bg); border-color: var(--m-gemini-border); }
 +
 +.lpDot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex: 0 0 auto; }
 +.lpDot[data-model="claude"] { background: var(--m-claude); }
 +.lpDot[data-model="gpt"] { background: var(--m-gpt); }
 +.lpDot[data-model="gemini"] { background: var(--m-gemini); }
 +.lpDotHalo[data-model="claude"] { box-shadow: 0 0 0 2.5px var(--m-claude-bg); }
 +.lpDotHalo[data-model="gpt"] { box-shadow: 0 0 0 2.5px var(--m-gpt-bg); }
 +.lpDotHalo[data-model="gemini"] { box-shadow: 0 0 0 2.5px var(--m-gemini-bg); }
 +
 +.lpExchangeCoda {
 +  max-width: 52ch;
 +  margin: 80px auto 0;
 +  text-align: center;
 +  font-size: 15px;
 +  line-height: 1.7;
 +  color: var(--muted);
 +}
 +
 +/* Method — editorial split */
 +.lpMethodGrid { display: flex; gap: clamp(40px, 8.6vw, 110px); align-items: flex-start; }
 +.lpMethodRail { flex: 0 0 340px; position: sticky; top: 60px; }
 +.lpMethodLede { margin: 26px 0 0; font-size: var(--t-body); line-height: 1.7; color: var(--muted); }
 +.lpMethodLedgerWrap { flex: 1; min-width: 0; }
 +.lpLedgerLabel {
 +  margin: 0 0 12px;
 +  font-family: var(--font-mono);
 +  font-size: 10px;
 +  font-weight: 700;
 +  letter-spacing: 0.18em;
 +  color: var(--muted);
 +}
 +.lpLedger { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
 +.lpLedgerRow {
 +  display: flex;
 +  align-items: baseline;
 +  gap: 26px;
 +  padding: 19px 2px;
 +  border-bottom: 1px solid var(--line);
 +}
 +.lpLedgerNo { flex: 0 0 38px; font-family: var(--font-mono); font-size: 13px; font-weight: 700; }
 +.lpLedgerNo[data-stance="pro"] { color: var(--pro); }
 +.lpLedgerNo[data-stance="con"] { color: var(--con); }
 +.lpLedgerNo[data-stance="reasoning"] { color: var(--reasoning); }
 +.lpLedgerNo[data-stance="gold"] { color: var(--gold); }
 +.lpLedgerTitle {
 +  flex: 0 0 250px;
 +  margin: 0;
 +  font-family: var(--font-display);
 +  font-size: 20px;
 +  font-weight: 600;
 +  letter-spacing: -0.015em;
 +}
 +.lpLedgerBody { flex: 1; min-width: 220px; margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--muted); text-wrap: pretty; }
 +
 +/* Closing */
 +.lpMotif { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 38px; }
 +.lpMotifRule { width: 34px; height: 1px; background: var(--line-strong); }
 +.lpClosingLede { margin: 36px auto 0; max-width: 46ch; font-size: 18px; line-height: 1.65; color: var(--muted); }
 +.lpPricing { margin: 30px 0 0; font-size: 13px; color: var(--muted); }
 +
 +@media (prefers-reduced-motion: reduce) {
 +  .lpCta, .lpCtaGhost, .lpCard { transition: none; }
 +  .lpCtaNav:hover, .lpCtaHero:hover, .lpCtaClosing:hover, .lpCtaGhost:hover { transform: none; }
 +  .lpCard:hover { transform: var(--lp-tf); }
 +}
 +
 +/* Below the document's 1280px artboard these rows may stack; at and above it
 +   they hold the document's single-row composition. */
 +@media (max-width: 1100px) {
 +  .lpExchangeHead,
 +  .lpMethodGrid,
 +  .lpLedgerRow,
 +  .lpStatBar { flex-wrap: wrap; }
 +  .lpMethodRail { position: static; flex-basis: 100%; }
 +  .lpLedgerTitle { flex-basis: auto; }
 +}
 +
 +/* ============================================================
 +   Settings — the design document's Turn 6, "6a Settings".
 +   Body layout, identity panel, session list, and the three
 +   action cards. Values are the document's own; tokens map onto
 +   the Terracotta / Chamber contract above.
 +   ============================================================ */
 +
 +.setScreen { overflow-y: auto; }
 +.setBody { padding: clamp(28px, 4.4vw, 44px) clamp(20px, 5.6vw, 56px) 48px; }
 +.setInner { max-width: 720px; margin: 0 auto; }
 +
 +.setEyebrow {
 +  margin: 0;
 +  font-family: var(--font-mono);
 +  font-size: 9.5px;
 +  font-weight: 700;
 +  letter-spacing: 0.22em;
 +  color: var(--gold);
 +}
 +.setTitle {
 +  margin: 12px 0 0;
 +  font-family: var(--font-display);
 +  font-weight: 500;
 +  font-size: 30px;
 +  letter-spacing: -0.025em;
 +}
 +.setLede {
 +  margin: 10px 0 0;
 +  font-size: 12.5px;
 +  line-height: 1.6;
 +  color: var(--text-2);
 +  max-width: 560px;
 +  text-wrap: pretty;
 +}
 +
 +/* Identity panel: the document's shell-around-core bezel. */
 +.setPanel {
 +  margin-top: 26px;
 +  background: var(--shell);
 +  border: 1px solid var(--line-strong);
 +  border-radius: 16px;
 +  padding: 7px;
 +  box-shadow: var(--shadow-card);
 +}
 +.setPanelCore {
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 10px;
 +  padding: 6px 18px;
 +}
 +.setIdentityRow {
 +  display: flex;
 +  align-items: baseline;
 +  gap: 12px;
 +  padding: 11px 0;
 +  border-bottom: 1px solid var(--line);
 +}
 +.setIdentityRow:last-child { border-bottom: 0; }
 +.setIdentityKey {
 +  flex: 0 0 150px;
 +  font-family: var(--font-mono);
 +  font-size: 9px;
 +  font-weight: 700;
 +  letter-spacing: 0.1em;
 +  color: var(--muted);
 +}
 +.setIdentityValue { font-size: 12px; font-weight: 600; }
 +.setIdentityValue[data-absent="true"] { font-weight: 500; color: var(--muted); font-style: italic; }
 +
 +/* Section heading above the session list */
 +.setSectionHead { display: flex; align-items: center; gap: 12px; margin: 30px 0 12px; flex-wrap: wrap; }
 +.setSectionTitle { margin: 0; font-family: var(--font-display); font-size: 17px; font-weight: 600; }
 +.setSectionHint { margin: 0; font-size: 11px; color: var(--text-2); font-weight: 400; }
 +
 +/* Session list */
 +.setList {
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 14px;
 +  padding: 4px 18px;
 +}
 +.setSessionRow {
 +  display: flex;
 +  align-items: center;
 +  gap: 14px;
 +  padding: 13px 0;
 +  border-bottom: 1px solid var(--line);
 +}
 +.setDot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; background: var(--muted); }
 +.setDot[data-state="current"] { background: var(--ok-dot); }
 +.setDot[data-state="alert"] { background: var(--dispute); }
 +.setSessionMain { flex: 1; min-width: 0; }
 +.setSessionLine { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
 +.setSessionDevice { font-size: 12.5px; font-weight: 700; }
 +.setSessionName { font-size: 10.5px; font-weight: 600; color: var(--muted); }
 +.setSessionId { font-family: var(--font-mono); font-size: 9.5px; color: var(--muted); }
 +.setSessionSeen { margin: 3px 0 0; font-size: 11px; color: var(--text-2); }
 +.setListActions { display: flex; gap: 10px; padding: 14px 0; flex-wrap: wrap; }
 +
 +/* Cards */
 +.setCard {
 +  margin-top: 18px;
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 14px;
 +  padding: 16px 18px;
 +}
 +.setCardTitle { margin: 0; font-size: 13.5px; font-weight: 700; }
 +.setCardHint { margin: 4px 0 0; font-size: 11.5px; line-height: 1.55; color: var(--text-2); text-wrap: pretty; }
 +.setCardNote { margin: 8px 0 0; font-size: 10.5px; font-style: italic; line-height: 1.5; color: var(--muted); text-wrap: pretty; }
 +.setCardRow { display: flex; gap: 10px; margin-top: 12px; align-items: center; flex-wrap: wrap; }
 +
 +/* Fields — the document draws these as flush, quiet inputs. */
 +.setField { flex: 1; min-width: 150px; display: flex; flex-direction: column; }
 +/* The document draws these fields label-less, carrying their name in the
 +   placeholder. Hide the label visually but keep it for assistive tech —
 +   these are password and one-time-code inputs. */
 +.setField > label {
 +  position: absolute;
 +  width: 1px;
 +  height: 1px;
 +  margin: -1px;
 +  padding: 0;
 +  overflow: hidden;
 +  clip-path: inset(50%);
 +  white-space: nowrap;
 +  border: 0;
 +}
 +.setField input {
 +  width: 100%;
 +  padding: 9px 13px;
 +  border-radius: 9px;
 +  border: 1px solid var(--line-strong);
 +  background: var(--shell);
 +  font-family: var(--font-sans);
 +  font-size: 11.5px;
 +  color: var(--ink);
 +}
 +.setField input::placeholder { color: var(--muted); }
 +.setField input:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
 +.setFieldMono input { font-family: var(--font-mono); font-size: 11px; }
 +
 +/* Buttons */
 +.setBtn {
 +  padding: 9px 16px;
 +  border-radius: 999px;
 +  border: 1px solid var(--line-strong);
 +  background: transparent;
 +  font-family: var(--font-sans);
 +  font-size: 11.5px;
 +  font-weight: 600;
 +  color: var(--ink);
 +  cursor: pointer;
 +  white-space: nowrap;
 +}
 +.setBtnPrimary { background: var(--ink); border-color: var(--ink); color: var(--bg); font-weight: 700; }
 +.setBtnQuiet { padding: 7px 15px; color: var(--muted); }
 +.setBtnRevoke { padding: 6px 14px; font-size: 11px; color: var(--muted); }
 +.setBtn:disabled { opacity: 0.5; cursor: not-allowed; }
 +
 +/* Danger card */
 +.setCardDanger { border-color: var(--dispute-border); }
 +.setCardDanger .setCardTitle { color: var(--dispute); }
 +.setFieldDanger input {
 +  border-color: var(--dispute-border);
 +  background: var(--dispute-bg);
 +  font-family: var(--font-mono);
 +  font-size: 10.5px;
 +  color: var(--dispute);
 +}
 +.setFieldDanger { flex: 1.2; }
 +.setBtnDanger { background: var(--dispute); border-color: var(--dispute); color: var(--core); font-weight: 700; }
 +
 +.setStatus { margin: 10px 0 0; font-size: 11.5px; color: var(--text-2); }
 +.setError {
 +  margin: 10px 0 0;
 +  padding: 9px 13px;
 +  border-radius: 9px;
 +  border: 1px solid var(--dispute-border);
 +  background: var(--dispute-bg);
 +  color: var(--dispute);
 +  font-size: 11.5px;
 +}
 +
 +/* ============================================================
 +   Fleet — the design document's Turn 7, "7c Fleet".
 +   ============================================================ */
 +
 +.fleetScreen { padding: clamp(28px, 5vw, 52px) clamp(20px, 6vw, 56px); }
 +.fleetCard { max-width: 540px; }
 +
 +.fleetEyebrow {
 +  margin: 0;
 +  font-family: var(--font-mono);
 +  font-size: 9.5px;
 +  font-weight: 700;
 +  letter-spacing: 0.22em;
 +  color: var(--gold);
 +}
 +.fleetTitle {
 +  margin: 12px 0 0;
 +  font-family: var(--font-display);
 +  font-weight: 500;
 +  font-size: 28px;
 +  letter-spacing: -0.02em;
 +}
 +.fleetPanel {
 +  margin-top: 24px;
 +  background: var(--shell);
 +  border: 1px solid var(--line-strong);
 +  border-radius: 16px;
 +  padding: 7px;
 +  box-shadow: var(--shadow-card);
 +}
 +.fleetPanelCore {
 +  position: relative;
 +  overflow: hidden;
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 10px;
 +  padding: 20px 22px;
 +}
 +.fleetAccent {
 +  position: absolute;
 +  top: 0;
 +  left: 22px;
 +  width: 52px;
 +  height: 4px;
 +  border-radius: 0 0 5px 5px;
 +  background: var(--gold);
 +}
 +.fleetNoticeTitle { margin: 0; font-size: 13px; font-weight: 700; }
 +.fleetNoticeBody {
 +  margin: 8px 0 0;
 +  font-size: 12px;
 +  line-height: 1.6;
 +  color: var(--text-2);
 +  text-wrap: pretty;
 +}
 +
 +/* ============================================================
 +   New debate — the design document's Turn 4, "4a New debate".
 +   ============================================================ */
 +
 +.ndScreen { padding: 44px 56px 48px; }
 +.ndInner { max-width: 660px; margin: 0 auto; }
 +
 +.ndEyebrow {
 +  margin: 0;
 +  font-family: var(--font-mono);
 +  font-size: 9.5px;
 +  font-weight: 700;
 +  letter-spacing: 0.22em;
 +  color: var(--gold);
 +}
 +.ndTitle {
 +  margin: 12px 0 0;
 +  font-family: var(--font-display);
 +  font-weight: 500;
 +  font-size: 30px;
 +  letter-spacing: -0.025em;
 +}
 +
 +/* The question sits in the approved bezel: shell around core. */
 +.ndTopicBezel {
 +  margin-top: 20px;
 +  background: var(--shell);
 +  border: 1px solid var(--line-strong);
 +  border-radius: 16px;
 +  padding: 7px;
 +  box-shadow: var(--shadow-pop);
 +}
 +.ndTopicCore {
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 10px;
 +  padding: 18px 20px;
 +}
 +.ndTopic {
 +  display: block;
 +  width: 100%;
 +  min-height: 25.5px;
 +  padding: 0;
 +  border: 0;
 +  background: transparent;
 +  color: var(--ink);
 +  caret-color: var(--gold);
 +  font-family: var(--font-display);
