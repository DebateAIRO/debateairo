 +  line-height: 1.5;
 +  overflow: hidden;
 +  resize: none;
 +}
 +.ndTopic:focus { outline: none; }
 +.ndTopic::placeholder { color: var(--muted); }
 +
 +.ndCard {
 +  margin-top: 18px;
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 14px;
 +  padding: 6px 20px;
 +}
 +.ndIntro {
 +  margin: 0;
 +  padding: 14px 0;
 +  font-size: 12px;
 +  color: var(--text-2);
 +  border-bottom: 1px solid var(--line);
 +}
 +.ndProvenance {
 +  margin: 0;
 +  padding: 14px 0;
 +  font-size: 10.5px;
 +  color: var(--muted);
 +}
 +
 +.ndRow {
 +  display: flex;
 +  align-items: center;
 +  gap: 16px;
 +  padding: 17px 0;
 +  border-bottom: 1px solid var(--line);
 +}
 +.ndRowText { flex: 1; }
 +/* Slider and steering rows pin the label column so the tracks line up. */
 +.ndRowSlider .ndRowText { flex: 0 0 200px; }
 +.ndLabel { display: block; font-size: 13.5px; font-weight: 700; }
 +.ndHint { margin-top: 4px; font-size: 11.5px; color: var(--text-2); }
 +
 +/* Segmented tier control. */
 +.ndSeg {
 +  display: flex;
 +  gap: 2px;
 +  padding: 3px;
 +  border-radius: 999px;
 +  border: 1px solid var(--line-strong);
 +  background: var(--shell);
 +}
 +.ndSegItem {
 +  padding: 4px 12px;
 +  border: 0;
 +  border-radius: 999px;
 +  background: transparent;
 +  color: var(--muted);
 +  font-family: inherit;
 +  font-size: 10.5px;
 +  font-weight: 600;
 +  cursor: pointer;
 +}
 +.ndSegItem[aria-checked="true"] {
 +  background: var(--ink);
 +  color: var(--bg);
 +  font-weight: 700;
 +}
 +.ndSegItem:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
 +
 +/* Slider: 3px track, pro-coloured fill, ink thumb ringed in the page colour. */
 +.ndSliderWrap { flex: 1; display: flex; align-items: center; }
 +.ndSlider {
 +  -webkit-appearance: none;
 +  appearance: none;
 +  width: 100%;
 +  height: 14px;
 +  margin: 0;
 +  background: transparent;
 +  cursor: pointer;
 +}
 +.ndSlider::-webkit-slider-runnable-track {
 +  height: 3px;
 +  border-radius: 999px;
 +  background: linear-gradient(
 +    to right,
 +    var(--pro) 0 var(--nd-pct, 0%),
 +    var(--line-strong) var(--nd-pct, 0%) 100%
 +  );
 +}
 +.ndSlider::-moz-range-track {
 +  height: 3px;
 +  border-radius: 999px;
 +  background: var(--line-strong);
 +}
 +.ndSlider::-moz-range-progress { height: 3px; border-radius: 999px; background: var(--pro); }
 +.ndSlider::-webkit-slider-thumb {
 +  -webkit-appearance: none;
 +  appearance: none;
 +  width: 14px;
 +  height: 14px;
 +  margin-top: -5.5px;
 +  border-radius: 50%;
 +  border: 2.5px solid var(--bg);
 +  background: var(--ink);
 +  box-shadow: var(--shadow-thumb);
 +  box-sizing: border-box;
 +}
 +.ndSlider::-moz-range-thumb {
 +  width: 14px;
 +  height: 14px;
 +  border-radius: 50%;
 +  border: 2.5px solid var(--bg);
 +  background: var(--ink);
 +  box-shadow: var(--shadow-thumb);
 +  box-sizing: border-box;
 +}
 +.ndSlider:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
 +.ndValue {
 +  flex: 0 0 46px;
 +  text-align: right;
 +  font-family: var(--font-mono);
 +  font-size: 11px;
 +  font-weight: 700;
 +  color: var(--pro);
 +}
 +
 +/* The two steering fields sit side by side, top-aligned. */
 +.ndRowSteering { align-items: flex-start; }
 +.ndSteerField { flex: 1; min-width: 0; }
 +.ndSteerInput {
 +  display: block;
 +  width: 100%;
 +  margin-top: 8px;
 +  padding: 10px 13px;
 +  border-radius: 9px;
 +  border: 1px solid var(--line);
 +  background: var(--shell);
 +  color: var(--ink);
 +  font-family: inherit;
 +  font-size: 11px;
