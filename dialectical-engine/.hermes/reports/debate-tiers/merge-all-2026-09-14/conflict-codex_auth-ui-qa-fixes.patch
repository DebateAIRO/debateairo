 +
 +.lpCardShell {
 +  background: var(--lp-raised);
 +  border: 1px solid var(--line-strong);
 +  border-radius: var(--lp-r-shell);
 +  padding: 11px;
 +  box-shadow: var(--lp-card-shadow);
 +}
 +.lpCardShell[data-stance="pro"] { border-color: var(--pro-border); }
 +.lpCardShell[data-stance="con"] { border-color: var(--con-border); }
 +.lpCardShell[data-stance="reasoning"] { border-color: var(--reasoning-border); }
 +
 +.lpCardCore {
 +  position: relative;
 +  overflow: hidden;
 +  display: block;
 +  background: var(--bg);
 +  border: 1px solid var(--line);
 +  border-radius: var(--lp-r-core);
 +  padding: 34px 38px 30px;
 +  box-shadow: var(--lp-core-inset);
