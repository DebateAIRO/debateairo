 +.ndSteerInput::placeholder { color: var(--muted); }
 +.ndSteerInput[data-italic="true"]::placeholder { font-style: italic; }
 +.ndSteerInput:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
 +
 +.ndOptionsToggle {
 +  display: flex;
 +  align-items: center;
 +  gap: 8px;
 +  width: 100%;
 +  margin: 20px 0 0;
 +  padding: 0;
 +  border: 0;
 +  background: transparent;
 +  color: var(--ink);
 +  font-family: var(--font-mono);
 +  font-size: 10px;
 +  font-weight: 700;
 +  letter-spacing: 0.12em;
 +  cursor: pointer;
 +}
 +.ndOptionsCaret { font-size: 8px; }
 +.ndOptionsRule { flex: 1; height: 1px; background: var(--line); }
 +
 +/* The V2 knobs the V3 contract has no slot for are drawn as a dashed aside. */
 +.ndLegacy {
 +  margin-top: 14px;
 +  border-style: dashed;
 +  border-color: var(--line-strong);
 +  opacity: 0.88;
 +}
 +.ndLegacyNotice {
 +  margin: 0;
 +  padding: 14px 0;
 +  font-size: 12px;
 +  font-style: italic;
 +  color: var(--text-2);
 +  border-bottom: 1px solid var(--line);
 +}
 +/* The document draws these as a box holding just the chosen label. A native
 +   select would instead size to its widest option, so the real control lies
 +   transparently over the drawn one — the same overlay the code field uses. */
 +.ndSelect {
 +  position: relative;
 +  display: inline-flex;
 +  align-items: center;
 +  gap: 10px;
 +  padding: 7px 13px;
 +  border-radius: 9px;
 +  border: 1px solid var(--line-strong);
 +  background: var(--shell);
 +  color: var(--ink);
 +  font-size: 11.5px;
 +  font-weight: 600;
 +}
 +.ndSelect select {
 +  position: absolute;
 +  inset: 0;
 +  width: 100%;
 +  height: 100%;
 +  margin: 0;
 +  padding: 0;
 +  border: 0;
 +  border-radius: 9px;
 +  opacity: 0;
 +  cursor: pointer;
 +}
 +.ndSelect:focus-within { outline: 2px solid var(--focus); outline-offset: 2px; }
 +.ndSelectCaret { font-size: 8px; color: var(--muted); }
 +
 +/* The legacy panel's footer sits a hair tighter than the main card's. */
 +.ndLegacy .ndProvenance { padding: 13px 0; }
 +.ndSettingsLink {
 +  padding: 0;
 +  border: 0;
 +  background: transparent;
 +  color: var(--ink);
 +  font: inherit;
 +  font-weight: 700;
 +  cursor: pointer;
 +  text-decoration: underline;
 +  text-underline-offset: 3px;
 +}
 +
 +.ndActions { display: flex; align-items: center; gap: 12px; margin-top: 22px; }
 +.ndStart {
 +  padding: 10px 22px;
 +  border: 0;
 +  border-radius: 999px;
 +  background: var(--ink);
 +  color: var(--bg);
 +  font-family: inherit;
 +  font-size: 12.5px;
 +  font-weight: 700;
 +  cursor: pointer;
 +  transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
 +}
 +.ndStart:hover:not(:disabled) { transform: scale(1.04); }
 +.ndStart:disabled { opacity: 0.45; cursor: not-allowed; }
 +.ndCancel {
 +  padding: 10px 18px;
 +  border: 1px solid var(--line-strong);
 +  border-radius: 999px;
 +  background: transparent;
 +  color: var(--muted);
 +  font-family: inherit;
 +  font-size: 12px;
 +  font-weight: 600;
 +  cursor: pointer;
 +}
 +.ndActionsSpacer { flex: 1; }
 +.ndKeyHint { font-size: 10.5px; color: var(--muted); }
 +
 +/* === debate-tiers S01 === */
 +.ndTier {
 +  display: grid;
 +  grid-template-columns: repeat(2, minmax(0, 1fr));
 +  gap: 10px;
 +  margin-top: 20px;
 +}
 +.ndTierOption {
 +  display: flex;
 +  flex-direction: column;
 +  align-items: flex-start;
 +  gap: 9px;
 +  padding: 13px 14px;
 +  border: 1px solid var(--line);
 +  border-radius: 12px;
 +  background: var(--core);
 +  font-family: inherit;
 +  text-align: left;
 +  cursor: pointer;
 +}
 +.ndTierOption[aria-checked="true"] {
 +  border-color: var(--line-strong);
 +  background: var(--shell);
 +}
 +.ndTierName {
 +  padding: 4px 12px;
 +  border-radius: 999px;
 +  background: transparent;
 +  color: var(--muted);
 +  font-size: 10.5px;
 +  font-weight: 600;
 +}
 +.ndTierOption[aria-checked="true"] .ndTierName {
 +  background: var(--ink);
 +  color: var(--bg);
 +  font-weight: 700;
 +}
 +.ndTierPromise {
 +  font-size: 11.5px;
 +  color: var(--text-2);
 +}
 +.ndTierModels {
 +  display: flex;
 +  flex-wrap: wrap;
 +  gap: 10px;
 +}
 +.ndTierModel {
 +  display: inline-flex;
 +  align-items: center;
 +  gap: 5px;
 +  font-family: var(--font-mono);
 +  font-size: 10.5px;
 +  font-weight: 500;
 +  color: var(--text-3);
 +  white-space: nowrap;
 +}
 +.ndSegItem:disabled,
 +.ndSlider:disabled,
 +.ndSteerInput:disabled,
 +.ndSelect:has(select:disabled) {
 +  opacity: 0.45;
 +  cursor: not-allowed;
 +}
 +.ndSelect select:disabled { cursor: not-allowed; }
 +/* === end debate-tiers S01 === */
 +
 +@media (prefers-reduced-motion: reduce) {
 +  .ndStart { transition: none; }
 +  .ndStart:hover:not(:disabled) { transform: none; }
 +}
 +
 +@media (max-width: 720px) {
 +  .ndScreen { padding: 28px 20px 36px; }
 +  .ndRow { flex-wrap: wrap; }
 +  .ndRowSlider .ndRowText { flex: 1 1 100%; }
 +  .ndRowSteering { flex-direction: column; }
 +  .ndSteerField { width: 100%; }
 +}
 +
 +/* ============================================================
 +   Sign up, MFA enrolment & recovery — the design document's
 +   Turn 8, "8a Sign up", "8b MFA enrolment", "8c Recovery code".
 +   ============================================================ */
 +
 +/* 8a — the email field carries its verification control inline. */
 +.authEmailRow { display: flex; gap: 8px; }
 +.authEmailRow input { flex: 1; }
 +.authVerifyEmail {
 +  align-self: stretch;
 +  display: grid;
 +  place-items: center;
 +  padding: 0 14px;
 +  border: 1px solid var(--gold-border);
 +  border-radius: 9px;
 +  background: var(--gold-bg);
 +  color: var(--gold-text);
 +  font-family: inherit;
 +  font-size: 11px;
 +  font-weight: 700;
 +  white-space: nowrap;
 +  cursor: pointer;
 +}
 +.authVerifyEmail:disabled { opacity: 0.55; cursor: not-allowed; }
 +
 +/* Sign-up stacks its password rules; sign-in wraps them on one line. */
 +.authRules[data-stack="true"] { flex-direction: column; gap: 3px; }
 +
 +/* 8b — the enrolment card is wider than the auth card and carries
 +   three numbered steps whose state is the real enrolment state. */
 +.mfaScreen {
 +  flex: 1;
 +  min-height: 0;
 +  overflow: auto;
 +  display: flex;
 +  align-items: flex-start;
 +  justify-content: center;
 +  padding: clamp(24px, 5vw, 56px) clamp(16px, 4vw, 40px);
 +  background-image: radial-gradient(var(--grid-dot) 1px, transparent 1.4px);
 +  background-size: 22px 22px;
 +}
 +.mfaCard {
 +  width: 720px;
 +  max-width: 100%;
 +  border-radius: 18px;
 +  overflow: hidden;
 +  border: 1px solid var(--line-strong);
 +  box-shadow: var(--shadow-auth-card);
 +  background: var(--bg);
 +  color: var(--ink);
 +}
 +.mfaBody { padding: 48px 56px; }
 +
 +.mfaEyebrow {
 +  margin: 0;
 +  font-family: var(--font-mono);
 +  font-size: 9.5px;
 +  font-weight: 700;
 +  letter-spacing: 0.22em;
 +  color: var(--gold);
 +}
 +.mfaTitle {
 +  margin: 12px 0 0;
 +  font-family: var(--font-display);
 +  font-weight: 500;
 +  font-size: 28px;
 +  letter-spacing: -0.02em;
 +}
 +.mfaLede {
 +  margin: 10px 0 0;
 +  max-width: 520px;
 +  font-size: 12px;
 +  line-height: 1.6;
 +  color: var(--text-2);
 +  text-wrap: pretty;
 +}
 +
 +.mfaStep {
 +  margin-top: 14px;
 +  background: var(--core);
 +  border: 1px solid var(--line);
 +  border-radius: 14px;
 +  padding: 16px 18px;
 +}
 +.mfaStep[data-state="done"] {
 +  margin-top: 22px;
 +  display: flex;
 +  align-items: center;
 +  gap: 12px;
 +  padding: 14px 18px;
 +}
 +.mfaStepHead { display: flex; align-items: center; gap: 12px; }
 +.mfaStepNum {
 +  flex: 0 0 auto;
 +  display: grid;
 +  place-items: center;
 +  width: 24px;
 +  height: 24px;
 +  border-radius: 999px;
 +  font-size: 11px;
 +  font-weight: 800;
 +}
 +.mfaStepNum[data-state="done"] { background: var(--pro); color: var(--core); }
 +.mfaStepNum[data-state="active"] { background: var(--ink); color: var(--bg); }
 +.mfaStepNum[data-state="pending"] {
 +  border: 1.5px solid var(--line-strong);
 +  color: var(--muted);
 +}
 +.mfaStepTitle { margin: 0; font-size: 12.5px; font-weight: 700; }
 +.mfaStepHint {
 +  margin: 2px 0 0;
 +  font-size: 11px;
 +  line-height: normal;
 +  color: var(--text-2);
 +}
 +/* Steps 2 and 3 indent their body under the numbered badge. */
 +.mfaStepBody { margin: 4px 0 0 36px; }
 +.mfaStepDone { margin: 0; font-size: 12px; font-weight: 700; color: var(--pro); }
 +.mfaSpacer { flex: 1; }
 +
 +.mfaSetup { display: flex; gap: 22px; margin-top: 14px; align-items: flex-start; }
 +.mfaQr {
 +  flex: 0 0 auto;
 +  width: 170px;
 +  height: 170px;
 +  background: var(--qr-paper);
 +  border: 1px solid var(--line-strong);
 +  border-radius: 8px;
 +}
 +.mfaSetupBody { flex: 1; min-width: 0; }
 +.mfaSetupHint { margin: 0; font-size: 11px; line-height: 1.55; color: var(--text-2); }
 +.mfaSecret {
 +  display: block;
 +  width: 100%;
 +  margin-top: 10px;
 +  padding: 9px 12px;
 +  border-radius: 9px;
 +  border: 1px solid var(--line-strong);
 +  background: var(--shell);
 +  color: var(--muted);
 +  font-family: var(--font-mono);
 +  font-size: 10.5px;
 +  line-height: 12px;
 +}
 +.mfaGhostRow { display: flex; gap: 8px; margin-top: 10px; align-items: center; }
 +.mfaGhost {
 +  padding: 7px 14px;
 +  border-radius: 999px;
 +  border: 1px solid var(--line-strong);
 +  background: transparent;
 +  color: var(--ink);
 +  font-family: inherit;
 +  font-size: 11px;
 +  font-weight: 600;
 +  cursor: pointer;
 +}
 +.mfaGhost:disabled { opacity: 0.55; cursor: not-allowed; }
 +.mfaCopied { font-size: 11px; color: var(--pro); font-weight: 600; }
 +
 +.mfaCodeLabel { display: block; margin-top: 12px; font-size: 11px; font-weight: 700; }
 +.mfaCodeRow { display: flex; gap: 8px; margin-top: 7px; align-items: center; }
 +.mfaCodeInput {
 +  flex: 1;
 +  min-width: 0;
 +  padding: 9px 13px;
 +  border-radius: 9px;
 +  border: 1px solid var(--gold-border);
 +  outline: none;
 +  background: var(--gold-bg);
 +  color: var(--ink);
 +  font-family: var(--font-mono);
 +  font-size: 14px;
 +  line-height: 16.5px;
 +  letter-spacing: 0.3em;
 +}
 +.mfaCodeInput::placeholder { color: var(--muted); }
 +.mfaCodeInput:focus { box-shadow: 0 0 0 3px color-mix(in oklch, var(--gold) 22%, transparent); }
 +.mfaPrimary {
 +  padding: 9px 15px;
 +  border: 0;
