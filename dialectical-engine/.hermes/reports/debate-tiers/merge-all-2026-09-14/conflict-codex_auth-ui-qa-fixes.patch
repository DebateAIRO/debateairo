 +
 +/* Buttons */
 +.lpCta {
 +  display: inline-flex;
 +  align-items: center;
 +  border-radius: var(--lp-r-btn);
 +  background: var(--ink);
 +  color: var(--bg);
 +  font-weight: 600;
 +  transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
