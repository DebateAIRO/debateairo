 +
 +@media (max-width: 640px) {
 +  .mfaBody { padding: 32px 20px; }
 +  .mfaSetup { flex-direction: column; }
 +  .mfaStepBody, .mfaCodes, .mfaCodeActions { margin-left: 0; }
 +  .mfaCodeActions { flex-wrap: wrap; }
 +  .mfaTypeback { min-width: 160px; }
 +  .mfaCodes { grid-template-columns: 1fr; }
 +}
 +
 +/* 8c — the replacement recovery code sits on the core surface with the
 +   document's green "signed in securely" accent bar. */
 +.authSuccessWarning {
 +  position: relative;
 +  overflow: hidden;
 +  border-color: var(--line);
 +  background: var(--core);
 +  padding: 20px;
 +  gap: 0;
 +}
 +.authSuccessAccent {
 +  position: absolute;
 +  top: 0;
 +  left: 20px;
 +  width: 52px;
 +  height: 4px;
 +  border-radius: 0 0 5px 5px;
 +  background: var(--pro);
 +}
 +.authSuccessWarning .authNoticeKicker {
 +  margin: 0;
 +  color: var(--pro);
 +  font-size: 9px;
 +  letter-spacing: 0.16em;
 +}
 +.authSuccessWarning h2 {
 +  margin: 9px 0 0;
 +  font-family: var(--font-sans);
 +  font-size: 13.5px;
 +  font-weight: 700;
 +  line-height: 1.3;
 +}
 +.authSuccessWarning p {
 +  margin: 5px 0 0;
 +  font-size: 11.5px;
 +  line-height: 1.55;
 +  color: var(--text-2);
 +}
 +.authSuccessWarning .authRecoveryCode {
 +  margin-top: 13px;
 +  padding: 13px;
 +  border: 1px dashed var(--gold-border);
 +  border-radius: 10px;
 +  background: var(--gold-bg);
 +  color: var(--ink);
 +  font: 700 15px/1.4 var(--font-mono);
 +  letter-spacing: 0.12em;
 +}
 +.authSuccessWarning .authPrimary { margin-top: 14px; }
 +
 +/* 8a keeps the sign-in link inside the panel rather than under the card. */
 +.authPanelFooter {
 +  margin: 0;
 +  text-align: center;
 +  font-size: 11px;
 +  color: var(--muted);
 +}
 +.authPanelFooter a {
 +  color: var(--ink);
 +  font-weight: 700;
 +  text-decoration: underline;
 +  text-underline-offset: 3px;
 +}
 +
 +/* 8c: the replacement-code notice IS the panel core, so the core goes flush
 +   rather than nesting a second surface inside the bezel. */
 +.authPanelCore:has(> .authSuccessWarning) {
 +  padding: 0;
 +  border: 0;
 +  background: transparent;
 +}
 +/* JetBrains Mono runs a taller default line box than the document's
 +   ui-monospace, so these two are pinned to the drawn heights. */
 +.authSuccessWarning .authNoticeKicker { line-height: 1.17; }
 +.authSuccessWarning .authRecoveryCode { line-height: 1.17; }
 +
 +/* 8a runs a hair tighter than the other two auth cards: a 13px field rhythm
 +   and 48px of floor rather than 56px. */
 +.authForm[data-form="signup"] { gap: 13px; }
 +.authCardInner:has([data-form="signup"]) { padding-bottom: clamp(32px, 5.6vw, 48px); }
 +
 +/* ============================================================
 +   Home library — the design document's Turn 3, "3a Library".
 +   ============================================================ */
 +
 +.libScreen { padding: 44px 56px 48px; }
 +.libInner { max-width: 820px; margin: 0 auto; }
 +
 +.libEyebrow {
 +  margin: 0;
 +  font-family: var(--font-mono);
 +  font-size: 9.5px;
 +  font-weight: 700;
 +  letter-spacing: 0.22em;
 +  color: var(--gold);
 +}
 +.libTitle {
 +  margin: 12px 0 0;
 +  font-family: var(--font-display);
 +  font-weight: 500;
 +  font-size: 36px;
 +  letter-spacing: -0.025em;
 +}
 +.libLede {
 +  margin: 12px 0 0;
 +  max-width: 560px;
 +  font-size: 13.5px;
 +  line-height: 1.6;
 +  color: var(--muted);
 +  text-wrap: pretty;
 +}
 +
 +/* The composer sits in the approved bezel. */
 +.libComposer {
 +  margin-top: 26px;
 +  background: var(--shell);
 +  border: 1px solid var(--line-strong);
