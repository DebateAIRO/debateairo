+            $1::uuid,'core.run',($1::uuid)::text,'content_ciphertext',
+            '{"v":1,"keyId":"c2-key","nonce":"c2-nonce","ct":"c2-ciphertext","tag":"c2-tag"}'::jsonb
+          ),
+          decode(md5(($1::uuid)::text||':secret')||md5(($1::uuid)::text||':secret:2'),'hex'),
