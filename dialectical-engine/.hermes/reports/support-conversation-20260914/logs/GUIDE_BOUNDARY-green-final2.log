	    SELECT 1 FROM (VALUES
	      ('session','shredded_at'),('case','shredded_at'),
	      ('session_key','wrapped_key'),('session_key','destroyed_at'),
	      ('case_key','wrapped_key'),('case_key','destroyed_at')
