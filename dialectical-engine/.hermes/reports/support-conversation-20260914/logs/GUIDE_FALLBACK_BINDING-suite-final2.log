	        ('session','consent_own_context_at'),
	        ('case','state'),('case','summary_ciphertext'),
	        ('case','summary_at'),('case','summary_status'),
	        ('case','summary_authoritative'),
	        ('public_incident','ended_at'),
	        ('session_key','wrapped_key'),('session_key','destroyed_at'),
