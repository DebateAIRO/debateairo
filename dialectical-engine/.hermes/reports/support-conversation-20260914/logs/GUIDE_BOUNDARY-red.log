	      OR v_fk.confdeltype<>'a' OR v_fk.confupdtype<>'a'
	      OR v_fk.confmatchtype<>'s'
	      OR v_fk.conrelid<>'support.case_key'::regclass
	      OR v_fk.confrelid<>'support."case"'::regclass
