+    const reviewManifest = JSON.parse(readFileSync(manifestPath, "utf8")) as unknown;
+
+    const corpus = loadHelpCorpus(corpusDirectory, {
+      reviewManifest,
+      recoveryComponents: componentBytes,
+      requireReviewedRecovery: true,
+    });
