+  return [
+    profile.publicPort,
+    profile.uiPort,
+    profile.apiPort,
+    ...profile.providerPorts,
+    profile.supportModelPort,
+    profile.postgresPort,
+    profile.hatchetGrpcPort,
+    profile.hatchetApiPort
+  ];
+}
