+    vi.stubEnv("DEBATEAI_DEV_CUSTODY_ROOT", fixture.custodyRoot);
+    expect(DEVELOPMENT_API_ENVIRONMENT_KEYS).toContain("DEBATEAI_DEPLOYMENT_MODE");
