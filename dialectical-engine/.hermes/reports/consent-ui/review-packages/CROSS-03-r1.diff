+
+/** Opens slice S01's ONE delimited block. */
+export const S01_OPEN_MARKER = "/* === consent-ui S01 === */";
+
+/** Closes slice S01's ONE delimited block. */
+export const S01_CLOSE_MARKER = "/* === end consent-ui S01 === */";
