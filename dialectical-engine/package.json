{
  "name": "debateai-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "pnpm run generate:contract && pnpm run typecheck && pnpm --filter dialectical-engine-web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:s00": "vitest run tests/unit tests/integration tests/architecture",
    "lint": "pnpm run audit:architecture && pnpm run audit:source",
    "audit:architecture": "tsx tools/orphan-audit/src/cli.ts architecture",
    "audit:source": "tsx tools/orphan-audit/src/cli.ts source",
    "audit:text-bytes": "tsx tools/check-text-control-bytes.ts",
    "audit:orphans": "tsx tools/orphan-audit/src/cli.ts orphans",
    "generate:contract": "tsx packages/contract/src/generate.ts",
    "db:migrate": "tsx apps/runner/src/migrate-cli.ts",
    "db:provision-principals": "tsx apps/runner/src/production-database-principals-cli.ts",
    "dev:auth:provision-principals": "tsx apps/runner/src/dev-database-principals-cli.ts",
    "dev:auth:generate-secrets": "tsx apps/runner/src/dev-secret-files-cli.ts",
    "dev:auth:seed-register": "tsx apps/runner/src/dev-deployment-register-cli.ts",
    "dev:auth:generate-tls": "node deploy/dev-auth/create-local-certificate.mjs",
    "dev:auth:tls-front-door": "node deploy/dev-auth/tls-front-door.mjs",
    "dev:auth:data-plane": "tsx apps/runner/src/dev-auth-data-plane-cli.ts",
    "dev:auth:provision-hatchet-token": "tsx apps/runner/src/dev-hatchet-token-cli.ts",
    "dev:auth:assemble-api-env": "tsx apps/runner/src/dev-api-environment-cli.ts",
    "dev:auth:api": "tsx apps/runner/src/dev-api-process-cli.ts",
    "dev:auth:ui": "tsx apps/runner/src/dev-ui-process-cli.ts",
    "dev:auth:up": "tsx apps/runner/src/dev-auth-stack-cli.ts",
    "compose:env": "tsx packages/register/src/compose-env.ts",
    "job:replay-self-test": "tsx apps/scheduler/src/cli.ts replay-self-test",
    "job:liveness-sweep": "tsx apps/scheduler/src/cli.ts liveness-sweep",
    "job:settlement-watch": "tsx apps/scheduler/src/cli.ts settlement-watch",
    "job:review-catch-up": "tsx acceptance/review-catch-up.ts",
    "replay:ceremony": "tsx apps/replay/src/cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@debateai/battery-decision": "workspace:*",
    "@debateai/battery": "workspace:*",
    "@debateai/budget": "workspace:*",
    "@debateai/api": "workspace:*",
    "@debateai/contract": "workspace:*",
    "@debateai/crypto": "workspace:*",
    "@debateai/critique": "workspace:*",
    "@debateai/db": "workspace:*",
    "@debateai/graph": "workspace:*",
    "@debateai/kernel": "workspace:*",
    "@debateai/ledger": "workspace:*",
    "@debateai/liveness": "workspace:*",
    "@debateai/memory": "workspace:*",
    "@debateai/obs-capture": "workspace:*",
    "@debateai/judgement": "workspace:*",
    "@debateai/propagation": "workspace:*",
    "@debateai/published-arithmetic": "workspace:*",
    "@debateai/providers": "workspace:*",
    "@debateai/register": "workspace:*",
    "@debateai/runner": "workspace:*",
    "@debateai/settlement": "workspace:*",
    "@debateai/serve": "workspace:*",
    "@debateai/valuation": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "4.9.0",
    "jsdom": "^30.0.1",
    "testcontainers": "12.1.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
