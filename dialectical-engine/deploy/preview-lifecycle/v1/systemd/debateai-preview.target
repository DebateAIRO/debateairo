# Install as /etc/systemd/system/debateai-preview.target, then: systemctl enable debateai-preview.target
# Brings the whole private preview up at boot. The runner is deliberately NOT here (it stays masked).
[Unit]
Description=DebateAI V3 private preview (all services)
Documentation=file:///opt/debateai-v3-preview/operator/lifecycle-v1/dialectical-engine/deploy/preview-lifecycle/v1/README.md
Wants=network-online.target
After=network-online.target
Wants=debateai-preview-postgresql.service debateai-preview-hatchet.service debateai-preview-hatchet-gateway.service
Wants=debateai-preview-capture.service debateai-preview-provider-budget.service debateai-preview-turnstile.service
# No fixed API or website (side-by-side spec §10): they are template units, one instance per release.
# The switch writes debateai-preview.target.d/60-current-release.conf naming the current release's
# debateai-preview-api@<label>.service and debateai-preview-ui@<label>.service, so a boot starts those.
# The spending gate's two watchers (deploy/preview-gate/v3; v2 before it): one email per halt, one per address change.
Wants=debateai-preview-gate-halt-watch.timer debateai-preview-gate-addresses.timer

[Install]
WantedBy=multi-user.target
