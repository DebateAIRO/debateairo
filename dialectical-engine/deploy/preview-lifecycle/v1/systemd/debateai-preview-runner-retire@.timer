# Install as /etc/systemd/system/debateai-preview-runner-retire@.timer (root 0644).
# The backstop for one older release (side-by-side spec §4; %i = the release label): 7.5 hours after the
# switch (27,000 s) it asks that release to retire now. This template names NO time: the switch writes
#   debateai-preview-runner-retire@<label>.timer.d/50-at.conf
# with one absolute UTC OnCalendar= and then enables and starts debateai-preview-runner-retire@<label>.timer.
# Without that drop-in systemd refuses to load an instance (a timer needs a time): nothing fires by accident.
# Persistent=true: a server that was off at that time asks at the next boot (the [Install] below keeps the
# enabled instance in timers.target across reboots). A rollback disables the old release's instance.
[Unit]
Description=DebateAI preview: backstop for release %i (asks it to retire 7.5 hours after the switch)

[Timer]
Unit=debateai-preview-runner-retire@%i.service
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
