# Install as /etc/systemd/system/debateai-preview-runner-retire-check@.timer (root 0644).
# Started only by debateai-preview-runner-retire@%i.service, right after it wrote RETIRE_REQUESTED for
# release %i: 25 minutes (1,500 s) later the check runs once (side-by-side spec §4). The check itself
# refuses RETIRE_CHECK_TOO_EARLY before 1,500 s after the latest request, so this timer is never earlier.
# No [Install]: it is never started at boot.
[Unit]
Description=DebateAI preview: check release %i 25 minutes after it was asked to retire

[Timer]
OnActiveSec=25min
AccuracySec=1s
Unit=debateai-preview-runner-retire-check@%i.service
