# Install as /etc/systemd/system/debateai-preview-backup.service (started by the .timer).
# Root: it opens the dump file in the root-only folder; pg_dump itself runs as postgres over
# the local socket. No network, no DebateAI credential.
[Unit]
Description=DebateAI preview: nightly local database dump (keeps the 7 newest)
After=debateai-preview-postgresql.service
OnFailure=debateai-preview-alert@%n.service

[Service]
Type=oneshot
ExecStart=/opt/debateai-toolchain/node-v26.8.2-linux-x64/bin/node /opt/debateai-v3-preview/operator/lifecycle-v1/dialectical-engine/deploy/preview-lifecycle/v1/backup.mjs
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
