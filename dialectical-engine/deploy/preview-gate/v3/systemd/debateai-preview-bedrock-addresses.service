# Install as /etc/systemd/system/debateai-preview-bedrock-addresses.service (root:root 0644).
# Started hourly by debateai-preview-bedrock-addresses.timer. It runs the Amazon Bedrock gate's own start check while
# the gate runs: every IPv4 address of bedrock-runtime.us-east-1.amazonaws.com must be inside a range of the drop-in. A
# mismatch not announced before fails this unit (exit 3) and its OnFailure= notice (bedrock-addresses) emails the owner
# how to update the list: at most one email per change. It reads only DNS (through the local resolver stub) and the
# drop-in; no key, no gate state. Unprivileged.
[Unit]
Description=DebateAI preview: check the Amazon Bedrock gate's allow-list against DNS
OnFailure=debateai-preview-notice@bedrock-addresses-mismatch.service

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/bin/python3 -I /opt/debateai-v3-preview/operator/bedrock-budget-v1/bedrock_addresses.py watch --dropin /etc/systemd/system/debateai-preview-bedrock-budget.service.d/50-bedrock-addresses.conf --state /var/lib/debateai-preview-bedrock-addresses/announced
# Only this unit's own state: the fingerprint of the last announced mismatch.
StateDirectory=debateai-preview-bedrock-addresses
StateDirectoryMode=0700
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/etc/debateai-v3-preview -/var/lib/debateai-v3-preview -/var/lib/postgresql -/etc/postfix
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.53/32
