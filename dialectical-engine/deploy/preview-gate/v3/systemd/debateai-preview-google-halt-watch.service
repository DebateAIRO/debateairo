# Install as /etc/systemd/system/debateai-preview-google-halt-watch.service (root:root 0644).
# The DeepInfra halt watcher with the Google gate's folder and its own notice kind: once per halt
# of the Google gate it queues debateai-preview-notice@google-halted-<reason>.service, whose email
# carries the Google gate's own re-open command. Started every minute by its timer.
[Unit]
Description=DebateAI preview: email the owner once when the Google spending gate halts
OnFailure=debateai-preview-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /opt/debateai-v3-preview/operator/google-budget-v1/gate_watch.py --private /var/lib/debateai-v3-preview/provider-google-authority-v1 --state /var/lib/debateai-preview-google-halt-watch/announced-halt.json --notice google-halted
StateDirectory=debateai-preview-google-halt-watch
StateDirectoryMode=0700
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# status never reads the key: hide it, and every other gate's state.
InaccessiblePaths=-/var/lib/debateai-v3-preview/provider-google-authority-v1/api-key.txt
InaccessiblePaths=-/etc/debateai-v3-preview/api -/etc/debateai-v3-preview/runner -/etc/debateai-v3-preview/api.env -/root -/var/lib/postgresql -/etc/postfix
InaccessiblePaths=-/var/lib/debateai-v3-preview/provider-team-authority-v2 -/etc/debateai-v3-preview/provider-team-go-v2.json
# Every other gate's private folder and GO: this watcher reads only the Google gate's status.
InaccessiblePaths=-/var/lib/debateai-v3-preview/provider-deepinfra-authority-v3 -/etc/debateai-v3-preview/provider-deepinfra-go-v3.json
InaccessiblePaths=-/var/lib/debateai-v3-preview/provider-anthropic-authority-v1 -/etc/debateai-v3-preview/provider-anthropic-go-v1.json
InaccessiblePaths=-/etc/debateai-v3-preview/auth-dev-v1 -/var/lib/debateai-v3-preview/provider-test-authority -/var/lib/debateai-v3-preview/api -/etc/debateai-v3-preview/lifecycle
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
