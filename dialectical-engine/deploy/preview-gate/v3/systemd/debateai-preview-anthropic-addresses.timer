# Install as /etc/systemd/system/debateai-preview-anthropic-addresses.timer (root:root 0644).
# Wanted by debateai-preview.target through debateai-preview.target.d/50-anthropic-gate.conf,
# so it runs whenever the preview is up (README-anthropic.md starts it the first time).
[Unit]
Description=DebateAI preview: hourly check of the Anthropic gate's allowed range

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
