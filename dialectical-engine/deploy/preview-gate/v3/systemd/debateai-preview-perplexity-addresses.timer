# Install as /etc/systemd/system/debateai-preview-perplexity-addresses.timer (root:root 0644).
# Wanted by debateai-preview.target through debateai-preview.target.d/50-perplexity-gate.conf,
# so it runs whenever the preview is up (README-perplexity.md starts it the first time).
[Unit]
Description=DebateAI preview: hourly check of the Perplexity gate's allow-list

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
