# Install as /etc/systemd/system/debateai-preview-perplexity-halt-watch.service (root:root 0644).
# Started every minute by debateai-preview-perplexity-halt-watch.timer (plan 2026-10-30, task W1-1). The same watcher as
# the other gates' (gate_watch.py, copied into the Perplexity gate folder, so it asks the PERPLEXITY gate for
# `status`): read-only, and once per halt it queues its own notice,
# debateai-preview-notice@perplexity-halted-<reason>.service (--notice perplexity-halted), with
# `systemctl start --no-block`: the email names the Perplexity gate's re-open command. It has its
# own state file and its own notice unit, so two gates' halts are never one email.
# Daily unbilled alert (alert, never halt): once status's today_unbilled_releases reaches --unbilled-alert-at (100
# here; 1..100000), it queues ONE debateai-preview-notice@perplexity-unbilled-<count>_<YYYY>_<MM>_<DD>.service per
# Bucharest day. The day is recorded first in announced-unbilled.json next to the --state file (this unit's
# StateDirectory). Change the threshold here, then `systemctl daemon-reload`.
# Booked-at-maximum alert (alert, never halt): each time status's today_booked_max goes up (a search sent, then its
# connection timed out or broke, or Perplexity answered a server error without results, booked at its $0.001), it
# queues debateai-preview-notice@perplexity-booked-<count>_<YYYY>_<MM>_<DD>.service; the day and count are recorded
# first in announced-booked.json next to the --state file.
# Root only because the gate's private folder is root-only; the key file is hidden from it, and it
# has no network at all (systemctl talks to systemd over a local socket).
[Unit]
Description=DebateAI preview: email the owner once when the Perplexity spending gate halts
OnFailure=debateai-preview-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /opt/debateai-v3-preview/operator/perplexity-budget-v1/gate_watch.py --private /var/lib/debateai-v3-preview/provider-perplexity-authority-v1 --state /var/lib/debateai-preview-perplexity-halt-watch/announced-halt.json --notice perplexity-halted --unbilled-alert-at 100
StateDirectory=debateai-preview-perplexity-halt-watch
StateDirectoryMode=0700
# Short, so a stuck status run never holds the gate's shared lock long (the gate waits 10 s).
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
InaccessiblePaths=-/var/lib/debateai-v3-preview/provider-perplexity-authority-v1/api-key.txt
InaccessiblePaths=-/etc/debateai-v3-preview/api -/etc/debateai-v3-preview/runner -/etc/debateai-v3-preview/api.env -/root -/var/lib/postgresql -/etc/postfix
InaccessiblePaths=-/var/lib/debateai-v3-preview/provider-team-authority-v2 -/etc/debateai-v3-preview/provider-team-go-v2.json
InaccessiblePaths=-/var/lib/debateai-v3-preview/provider-deepinfra-authority-v3 -/etc/debateai-v3-preview/provider-deepinfra-go-v3.json -/var/lib/debateai-v3-preview/provider-google-authority-v1 -/etc/debateai-v3-preview/provider-google-go-v1.json
InaccessiblePaths=-/var/lib/debateai-v3-preview/provider-anthropic-authority-v1 -/etc/debateai-v3-preview/provider-anthropic-go-v1.json
InaccessiblePaths=-/etc/debateai-v3-preview/auth-dev-v1 -/var/lib/debateai-v3-preview/provider-test-authority -/var/lib/debateai-v3-preview/api -/etc/debateai-v3-preview/lifecycle
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
