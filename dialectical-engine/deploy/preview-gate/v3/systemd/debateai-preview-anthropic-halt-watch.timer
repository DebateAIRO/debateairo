# Install as /etc/systemd/system/debateai-preview-anthropic-halt-watch.timer (root:root 0644).
# Wanted by debateai-preview.target through debateai-preview.target.d/50-anthropic-gate.conf.
[Unit]
Description=DebateAI preview: check every minute whether the Anthropic spending gate halted

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=5s
