# Install as /etc/systemd/system/debateai-preview-provider-budget.service (root:root 0644).
# It REPLACES the v1 unit of the same name (archive that first; README step 7). The lifecycle
# target and the API drop-in already Wants= this exact name, so it starts at boot only through
# debateai-preview.target; it has no [Install] section of its own.
# Base: the measured v1 unit (2026-10-09), hardening unchanged. Changes: the v2 command line
# (no --helper; --socket names the fresh socket explicitly), python3 -I everywhere, the v2
# paths, more InaccessiblePaths (all "-": a path archived later must not stop the gate), the
# DeepInfra addresses moved to a checked drop-in, and a restart policy with a graceful stop.
[Unit]
Description=DebateAI preview: DeepInfra spending gate v2 (one daily team pot, Europe/Bucharest)
Documentation=file:///opt/debateai-v3-preview/operator/team-budget-v2/README.md
Wants=network-online.target
After=network-online.target nss-lookup.target
# Same policy as the lifecycle drop-ins: at most 4 tries in 15 minutes, then one email.
StartLimitIntervalSec=900
StartLimitBurst=4
OnFailure=debateai-preview-alert@%n.service

[Service]
Type=simple
User=root
Group=root
# 1. Every address api.deepinfra.com has today must be in the allow-list drop-in, or the gate
#    does not start (DEEPINFRA_ADDRESSES_CHANGED; README "DeepInfra addresses").
ExecStartPre=/usr/bin/python3 -I /opt/debateai-v3-preview/operator/team-budget-v2/deepinfra_addresses.py check --dropin /etc/systemd/system/debateai-preview-provider-budget.service.d/50-deepinfra-addresses.conf
# 2. The model is listed upstream, reached through the same address filter (no key is sent).
ExecStartPre=/usr/bin/python3 -I -c "import urllib.request,json; r=urllib.request.build_opener(urllib.request.ProxyHandler({})).open('https://api.deepinfra.com/models/zai-org/GLM-5.3-Flash',timeout=20); assert r.status==200; json.load(r)"
ExecStart=/usr/bin/python3 -I /opt/debateai-v3-preview/operator/team-budget-v2/preview_budget_authority.py serve --private /var/lib/debateai-v3-preview/provider-team-authority-v2 --go /etc/debateai-v3-preview/provider-team-go-v2.json --socket /run/debateai-v3-preview/team-budget-v2.sock
# Restart after a crash. Safe because a restart can never spend more: the pot, the ledger and a
# halt live on disk; serve start halts on any call the crash interrupted, and only root's
# `activate` re-opens a halted gate. A start-up refusal (exit 2) retries too, then emails.
Restart=on-failure
RestartMode=direct
RestartSec=30
# SIGTERM: the socket closes at once and nothing more is reserved; calls in flight finish and
# settle (600 s deadline, plus 2 x 10 s locks), and each reply then gets 30 s or the gate halts;
# the socket file is removed and serve exits 0. After 700 s systemd sends SIGKILL; the next
# start then removes the stale socket and halts on any interrupted call.
KillSignal=SIGTERM
TimeoutStopSec=700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
ReadWritePaths=/var/lib/debateai-v3-preview/provider-team-authority-v2 /run/debateai-v3-preview
InaccessiblePaths=-/etc/debateai-v3-preview/api -/etc/debateai-v3-preview/runner -/etc/debateai-v3-preview/api.env -/root -/var/lib/postgresql -/etc/postfix
InaccessiblePaths=-/etc/debateai-v3-preview/auth-dev-v1 -/var/lib/debateai-v3-preview/provider-test-authority -/var/lib/debateai-v3-preview/api -/etc/debateai-v3-preview/lifecycle
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Nothing but the local resolver stub (127.0.0.53; /etc/resolv.conf is systemd-resolved's
# stub-resolv.conf, measured). Not all of localhost: that would open local services such as
# the mail relay on port 25. The DeepInfra /32s come from 50-deepinfra-addresses.conf.
IPAddressDeny=any
IPAddressAllow=127.0.0.53/32
