# Install as /etc/systemd/system/debateai-preview-gate-addresses.timer (root:root 0644).
# Part of the standard install: debateai-preview.target Wants= this timer, so it runs whenever the
# preview is up (README step 10 starts it the first time).
[Unit]
Description=DebateAI preview: hourly check of the spending gate's DeepInfra allow-list

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
