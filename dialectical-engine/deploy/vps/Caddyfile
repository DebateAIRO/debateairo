# deploy/vps/Caddyfile
# The only process on the VPS that listens on a public interface (PLAN §8 C3, R2).
# Caddy terminates TLS (automatic ACME, HTTP->HTTPS redirect is implicit) and proxies to the
# Next front door on loopback. Everything else — APIs 127.0.0.1:491/492, Postgres unix socket,
# Hatchet 127.0.0.1:7077/8888 — is unreachable from outside the box.
#
# Deliberately absent (audit L7 "C2/C3 validation", gap 2): no proxy-trust directive. Caddy >= 2.5
# only replaces a client-supplied X-Forwarded-For with the peer address when such a directive is
# set; leaving it unset keeps the "last hop wins" invariant that apps/ui/trusted-client-ip.mjs
# relies on (it reads the LAST hop, which is the address Caddy itself observed).
# Also absent: the log directive that un-redacts credential headers. Caddy redacts
# Cookie/Authorization/Set-Cookie by default; turning that off would write session cookies to
# /var/log/caddy. The architecture test pins both absences as plain substrings, so neither name
# may appear here even in a comment.
#
# Set DEBATEAI_PUBLIC_HOSTNAME and DEBATEAI_ACME_EMAIL in /etc/default/caddy (see README §3).
#
# Two slots (side-by-side spec §6, §10): each release's website listens on its slot's port, A = 127.0.0.1:481 and
# B = 127.0.0.1:482 (its API on 491 / 492), and this one fixed config proxies to both. The ports are below 1024: of
# this kit's units only the website and API units hold the capability to bind them, each limited to its own two
# ports, so no unprivileged process and no other unit of this kit can stand in for a slot (NV-55; README §10 names
# the daemons that hold that capability by design). An active health check
# asks each website's /readyz every second; a slot is taken out after two failed checks since it last turned healthy
# (2 s for a website that answers 503 at once, the release tool's take-out budget) and back in on its first pass. A
# probe may take 3 s, above the website's own 2 s wait for its API, so one slow answer is never a failure (NV-27).
# A website is ready only while its own API's release is current and the
# release table's "take traffic from" time has passed, so at most one slot is ever healthy. At a switch the old pair
# turns not-ready at once and the new pair a few seconds later (break-before-make); a request that arrives in between
# waits up to 12 s (lb_try_duration) instead of failing. Caddy runs with `admin off`, so this file only takes effect
# through `systemctl restart caddy`, never a reload (README §6).
# The payment marks (/payment-marks/<name>.svg) never reach the website: Caddy serves exactly three named files from
# root's folder /etc/debateai/payment-marks/ (README §3, §14.7).

{
	email {$DEBATEAI_ACME_EMAIL}
	admin off
}

# The one proxy, imported by the public site and by the loopback check site below.
(debateai_slots) {
	reverse_proxy 127.0.0.1:481 127.0.0.1:482 {
		# The first healthy upstream takes every request; with none healthy, hold and retry every 250 ms for 12 s.
		lb_policy first
		lb_try_duration 12s
		lb_try_interval 250ms
		health_uri /readyz
		health_status 200
		# NV-27: the take-out budget is release-switch.mjs CADDY_TAKE_OUT_S; tests/architecture/slot-health-budget.test.ts pins both.
		health_interval 1s
		health_timeout 3s
		health_passes 1
		health_fails 2
		# No secret in the health check (NV-55): server.mjs answers /readyz to any peer; the check carries nothing a
		# listener could keep. It asks each slot's port directly; the public site below refuses /readyz itself and root
		# reads it through the loopback site (:3090).
		# {remote_host} is the socket peer Caddy observed — never a caller-supplied header.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		# C2b: the UI honours the hop above only when this secret matches (timingSafeEqual in
		# apps/ui/trusted-client-ip.mjs). Without it any local process able to open
		# 127.0.0.1:481 or :482 could forge a client address and evade the per-IP admission limits.
		# Caddy's own copy of the secret: 0640 root:caddy, >= 43 base64url characters, the same
		# bytes as the UI's 0400 debateai-ui copy at /etc/debateai/ui-edge.secret, which the UI
		# refuses to share with any group (README §3 "The key-file contract").
		header_up X-Debateai-Edge-Secret {file./etc/debateai/ui-edge.caddy.secret}
	}
}

{$DEBATEAI_PUBLIC_HOSTNAME} {
	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# The API's own Fastify bodyLimit (B5) is the authority; this is the edge floor in front of it,
	# so an oversized body is dropped before it reaches Node at all.
	request_body {
		max_size 1MB
	}

	# BREACH class: never compress a response that carries a session cookie, a CSRF token or a
	# one-shot verification token. /api/* is the whole authenticated surface (the UI proxies to
	# the API under that prefix), so it is excluded and static assets keep compression.
	@compressible not path /api/*
	encode @compressible gzip

	# The payment marks (README §14.7). The brands' artwork may not be redistributed, so it is never in the repository
	# or a release folder: root keeps the official files in /etc/debateai/payment-marks/, and Caddy serves exactly these
	# three names from there before any request reaches the website. Caddy orders handle before respond and
	# reverse_proxy, and file_server ends the request, so a mark never reaches the website; a missing file is Caddy's
	# own 404. Any other path under /payment-marks/ is not matched and goes on to the website as before.
	@paymentMarks path /payment-marks/netopia.svg /payment-marks/visa.svg /payment-marks/mastercard.svg
	handle @paymentMarks {
		root * /etc/debateai/payment-marks
		uri strip_prefix /payment-marks
		header Content-Type image/svg+xml
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header X-Content-Type-Options nosniff
		file_server
	}

	# Readiness is never read through the public name (final fix wave W2): visitors never read a slot's readiness.
	# Caddy orders respond before reverse_proxy: /readyz gets Caddy's own 404 here; the health checks ask the slots
	# directly, root asks :3090.
	respond /readyz 404

	import debateai_slots
}

# The same front on loopback only, for root's switch checks (side-by-side plan D: the edge http://127.0.0.1:3090):
# "does Caddy send traffic to the new pair yet" is asked here, through the same health-checked proxy, without leaving
# the box. A site with no host name gets no certificate and serves plain HTTP; `bind` keeps it off every public
# address. A local process reaching it is seen as 127.0.0.1, exactly as when it opens a website port directly: the
# X-Forwarded-For Caddy sends is the peer it observed, so no client address can be forged through it.
:3090 {
	bind 127.0.0.1
	request_body {
		max_size 1MB
	}
	import debateai_slots
}
