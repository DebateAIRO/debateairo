# deploy/vps/systemd/debateai-api@.service
# One API instance per release (side-by-side spec §10): debateai-api@<label>.service, %i = the release label
# (dashes kept). Each release runs from its own root-owned folder /opt/debateai/releases/<label>/, never from the
# operator checkout, so updating code can never change it under a live older runner. Only the current release's
# instance is enabled at boot (README §5 "Side-by-side upgrades"); the slot (port 491 or 492) comes from the release's overlay.
#
# One OS user per service (audit L7 "C2/C3 validation"): the UI must not be able to read
# /etc/debateai/api.env, and the runner must not be able to read the blind-index key, the audit
# key store or the audit source-IP salt. See README "Custody and the three service users" for the
# one place where that separation is currently blocked (the shared user-DEK store).
[Unit]
Description=DebateAI API (Fastify), release %i
Documentation=file:///opt/debateai/dialectical-engine/deploy/vps/README.md
After=network-online.target postgresql.service debateai-hatchet.service
# Hatchet is wanted, never required (side-by-side spec §4): a Hatchet restart must not stop a release's API.
Wants=network-online.target debateai-hatchet.service
Requires=postgresql.service
# A start the release tool refuses (a draining or retired release) fails in ExecStartPre=, and Restart=on-failure
# would retry it every 5 s for ever. RestartPreventExitStatus= cannot stop that (systemd reads it from the main
# process only, never from ExecStartPre=), so the start limit does: 20 tries in 10 minutes (about 100 s of retries,
# enough for a PostgreSQL restart or a boot-order race), then the instance stays failed and shows in
# `systemctl --failed` until it is started again by hand (README §5 "The current release").
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=debateai-api
Group=debateai-api
# Postfix's sendmail is setgid postdrop; NoNewPrivileges=true neuters setgid, so the maildrop
# write has to be reachable by group membership instead (README §7, MAIL_SENDMAIL_PATH).
# V-19: the custody group, for the same reason — see debateai-runner@.service.
SupplementaryGroups=postdrop debateai-custody
WorkingDirectory=/opt/debateai/releases/%i/dialectical-engine
# The base file every release shares, then the release's own overlay (env/releases/api.env.example: site version,
# release key, the slot's port). systemd reads them in this order and the later file wins. The overlay has no "-":
# a release without its own file does not start.
EnvironmentFile=/etc/debateai/api.env
EnvironmentFile=/etc/debateai/releases/%i/api.env
# NV-52: the base file is root's (README §3), and these dynamic-loader, libc and Node start-up variables reach no
# process of this unit, root's `+` hooks included. ld.so and libc act on them for /usr/bin/env itself, before `env -i`
# runs.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG_OUTPUT LD_PROFILE LD_PROFILE_OUTPUT LD_TRACE_LOADED_OBJECTS GLIBC_TUNABLES GCONV_PATH LOCPATH NODE_OPTIONS NODE_PATH
Environment=NODE_ENV=production
Environment=NODE_EXTRA_CA_CERTS=/etc/debateai/hatchet-tls/ca.crt
# Root's start check (`+` = root, outside this unit's sandbox; side-by-side plan D16b): a release that is draining or
# retired, or one the release table does not know, is refused before the API starts again. Root's node runs through
# `env -i` with PATH only, so nothing this unit's environment sets reaches node (same in every root hook). `+` drops
# the sandbox but not that environment, and ld.so and libc read some variables for /usr/bin/env itself before `env -i`
# acts: those are unset above, and the base env file is root's (README §3, NV-52).
ExecStartPre=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /usr/bin/node /opt/debateai/dialectical-engine/deploy/vps/release.mjs may-start --service api --label %i
ExecStart=/usr/bin/pnpm --dir /opt/debateai/releases/%i/dialectical-engine exec tsx apps/api/src/main.ts
# After every stop root writes down what it saw (side-by-side spec §4): a draining release whose API is gone gets
# FRONT_PAIR_STOPPED once, which is what that release's retirement waits for.
ExecStopPost=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /usr/bin/node /opt/debateai/dialectical-engine/deploy/vps/release.mjs stopped --service api --label %i
# Restart=on-failure stays on this server (spec §4): a restarted API starts on its own release ("database ahead").
Restart=on-failure
# Straight back to starting, without passing through inactive or failed: otherwise the website's BindsTo= on this
# instance would stop the website at every crash restart, and nothing would start it again. Needs systemd >= 254
# (README §2); an older systemd ignores the line with a warning.
RestartMode=direct
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

# --- filesystem ---
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
# The custody trees the API creates directories in at runtime (L2 out-of-scope: the DEK
# store and the publication key store are written by @debateai/crypto). Everything else on the
# box — including /opt and /etc/debateai — stays read-only under ProtectSystem=strict.
# The billing notice spool (README §14.5) is optional: its leading "-" lets the unit start while the folder does not exist.
# The restore fence folder (NV-07) is the API's own and is never in a backup; '-' keeps older releases of this shared
# template starting where it does not exist yet, and the API itself refuses without it in hosted mode.
ReadWritePaths=/var/lib/debateai/api/user-deks /var/lib/debateai/api/publication-keys /var/lib/debateai/api/audit-keys -/var/lib/debateai/api/restore-fence /var/lib/debateai/data-exports -/var/lib/debateai/api/billing-notice-spool

# --- process and kernel ---
NoNewPrivileges=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# NV-55: the slot ports are below 1024, so this unit holds exactly CAP_NET_BIND_SERVICE (ambient, under
# NoNewPrivileges) to bind its slot's port, and SocketBindAllow=/SocketBindDeny= below limit that grant to the two
# API ports. systemd enforces that limit only through its BPF framework (README §2 checks it on the host).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
# Unix socket for PostgreSQL, INET/INET6 for the reserved loopback listener and Hatchet gRPC.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# NV-55: the capability above binds only the two API ports; every other port below 1024 is refused.
SocketBindAllow=tcp:491-492
SocketBindDeny=tcp:1-1023
SocketBindDeny=udp:1-1023
# MemoryDenyWriteExecute is NOT set: it breaks the V8 JIT.

LimitNOFILE=65536
# Two releases run at once during a drain (side-by-side spec §4), so each instance has its own memory ceiling: the
# preview's value for this service (deploy/preview-lifecycle/v1/systemd/debateai-preview-api@.service.d/50-lifecycle.conf).
MemoryMax=2G

[Install]
WantedBy=multi-user.target
