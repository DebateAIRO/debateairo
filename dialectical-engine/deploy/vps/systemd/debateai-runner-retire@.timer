# deploy/vps/systemd/debateai-runner-retire@.timer -> /etc/systemd/system/ (root 0644)
# The backstop for one older release (side-by-side spec §4; %i = the release label): 7.5 hours after the switch
# (27,000 s) it asks that release's runner to retire now. This template names NO time: the switch writes
#   debateai-runner-retire@<label>.timer.d/50-at.conf
# with one absolute UTC OnCalendar= and then enables and starts debateai-runner-retire@<label>.timer.
# Without that drop-in systemd refuses to load an instance (a timer needs a time): nothing fires by accident.
# Persistent=true: a server that was off at that time asks at the next boot (the [Install] below keeps the enabled
# instance in timers.target across reboots). A rollback, or the release's own retirement, disables the instance.
[Unit]
Description=DebateAI backstop for release %i (asks it to retire 7.5 hours after the switch)
Documentation=file:///opt/debateai/dialectical-engine/deploy/vps/README.md

[Timer]
Unit=debateai-runner-retire@%i.service
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
