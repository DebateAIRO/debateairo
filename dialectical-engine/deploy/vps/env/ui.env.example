# deploy/vps/env/ui.env.example -> /etc/debateai/ui.env (0600 debateai-ui:debateai-ui)
# The shared base EnvironmentFile of every debateai-ui@<label>.service. The UI holds NO key material
# and NO database credential: it proxies to the API over loopback. Everything security-relevant it
# needs — the trusted-proxy list, the edge-secret path, the host — is set in the unit itself, so this
# file stays free of anything a leak would matter for. Each release's overlay,
# /etc/debateai/releases/<label>/ui.env (env/releases/ui.env.example), is read after it and sets the
# slot's PORT and replaces DIALECTICAL_API_BASE with its own API (side-by-side spec §6, §10).

NODE_ENV=production

# Server-side base for the Next proxy routes (apps/ui/lib/serverApi).
DIALECTICAL_API_BASE=http://127.0.0.1:8790
# Browser-side base. Same-origin path, so nothing internal is exposed to the client bundle.
NEXT_PUBLIC_API_BASE=/api
NEXT_TELEMETRY_DISABLED=1

# Public managed widget site key from the provisioning receipt, never the private secret.
TURNSTILE_SITE_KEY=<public-site-key-for-this-exact-hostname>

# The payment marks the website's footer shows (NETOPIA's always first, whatever the order here). Set this only once
# each named file is in /etc/debateai/payment-marks/ and Caddy serves it (README §14.7): a name without its file
# shows a broken image. Commented out until then.
# PAYMENT_MARKS_AVAILABLE=netopia,visa,mastercard
