# deploy/vps/env/ui.env.example -> /etc/debateai/ui.env (0600 debateai-ui:debateai-ui)
# EnvironmentFile for debateai-ui.service. The UI holds NO key material and NO database
# credential: it proxies to the API over loopback. Everything security-relevant it needs — the
# trusted-proxy list, the edge-secret path, host and port — is set in the unit itself, so this
# file stays free of anything a leak would matter for.

NODE_ENV=production

# Server-side base for the Next proxy routes (apps/ui/lib/serverApi).
DIALECTICAL_API_BASE=http://127.0.0.1:8790
# Browser-side base. Same-origin path, so nothing internal is exposed to the client bundle.
NEXT_PUBLIC_API_BASE=/api
NEXT_TELEMETRY_DISABLED=1
