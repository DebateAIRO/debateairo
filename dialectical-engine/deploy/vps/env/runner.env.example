# deploy/vps/env/runner.env.example -> /etc/debateai/runner.env (0600 debateai-runner:debateai-runner)
# EnvironmentFile for debateai-runner.service. Shape is parseRunnerEnvironment (.strict()).
# The runner gets ONE database principal and no identity key material at all: no blind-index key,
# no audit key store, no audit source-IP salt.

NODE_ENV=production
# V-9(c): which of the two supported deployments this is. `hosted` is the commercial site: the
# runner accepts `https:` vendor APIs only and REFUSES a loopback/relay target or a credential
# written inline into PROVIDER_DISCOVERY_TARGETS_JSON. A production unit that omits this key
# refuses to start with DEPLOYMENT_MODE_UNRESOLVED rather than guessing.
DEBATEAI_DEPLOYMENT_MODE=hosted
RUNNER_WORKER_ID=<runner-worker-id>
REGISTER_VERSION=<register-version>

DATABASE_URL=postgresql://debateai_prod_runner_runtime:<runner-runtime-password>@localhost/debateai?host=/var/run/postgresql

# --- key custody --------------------------------------------------------------------------
# The runner's OWN 0600 copy of the same 32 KEK bytes, owned by debateai-runner. A per-user copy
# is still the right shape for a file nobody shares: it is one inode per principal, so neither
# service can replace the other's.
KEK_PATH=/etc/debateai/runner/kek.bin
CONTENT_ENCRYPTION_ENABLED=true
# V-19: the user-DEK store below is written by debateai-api and only READ here, so a copy would
# go stale within a request. The custody group is how this principal reads it: 0640 records with
# group debateai-custody inside a 0750 directory with the same group. The runner is in the group
# and owns nothing in the tree, and the unit's ReadOnlyPaths keeps it that way.
DEBATEAI_CUSTODY_GROUP=debateai-custody
USER_DEK_STORE_PATH=/var/lib/debateai/api/user-deks

# --- Hatchet ------------------------------------------------------------------------------
HATCHET_CLIENT_TOKEN=<hatchet-client-token>
HATCHET_HOST_PORT=127.0.0.1:7077
HATCHET_API_URL=https://127.0.0.1:8888
HATCHET_TENANT_ID=<hatchet-tenant-uuid>
HATCHET_WORKFLOW_NAME=debateai-prod
HATCHET_TLS_STRATEGY=tls
HATCHET_ENGINE_RETRIES=3
HATCHET_WORKER_NAME=debateai-prod-runner

# --- providers ----------------------------------------------------------------------------
# V-20: VLLM_BASE_URL / VLLM_MODEL / VLLM_MAKER are OPTIONAL and are deliberately absent here.
# Despite their name they describe the PRIMARY provider, and there is no self-hosted inference
# server on this host. With them absent, PROVIDER_DISCOVERY_TARGETS_JSON is the single source of
# the provider set and the RUNNER_PRIMARY_PROVIDER_CONFIGURATION_DRIFT cross-check is skipped;
# PROVIDER_REF must still name the FIRST entry of that set (RUNNER_PRIMARY_PROVIDER_REF_DRIFT).
#
# V-9(2): each vendor's credential is a FILE under /etc/debateai/runner/providers, never a value
# in this file — nothing here reaches /proc/<pid>/environ or a process listing. A target entry is
#   {"provider_ref":"…","base_url":"https://…/v1","model":"…","authorization_file":"/etc/…"}
# with an absolute authorization_file; an inline authorization_header is REFUSED in hosted mode.
# Every provider_ref must also appear in the register's configuredProviderSet row. README §11
# holds the "add a vendor" procedure, vetting step included.
PROVIDER_REF=<provider-ref>
PROVIDER_DISCOVERY_TARGETS_JSON=<provider-discovery-targets-json>

# --- battery and contracts ----------------------------------------------------------------
CLAIM_MS=60000
CLAIM_MARGIN_MS=5000
JUDGE_MAX_ATTEMPTS=3
JUDGE_TOKEN_CEILING=4096
JUDGE_DEADLINE_MS=120000
COMPOSER_MAX_ATTEMPTS=3
COMPOSER_TOKEN_CEILING=4096
COMPOSER_DEADLINE_MS=120000
CONFORMANCE_MAX_ATTEMPTS=3
CONFORMANCE_TOKEN_CEILING=4096
CONFORMANCE_DEADLINE_MS=120000
JUDGE_CONTRACT_HASH=<judge-contract-hash>
COMPOSER_CONTRACT_HASH=<composer-contract-hash>
CONFORMANCE_CONTRACT_HASH=<conformance-contract-hash>
PROPAGATION_CONTRACT_HASH=<propagation-contract-hash>
SERVE_CONTRACT_HASH=<serve-contract-hash>
MAX_RECOMPOSE=2
FACT_BUNDLE_VERSION=1
JUDGEMENT_NUMBER_KIND=<judgement-number-kind>
JUDGEMENT_PRODUCER=<judgement-producer>
PROPAGATION_NUMBER_KIND=<propagation-number-kind>
PROPAGATION_PRODUCER=<propagation-producer>
