# deploy/vps/env/releases/runner.env.example -> /etc/debateai/releases/<label>/runner.env (0640 root:debateai-runner)
# The release's own overlay for debateai-runner@<label>.service (side-by-side spec §10). The unit reads the shared
# base file /etc/debateai/runner.env first and this file second; systemd lets the later file win. Only what must
# differ per release, nothing secret. Root writes it once, before the release first starts, and never edits it while
# that release runs (README §5 "Side-by-side upgrades").
# Replace every <placeholder>.

# The site version this release runs; the same number as in RELEASE_KEY.
REGISTER_VERSION=<register-version>
# r<REGISTER_VERSION>-<the first 12 hex of the release's commit>.
RELEASE_KEY=<release-key>
# Two runners run side by side during a drain, so each needs its own worker identity (INTERFACE): the base file's
# names followed by the release key.
RUNNER_WORKER_ID=debateai-prod-runner-<release-key>
HATCHET_WORKER_NAME=debateai-prod-runner-<release-key>
