# deploy/vps/env/releases/api.env.example -> /etc/debateai/releases/<label>/api.env (0640 root:debateai-api)
# The release's own overlay for debateai-api@<label>.service (side-by-side spec §10). The unit reads the shared base
# file /etc/debateai/api.env first and this file second; systemd lets the later file win, so these lines replace the
# base file's values for this release only. It holds only what must differ per release, and nothing secret: every
# credential and path stays in the base file, shared by both releases. Root writes it once, before the release
# first starts, and never edits it while that release runs (README §5 "Side-by-side upgrades").
# Replace every <placeholder>.

# The site version this release runs; the same number as in RELEASE_KEY.
REGISTER_VERSION=<register-version>
# r<REGISTER_VERSION>-<the first 12 hex of the release's commit>: what the release table and every debate record.
RELEASE_KEY=<release-key>
# The slot's API port: slot A below.
# slot B: API_PORT=8791
API_PORT=8790
