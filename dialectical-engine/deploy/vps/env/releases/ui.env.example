# deploy/vps/env/releases/ui.env.example -> /etc/debateai/releases/<label>/ui.env (0640 root:debateai-ui)
# The release's own overlay for debateai-ui@<label>.service (side-by-side spec §6, §10). The unit reads the shared
# base file /etc/debateai/ui.env first and this file second; systemd lets the later file win. The slot's port lives
# here, not in the unit, and the website talks only to its own release's API. Nothing secret. Root writes it once,
# before the release first starts, and never edits it while that release runs (README §5 "Side-by-side upgrades").
# Replace every <placeholder>.

# r<REGISTER_VERSION>-<the first 12 hex of the release's commit>: the same key as the release's API.
RELEASE_KEY=<release-key>
# The slot's website port, one of the Caddyfile's two upstreams: slot A below.
# slot B: PORT=3002
PORT=3001
# The same slot's API (its API_PORT).
# slot B: DIALECTICAL_API_BASE=http://127.0.0.1:8791
DIALECTICAL_API_BASE=http://127.0.0.1:8790
