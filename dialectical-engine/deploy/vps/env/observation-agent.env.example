# deploy/vps/env/observation-agent.env.example -> /etc/debateai/observation-agent.env
#   (0600 debateai-observer:debateai-observer)
# EnvironmentFile for debateai-observation-agent.service. Shape is loadObservationAgentEnvironment
# in packages/register/src/runtime-environment.ts: it reads ONLY the OBSERVATION_* keys, strictly —
# a fifth OBSERVATION_ key or a relative path refuses at boot. NODE_ENV comes from the unit.
#
# NOT ENABLED ON THIS HOST YET. The agent has only ever run on macOS under launchd; README §12
# lists what a Linux host still lacks (a production targets catalog above all). This file exists so
# the unit's inputs are defined and pinned to the shape
# (tests/architecture/vps-env-examples-match-shapes.test.ts) before anyone switches it on.

# The agent's own principal, minted by migration 0057 (not by `pnpm db:provision-principals`).
# Over the unix socket, like every other service URL in this kit. Its database access is its own
# schema plus a narrow statistics window (V-29); it is never granted pg_monitor or
# pg_read_all_stats by anything in deploy/.
OBSERVATION_DATABASE_URL=postgresql://debateai_observation_agent:<observation-agent-password>@localhost/debateai?host=/var/run/postgresql

# Journal, heartbeat, threshold cache and status snapshot. The unit's StateDirectory creates it
# 0700 for debateai-observer; it is the unit's only writable path.
OBSERVATION_STATE_DIR=/var/lib/debateai-observation-agent

# A DIRECTORY of target fragments, one per module (OBS-01.json ... OBS-07.json). None ships for
# this host: the fragments under deploy/observation-agent/targets.dev.d name development ports and
# container names that do not exist here. Absolute path, read-only for the agent.
OBSERVATION_TARGETS_PATH=/etc/debateai/observation-agent/targets.d

# Optional. The Hatchet tenant token the throughput and stall probes present to Hatchet's REST
# API on loopback. Read through the agent's custody loader: 0600 file owned by debateai-observer
# in a 0700 directory owned by the same user. Leave the line out and those two probes report
# their Hatchet readings as unavailable; the agent itself keeps running.
OBSERVATION_HATCHET_TOKEN_PATH=/etc/debateai/observation-agent/hatchet-token
