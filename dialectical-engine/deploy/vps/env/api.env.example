# deploy/vps/env/api.env.example -> /etc/debateai/api.env (0600 debateai-api:debateai-api)
# EnvironmentFile for debateai-api.service. systemd reads it as root and hands the values to the
# service; the file itself is owned by the API user so the UI and runner users cannot read it.
# Replace every <placeholder>. Nothing here is a secret you may commit.
#
# Shape is packages/register/src/runtime-environment.ts (apiEnvironmentShape, .strict()): an
# unknown key or a missing required key refuses at boot.

NODE_ENV=production
# V-9(c): which of the two supported deployments this is. `hosted` is the commercial site: the
# API accepts `https:` vendor APIs only and REFUSES a loopback/relay target or a credential
# written inline into PROVIDER_DISCOVERY_TARGETS_JSON. A production unit that omits this key
# refuses to start with DEPLOYMENT_MODE_UNRESOLVED rather than guessing. Same value as runner.env.
DEBATEAI_DEPLOYMENT_MODE=hosted

# --- listener -----------------------------------------------------------------------------
# Loopback only; the Next front door proxies to it and Caddy is the only public listener.
# assertProductionFloors throws API_HOST_MUST_BE_LOOPBACK for anything else.
API_HOST=127.0.0.1
API_PORT=8790
PUBLIC_APP_URL=https://<your-public-hostname>

# --- database principals (P3-01) ----------------------------------------------------------
# One principal per purpose; the register refuses two purposes sharing a URL
# (ERASURE_DATABASE_URL_MUST_BE_SEPARATE and friends). All five go over the unix socket, which
# is why assertProductionFloors exempts them from sslmode=verify-full: the bytes never leave the
# host. Any off-box URL would have to carry sslmode=verify-full AND sslrootcert=.
# MIGRATION_DATABASE_URL is deliberately NOT here: that credential is the just-in-time superuser
# and the manifest invariant NO_LONG_LIVED_SUPERUSER_CREDENTIAL forbids parking it in a file.
DATABASE_URL=postgresql://debateai_prod_api_runtime:<api-runtime-password>@localhost/debateai?host=/var/run/postgresql
CONTENT_PROVISION_DATABASE_URL=postgresql://debateai_prod_api_content_provision:<content-provision-password>@localhost/debateai?host=/var/run/postgresql
# The support data plane (P3-01 `api-support`), and the ONLY database the KEK
# rotation opens. Its role is the only one granted UPDATE on the two support key
# columns, which is why the rotation asserts this principal and nothing else.
SUPPORT_DATABASE_URL=postgresql://debateai_prod_api_support:<support-password>@localhost/debateai?host=/var/run/postgresql
AUTHORIZATION_DATABASE_URL=postgresql://debateai_prod_api_authorization:<authorization-password>@localhost/debateai?host=/var/run/postgresql
PUBLICATION_CLEANUP_DATABASE_URL=postgresql://debateai_prod_api_publication_cleanup:<publication-cleanup-password>@localhost/debateai?host=/var/run/postgresql
ERASURE_DATABASE_URL=postgresql://debateai_prod_api_erasure:<erasure-password>@localhost/debateai?host=/var/run/postgresql

# --- key custody --------------------------------------------------------------------------
# Every *_PATH below is a raw 32-byte file, 0600, owned by debateai-api, inside a 0700 directory.
# See README "The key-file contract". The two *_STORE_PATH entries are directories the API
# creates subdirectories in, which is why they are the API unit's ReadWritePaths.
#
# V-19: the custody group. The API owns everything below and would boot without this line; it
# is set here so the store it WRITES stays readable by the runner, which owns none of it.
# @debateai/crypto then also accepts a 0640 record whose group is this one inside a 0750
# directory whose group is this one. Nothing else relaxes, and an unresolvable group refuses
# at boot with CUSTODY_GROUP_UNRESOLVED. A decimal gid is accepted in place of the name.
DEBATEAI_CUSTODY_GROUP=debateai-custody
KEK_PATH=/etc/debateai/api/kek.bin
# The support chat's own master key, wrapping the session and case keys that live
# in Postgres. Its file name must be exactly support-kek.bin — the loader refuses
# any other — and it must be a different 32 bytes from every key above and below
# it (SUPPORT_KEK_PATH_MUST_BE_SEPARATE). Single-owner custody: 0600 owned by
# debateai-api, in a 0700 directory. The runner has no copy and no shape for one.
SUPPORT_KEK_PATH=/etc/debateai/api/support-kek.bin
BLIND_INDEX_KEY_PATH=/etc/debateai/api/blind-index-key.bin
AUDIT_SOURCE_IP_SALT_PATH=/etc/debateai/api/audit-source-ip-salt.bin
CORPUS_KEK_PATH=/etc/debateai/api/corpus-kek.bin
USER_DEK_STORE_PATH=/var/lib/debateai/api/user-deks
AUDIT_KEY_STORE_PATH=/var/lib/debateai/api/audit-keys
PUBLICATION_KEY_STORE_PATH=/var/lib/debateai/api/publication-keys

# assertProductionFloors throws CONTENT_ENCRYPTION_REQUIRED_IN_PRODUCTION for anything but true.
CONTENT_ENCRYPTION_ENABLED=true
PUBLICATION_ENABLED=true

# --- mail ---------------------------------------------------------------------------------
# Send-only postfix; MAIL_FROM must match /^noreply@/ (mail-channel.ts). See README §7 for the
# SPF/DKIM/DMARC records without which verification mail bounces.
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail
MAIL_FROM=noreply@<your-public-hostname>

# --- Hatchet ------------------------------------------------------------------------------
# TLS to the loopback-published container; the CA comes from NODE_EXTRA_CA_CERTS in the unit.
# The client token is tenant-wide (Hatchet has no scopes) — same custody class as a DB password.
HATCHET_CLIENT_TOKEN=<hatchet-client-token>
HATCHET_HOST_PORT=127.0.0.1:7077
HATCHET_API_URL=https://127.0.0.1:8888
HATCHET_TENANT_ID=<hatchet-tenant-uuid>
HATCHET_WORKFLOW_NAME=debateai-prod
HATCHET_TLS_STRATEGY=tls

# --- policy and register ------------------------------------------------------------------
# Sealed literal the register pins; the API refuses any other value.
ACCOUNT_ERASURE_GRACE_MS=604800000
STRANGER_SAMPLE_RATE=0.1
REGISTER_VERSION=<register-version>
BATTERY_VERSION=<battery-version>
SETTLEMENT_WATCH_HANDLE=<settlement-watch-handle>
# V-9(2): each target's credential is a FILE, never a value in this file. The API reads its OWN
# 0600 copy under /etc/debateai/api/providers — the runner has its own, exactly as with the KEK.
# An inline authorization_header is REFUSED in hosted mode. V-28: in hosted mode every entry also
# carries its vendor's price, input_price_micros_per_million and output_price_micros_per_million
# (whole USD micro-units per million tokens, both or neither, never zero), or the API refuses at
# boot with PROVIDER_TARGET_PRICE_REQUIRED / PROVIDER_TARGET_PRICE_ZERO. Same entries, in the same
# order, as runner.env — only authorization_file differs. README §11 has the procedure.
PROVIDER_DISCOVERY_TARGETS_JSON=<provider-discovery-targets-json>
PROVIDER_PROBE_TIMEOUT_MS=5000

# --- support chat (V-30) ------------------------------------------------------------------
# The support chat's own ONE-entry model target: provider_ref, base_url (https:, path ending in
# /v1), model and authorization_file — the API's own copy of that vendor's key file. No price
# members: the support chat keeps its own spend accounting (support.message.cost_usd) and is
# bounded by its daily call cap, not by the cost envelopes (README §11). Optional in the shape,
# but without it the chat has no model and every answer is DEGRADED. Its provider_ref must equal
# the support model ref published in the support configuration row (README §13).
SUPPORT_MODEL_TARGET_JSON=<support-model-target-json>
