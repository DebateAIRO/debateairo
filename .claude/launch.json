{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd dialectical-engine/apps/ui && NEXT_DIST_DIR=.next-dev pnpm dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-stack",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd dialectical-engine && pnpm run dev:auth:up"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    },
    {
      "name": "consent-lane-ui",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "cd dialectical-engine/.worktrees/consent-s02/dialectical-engine/apps/ui && DIALECTICAL_UI_HOST=127.0.0.1 PORT=4000 DIALECTICAL_API_BASE=http://127.0.0.1:8790 NEXT_PUBLIC_API_BASE=/api exec node server.mjs --dev"
      ],
      "port": 4000,
      "url": "http://localhost:4000"
    },
    {
      "name": "consent-lane-full-stack",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "cd dialectical-engine/.worktrees/consent-s02/dialectical-engine && exec pnpm dev:auth:up"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    },
    {
      "name": "tiers-s01-open",
      "url": "https://localhost:3000"
    }
  ]
}
