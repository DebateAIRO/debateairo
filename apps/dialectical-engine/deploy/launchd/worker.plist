<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__SERVICE_LABEL__</string>
  <key>WorkingDirectory</key>
  <string>__ROOT__/worker</string>
  <!-- Registration credential: do NOT put DIALECTICAL_USER_TOKEN here (this
       template is committed, and the watchdog reverts live-plist edits).
       For unattended KeepAlive recovery the worker reads the token from the
       macOS Keychain when config.toml has no identity:
         security add-generic-password -s dialectical-worker -a user-token -w
       See docs/worker-identity-durability.md. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>DYLD_LIBRARY_PATH</key>
    <string>__PYTHON_DYLD_LIBRARY_PATH__</string>
    <key>DIALECTICAL_WORKER_CONFIG</key>
    <string>__WORKER_CONFIG__</string>
__ADAPTER_API_ENV__
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>app.main</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>MaterializeDatalessFiles</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/__LOG_BASENAME__.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/__LOG_BASENAME__.err.log</string>
</dict>
</plist>
