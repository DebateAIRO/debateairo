<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dialectical.coordinator</string>
  <key>WorkingDirectory</key>
  <string>__ROOT__/coordinator</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>DYLD_LIBRARY_PATH</key>
    <string>__PYTHON_DYLD_LIBRARY_PATH__</string>
    <!-- Flip plan 2026-07 stages 1+2 (docs/flip-plan-2026-07.md). Rollback: delete + make install-services. -->
    <key>DIALECTICAL_EVIDENCE_ACQUISITION</key>
    <string>1</string>
    <key>DIALECTICAL_EVIDENCE_VERIFICATION</key>
    <string>1</string>
    <!-- Flip plan stage 3 (judge panel + score blending). RE-ENABLED 2026-07-24
         after F1 (no freeze) + T22 A/B delivery fixes (fa1a2ea): fenced-JSON
         parse (claude/gemini panel output now parses), size-aware scoring
         deadline, resume-from-cache retries, and panel scoring deferred off the
         generation write-window so an aggregated node_scoring run reliably
         persists. See flip-plan-2026-07.md. Rollback: delete these 4 lines + make install-services. -->
    <key>DIALECTICAL_JUDGE_PANEL_MODELS</key>
    <string>claude-sonnet-5-high-loop,gemini-3.5-flash-loop</string>
    <key>DIALECTICAL_CALIBRATION_WEIGHTS</key>
    <string>1</string>
    <!-- Flip plan stage 5 (adversarial POV + cross-exam), operator-requested 2026-07-24. Proven safe (worker-side, timeouts). -->
    <key>DIALECTICAL_ADVERSARIAL_POV</key>
    <string>1</string>
    <key>DIALECTICAL_CROSS_EXAM</key>
    <string>1</string>

    <!-- ==================================================================
         Flip plan stage 7 — P1 contested frontier
         (docs/superpowers/plans/2026-07-24-p1-contested-frontier.md;
          preconditions/verification/rollback: docs/flip-plan-2026-07.md#7)

         ALL THREE ENABLED TOGETHER 2026-07-25, operator-requested, for a
         single end-to-end shakeout run rather than three staged verifications.

         The staged ordering below is retained as the record of what was
         overridden and why it is safe to override THIS way: the hazard the
         staging exists to prevent is expansion running WITHOUT bounded
         synthesis (a frontier that grows for hours, then fails at the final
         synthesis step). Enabling all three simultaneously does not create
         that hazard -- 7a is active whenever 7c is. What is given up is
         ATTRIBUTION: if the run misbehaves, the operator cannot tell which
         flag caused it from the flags alone, and 7a is exercised for the
         first time by a deep run rather than a short one.

         Mitigation, and the reason this is acceptable: run ONE normal-size
         debate first as a smoke check before starting a deep run, and read
         `expansion.census` / `GET /api/ops/expansion` to attribute behaviour
         to a stage. Rollback is per-block and independent -- re-comment any
         one of the three and `make install-services`.

         WHY THIS TEMPLATE IS THE ONLY PLACE TO SET THESE: editing the live
         `~/Library/LaunchAgents/com.dialectical.coordinator.plist` does NOT
         persist. `com.dialectical.watchdog` calls `make install-services` on
         its own whenever a launchd service check fails, regenerating the live
         plist from THIS file and discarding any hand edit. The corollary now
         that these keys are active: they reach the running coordinator on the
         watchdog's next repair even without an operator running anything.

         Rollback for any block: re-comment it (or delete the keys) and run
         `make install-services`. All three are additive and flag-off is
         byte-identical to the pre-flip path; nothing already persisted is
         rewritten or reinterpreted in either direction. Rolling back 7b does
         not un-mark nodes already scored as contested -- it stops NEW scoring
         runs from marking them.
         ================================================================== -->

    <!-- Stage 7a — bounded hierarchical synthesis payload. ENABLED 2026-07-25. -->
    <key>DIALECTICAL_HIERARCHICAL_SYNTHESIS</key>
    <string>1</string>

    <!-- Stage 7b — per-field cross-family disagreement detection. ENABLED
         2026-07-25. Moves score_provenance.disagreement_status for every newly
         scored node (measured on 78 real judge artifacts: 13 of 26 nodes become
         "present" at the 0.25 threshold, versus 0 under the superseded composite
         gate), which is what makes the frontier and the synthesis payload's
         contested section non-empty. -->
    <key>DIALECTICAL_FIELD_DISAGREEMENT</key>
    <string>1</string>

    <!-- Stage 7c — adaptive expansion. ENABLED 2026-07-25. This is the flag
         that makes the raised budgets (12 rounds / 3 per node / 150 per debate)
         actually spend. Watch for: stopped_because landing on `wall_clock` or
         `rounds_exhausted` rather than `converged` (convergence may structurally
         never fire if CON expansion dominates and keeps maxDelta above epsilon),
         and the spawned_pro/spawned_con ratio in `expansion.census`. -->
    <key>DIALECTICAL_ADAPTIVE_EXPANSION</key>
    <string>1</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8000</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>MaterializeDatalessFiles</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/dialectical-coordinator.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dialectical-coordinator.err.log</string>
</dict>
</plist>
