<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dialectical.coordinator</string>
  <key>WorkingDirectory</key>
  <string>__ROOT__/coordinator</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>DYLD_LIBRARY_PATH</key>
    <string>__PYTHON_DYLD_LIBRARY_PATH__</string>
    <!-- Flip plan 2026-07 stages 1+2 (docs/flip-plan-2026-07.md). Rollback: delete + make install-services. -->
    <key>DIALECTICAL_EVIDENCE_ACQUISITION</key>
    <string>1</string>
    <key>DIALECTICAL_EVIDENCE_VERIFICATION</key>
    <string>1</string>
    <!-- Flip plan stage 3 (judge panel + score blending) ROLLED BACK 2026-07-24:
         the panel holds a SQLite write transaction (begin_nested savepoint in
         _run_judge_panel) across the up-to-120s in-coordinator CLI judge call,
         starving all other writers -> "database is locked" 500s -> coordinator
         crash under load. Re-enable only after the savepoint-scope fix (move
         judge_node() outside begin_nested) lands. See flip-plan-2026-07.md. -->
    <!-- Flip plan stage 5 (adversarial POV + cross-exam), operator-requested 2026-07-24. Proven safe (worker-side, timeouts). -->
    <key>DIALECTICAL_ADVERSARIAL_POV</key>
    <string>1</string>
    <key>DIALECTICAL_CROSS_EXAM</key>
    <string>1</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8000</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>MaterializeDatalessFiles</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/dialectical-coordinator.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dialectical-coordinator.err.log</string>
</dict>
</plist>
