+}
+
+@media (max-width: 920px) {
+  .synthSheetTab {
+    position: fixed;
+    left: 18px;
+    bottom: var(--dock-offset-b);
+    z-index: var(--z-sheet);
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 6px;
+    width: min(164px, calc(100vw - var(--dock-collapsed-w) - 54px));
+    height: 44px;
+    padding: 0 10px;
+    border: 1px solid var(--line-strong);
+    border-radius: var(--r-btn);
+    background: var(--surface);
+    box-shadow: var(--shadow-pop);
+    color: var(--text-strong);
+    cursor: pointer;
+    font-family: var(--font-mono);
+    font-size: 11px;
+    font-weight: 700;
+    letter-spacing: 0.04em;
+    text-transform: uppercase;
+    white-space: nowrap;
+    overflow: hidden;
+  }
+  .synthSheetTabIcon {
+    color: oklch(0.52 0.04 75);
+  }
+  .synthSheetScrim {
+    position: fixed;
+    inset: 0;
+    z-index: var(--z-sheet);
+    display: block;
+    border: 0;
+    padding: 0;
+    background: oklch(0.18 0.01 70 / 0.42);
+    opacity: 0;
+    visibility: hidden;
+    pointer-events: none;
+    transition: opacity 0.2s ease, visibility 0.2s ease;
+  }
+  .synthSheetScrimOpen {
+    opacity: 1;
+    visibility: visible;
+    pointer-events: auto;
+  }
+  .synthPanel.synthSheet {
+    display: block;
+    position: fixed;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    z-index: calc(var(--z-sheet) + 1);
+    flex: none;
+    width: 100%;
+    max-height: 70dvh;
+    padding-bottom: var(--safe-b);
+    border-top: 1px solid var(--line-strong);
+    border-left: 0;
+    border-radius: var(--r-card) var(--r-card) 0 0;
+    box-shadow: 0 -18px 48px -24px oklch(0.18 0.02 70 / 0.55);
+    overflow: auto;
+    overscroll-behavior: contain;
+    transform: translateY(100%);
+    visibility: hidden;
+    pointer-events: none;
+    transition: transform 0.22s ease, visibility 0.22s ease;
+  }
+  .synthPanel.synthSheet.synthPanelOpen {
+    transform: translateY(0);
+    visibility: visible;
+    pointer-events: auto;
+  }
+  .synthSheetBar {
+    position: sticky;
+    top: 0;
+    z-index: 1;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    padding: 10px 14px;
+    border-bottom: 1px solid var(--line);
+    background: var(--surface-1);
+    color: var(--text-2);
+    font-family: var(--font-mono);
+    font-size: 10px;
+    font-weight: 700;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+  }
+  .synthSheetClose {
+    min-height: 32px;
+    padding: 4px 10px;
+    border: 1px solid var(--line);
+    border-radius: var(--r-btn);
+    background: var(--surface-2);
+    color: var(--text-2);
+    cursor: pointer;
+    font-family: var(--font-mono);
+  }
+  .synthPanel.synthSheet .synthInner {
+    padding: 14px 14px 24px;
+  }
