    Tree canvas
    ============================================================ */
 
+.canvasViewportShell {
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+  position: relative;
+  display: flex;
+}
+
 .canvas {
   flex: 1;
   min-width: 0;
   position: relative;
   overflow: auto;
+  overscroll-behavior: contain;
+  touch-action: none;
+  cursor: grab;
   background:
     radial-gradient(oklch(0.94 0.005 80) 1px, transparent 1px);
   background-size: 22px 22px;
 }
-.canvasInner {
+.canvas:active {
+  cursor: grabbing;
+}
+.canvasSizer {
   position: relative;
-  min-width: 100%;
-  min-height: 100%;
+  min-width: 1px;
+  min-height: 1px;
+  flex: none;
+}
+.canvasInner {
+  position: absolute;
+  top: 0;
+  left: 0;
+  transform-origin: 0 0;
+  will-change: transform;
+  transition: transform 0.18s ease-out;
 }
 .canvasLinks {
   position: absolute;
@@ -274,3 +297,85 @@
   border-radius: 50%;
   animation: de-pulse 1.6s ease-in-out infinite;
 }
+
+.canvasSetAsideToggle {
+  z-index: var(--z-canvas-sticky) !important;
+  user-select: none;
+}
+
+.canvasZoomCluster {
+  position: absolute;
+  right: 12px;
+  bottom: var(--zoom-cluster-offset-b);
+  z-index: var(--z-zoom-cluster);
+  width: var(--zoom-cluster-w);
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 4px;
+  padding: 4px;
+  border: 1px solid var(--line-2);
+  border-radius: 10px;
+  background: color-mix(in oklch, var(--surface) 94%, transparent);
+  box-shadow: var(--shadow-card);
+  backdrop-filter: blur(8px);
+}
+
+.canvasZoomButton {
+  min-width: 44px;
+  min-height: 44px;
+  padding: 4px;
+  border: 1px solid var(--line-2);
+  border-radius: 7px;
+  background: var(--surface);
+  color: var(--text-2);
+  font: 700 11px/1 var(--font-mono);
+  cursor: pointer;
+}
+.canvasZoomButton:hover {
+  border-color: var(--line-strong);
+  color: var(--text-strong);
+}
+.canvasZoomButton:focus-visible {
+  outline: 2px solid var(--focus);
+  outline-offset: 1px;
+}
+.canvasZoomPercent {
+  min-height: 28px;
+  display: grid;
+  place-items: center;
+  color: var(--text-3);
+  font: 700 10px/1 var(--font-mono);
+}
+
+.canvas[data-zoom-band="overview"] .nodeProse,
+.canvas[data-zoom-band="overview"] .nodeControls,
+.canvas[data-zoom-band="overview"] .nodeRootMeta,
+.canvas[data-zoom-band="overview"] .nodeHeader .metaLine,
+.canvas[data-zoom-band="overview"] .scoreBadgeButton {
+  visibility: hidden;
+  pointer-events: none;
+}
+.canvas[data-zoom-band="overview"] .nodeClaim {
+  opacity: 0.78;
+}
+
+@media (max-height: 520px) and (orientation: landscape) {
+  .canvasZoomCluster {
+    right: 12px;
+    width: auto;
+    max-width: calc(100% - 24px);
+    flex-direction: row;
+  }
+  .canvasZoomPercent {
+    min-width: 44px;
+    min-height: 44px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .canvasInner,
+  .nodeWrap {
+    transition: none;
+  }
+}
