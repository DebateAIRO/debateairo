:root {
  /* surfaces */
  --bg: oklch(0.985 0.004 85);
  --surface: oklch(0.995 0.002 85);
  --surface-1: oklch(0.992 0.003 85);
  --surface-2: oklch(0.99 0.003 85);
  --surface-sunken: oklch(0.975 0.004 80);
  --ink: oklch(0.27 0.012 70);
  --ink-hover: oklch(0.32 0.012 70);

  /* text */
  --text: oklch(0.27 0.012 70);
  --text-strong: oklch(0.24 0.012 70);
  --text-2: oklch(0.4 0.012 70);
  --text-3: oklch(0.5 0.01 70);
  --muted: oklch(0.55 0.01 70);
  --muted-2: oklch(0.6 0.01 70);

  /* lines */
  --line: oklch(0.91 0.006 80);
  --line-2: oklch(0.9 0.006 80);
  --line-strong: oklch(0.86 0.008 80);

  /* brand / accents */
  --accent: oklch(0.6 0.05 60);
  --link: oklch(0.45 0.05 255);
  --focus: oklch(0.6 0.04 70);

  /* pro (sage) */
  --pro-text: oklch(0.45 0.07 165);
  --pro-bg: oklch(0.978 0.016 165);
  --pro-border: oklch(0.85 0.045 165);
  --pro-line: oklch(0.66 0.07 172);

  /* con (clay) */
  --con-text: oklch(0.53 0.1 50);
  --con-bg: oklch(0.982 0.018 60);
  --con-border: oklch(0.87 0.05 55);
  --con-line: oklch(0.7 0.09 55);

  /* status */
  --ok-dot: oklch(0.58 0.1 165);
  --ok-text: oklch(0.42 0.07 165);
  --ok-bg: oklch(0.96 0.02 165);
  --ok-border: oklch(0.86 0.04 165);
  --gen-dot: oklch(0.66 0.12 75);
  --gen-text: oklch(0.5 0.08 65);
  --gen-bg: oklch(0.97 0.03 75);
  --gen-border: oklch(0.88 0.05 75);

  /* score bands */
  --score-strength-border: oklch(0.7 0.06 145);
  --score-strength-bg: oklch(0.96 0.025 145);
  --score-strength-text: oklch(0.224 0.08 145);
  --score-uncertainty-border: oklch(0.72 0.055 75);
  --score-uncertainty-bg: oklch(0.965 0.026 75);
  --score-uncertainty-text: oklch(0.238 0.075 75);
  --score-impact-border: oklch(0.68 0.065 245);
  --score-impact-bg: oklch(0.965 0.024 245);
  --score-impact-text: oklch(0.23 0.085 245);

  /* model dots */
  --m-claude: oklch(0.64 0.13 40);
  --m-gpt: oklch(0.52 0.07 200);
  --m-gemini: oklch(0.58 0.13 255);
  --m-grok: oklch(0.4 0.02 285);
  --m-qwen: oklch(0.56 0.13 320);
  --m-default: oklch(0.55 0.04 70);

  /* fonts */
  --font-serif: var(--font-serif), "Source Serif 4", Georgia, serif;
  --font-sans: var(--font-sans), "Hanken Grotesk", ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-mono), "JetBrains Mono", ui-monospace, "SFMono-Regular", monospace;

  /* radii + shadow */
  --r-card: 13px;
  --r-panel: 12px;
  --r-btn: 8px;
  --r-pill: 20px;
  --shadow-card: 0 4px 18px -8px oklch(0.3 0.02 70 / 0.25);
  --shadow-pop: 0 18px 44px -14px oklch(0.3 0.03 70 / 0.42);
  --shadow-drawer: -22px 0 54px -22px oklch(0.3 0.03 70 / 0.42);
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

::selection {
  background: oklch(0.88 0.07 75);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
  color: inherit;
}

/* custom scrollbars */
.scroll::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
.scroll::-webkit-scrollbar-thumb {
  background: oklch(0.88 0.006 80);
  border-radius: 6px;
  border: 3px solid var(--bg);
}
.scroll::-webkit-scrollbar-track {
  background: transparent;
}

/* ---- keyframes ---- */
@keyframes de-blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}
@keyframes de-shimmer {
  0% { background-position: -360px 0; }
  100% { background-position: 360px 0; }
}
@keyframes de-fadeup {
  0% { opacity: 0; transform: translateY(6px); }
  100% { opacity: 1; transform: none; }
}
@keyframes de-popin {
  0% { opacity: 0; transform: scale(0.95) translateY(5px); }
  100% { opacity: 1; transform: none; }
}
@keyframes de-slidein {
  0% { transform: translateX(28px); opacity: 0; }
  100% { transform: none; opacity: 1; }
}
@keyframes de-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.fadeup {
  animation: de-fadeup 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.skel {
  background: linear-gradient(
    90deg,
    oklch(0.93 0.005 80) 25%,
    oklch(0.965 0.004 80) 50%,
    oklch(0.93 0.005 80) 75%
  );
  background-size: 720px 100%;
  animation: de-shimmer 1.4s linear infinite;
}

import { Source_Serif_4, Hanken_Grotesk, JetBrains_Mono } from "next/font/google";
import { TopBar } from "@/components/TopBar";
import "./globals.css";

const serif = Source_Serif_4({
  subsets: ["latin"],
  weight: ["400", "500", "600"],
  style: ["normal", "italic"],
  variable: "--font-serif",
  display: "swap"
});

const sans = Hanken_Grotesk({
  subsets: ["latin"],
  weight: ["400", "500", "600", "700"],
  variable: "--font-sans",
  display: "swap"
});

const mono = JetBrains_Mono({
  subsets: ["latin"],
  weight: ["400", "500", "600"],
  variable: "--font-mono",
  display: "swap"
});

export const metadata = {
  title: "Dialectical Engine",
  description: "A reasoning instrument â€” several AI models argue a claim in a structured tree."
};

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en" className={`${serif.variable} ${sans.variable} ${mono.variable}`} suppressHydrationWarning>
      <body suppressHydrationWarning>
        <div className="appShell">
          <TopBar />
          {children}
        </div>
      </body>
    </html>
  );
}

