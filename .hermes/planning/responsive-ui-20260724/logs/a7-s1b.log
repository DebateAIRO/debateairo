/* ============================================================
   Debate view shell
   ============================================================ */

.debateView {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: 58px;
}

.debateTopBar {
  display: flex;
  align-items: center;
  gap: 18px;
  height: 60px;
  flex: 0 0 60px;
  min-width: 0;
  padding: 0 22px;
  border-bottom: 1px solid var(--line);
  background: var(--surface-2);
  z-index: 30;
}

.debateTopCenter {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  min-width: 0;
}

.debateTopClaim {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: center;
}

.debateTopTitle {
  font-family: var(--font-serif);
  font-size: 14.5px;
  font-weight: 600;
  color: var(--text-strong);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 520px;
}

.debateTopActions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 1 auto;
  min-width: 0;
}

.topSwitch {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex: 0 1 min(52vw, 680px);
  min-width: 0;
  max-width: min(52vw, 680px);
  min-height: 34px;
  padding: 0 8px;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0;
  white-space: nowrap;
}

.topSwitch > span:first-child,
.topSwitch .switch,
.topSwitch .btn,
.topSwitch .iconBtn {
  flex: 0 0 auto;
}

.topSwitchStatus {
  flex: 1 1 88px;
  min-width: 0;
  max-width: clamp(88px, 12vw, 180px);
  overflow: hidden;
  text-overflow: ellipsis;
  color: oklch(0.48 0.04 70);
  text-transform: none;
}
[data-scoring-state="loading"] .topSwitchStatus {
  color: var(--muted);
}
[data-scoring-state="error"] .topSwitchStatus {
  color: oklch(0.52 0.14 28);
}
[data-scoring-state="unavailable"] .topSwitchStatus {
  color: oklch(0.48 0.08 70);
}

.scoringInsightsPanel {
  flex: 0 0 auto;
  border-bottom: 1px solid oklch(0.91 0.02 75);
  background: oklch(0.97 0.01 75);
}

.scoringInsightsSummary {
  position: relative;
  min-height: 36px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 22px;
  cursor: pointer;
  list-style: none;
}

.scoringInsightsSummary::-webkit-details-marker {
  display: none;
}

.scoringInsightsSummary::after {
  content: "Open";
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--muted);
  text-transform: uppercase;
}

.scoringInsightsPanel[open] .scoringInsightsSummary::after {
  content: "Close";
}

.scoringInsightsPanelCompact .scoringInsightsSummary {
  cursor: default;
}

.scoringInsightsPanelCompact .scoringInsightsSummary::after {
  content: "";
}

.scoringInsightsDetail {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted);
  font-size: 12px;
}

.scoringInsightsBody {
  max-height: min(36vh, 360px);
  overflow: auto;
  border-top: 1px solid oklch(0.91 0.02 75);
  background: var(--surface);
}

.scoringInsightsBody .progressStrip,
.scoringInsightsBody .recommendationsPanel {
  border-bottom: 1px solid oklch(0.91 0.02 75);
}

.scoringInsightsBody > :last-child {
  border-bottom: 0;
}

/* progress strip */
.progressStrip {
  flex: 0 0 auto;
  height: 34px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 22px;
  background: oklch(0.97 0.01 75);
  border-bottom: 1px solid oklch(0.91 0.02 75);
}
.progressLabel {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: oklch(0.5 0.04 60);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.progressTrack {
  flex: 1;
  height: 4px;
  background: oklch(0.92 0.01 75);
  border-radius: 3px;
  overflow: hidden;
}
.progressFill {
  height: 100%;
  background: linear-gradient(90deg, oklch(0.62 0.09 165), oklch(0.66 0.1 75));
  border-radius: 3px;
  transition: width 0.4s ease;
}
.progressCount {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: oklch(0.5 0.04 60);
}

.scoringIssueStrip,
.adaptiveDepthStrip {
  align-items: flex-start;
  gap: 12px;
  min-height: 58px;
  height: auto;
  padding-top: 9px;
  padding-bottom: 10px;
}

.scoringIssueIntro {
  flex: 0 0 210px;
  min-width: 0;
}

.scoringIssueSubcopy {
  margin-top: 3px;
  color: var(--muted);
  font-family: var(--font-sans);
  font-size: 12px;
  line-height: 1.35;
}

.scoringIssuePills,
.adaptiveDepthChips {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.scoringIssuePill {
  max-width: min(100%, 420px);
  min-height: 24px;
  white-space: normal;
  overflow-wrap: anywhere;
}

.scoringIssuePill span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.adaptiveDepthActions {
  display: grid;
  gap: 5px;
  margin-left: auto;
  min-width: 210px;
  max-width: 280px;
}

.adaptiveDepthActionMessage {
  white-space: normal;
  line-height: 1.35;
}

.debateError {
  padding: 10px 22px 0;
}

.debateMain {
  flex: 1;
  min-height: 0;
  display: flex;
}


/* ============================================================
   Buttons, inputs, pills
   ============================================================ */

.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-sans);
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-2);
  background: var(--surface-2);
  border: 1px solid var(--line-2);
  border-radius: var(--r-btn);
  padding: 7px 12px;
  cursor: pointer;
  transition: background 0.18s, border-color 0.18s, color 0.18s;
}
.btn:hover {
  background: oklch(0.96 0.005 80);
}
.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btnDark {
  background: var(--ink);
  border-color: var(--ink);
  color: oklch(0.97 0.005 85);
}
.btnDark:hover {
  background: var(--ink-hover);
}

.btnGhost {
  background: transparent;
  border: none;
  color: var(--text-3);
  padding: 6px 8px;
}
.btnGhost:hover {
  background: oklch(0.95 0.005 80);
}

.btnChallenge {
  color: var(--con-text);
  background: oklch(0.97 0.03 60);
  border-color: oklch(0.88 0.05 55);
}
.btnChallenge:hover {
  background: oklch(0.95 0.04 60);
}

.iconBtn {
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line-2);
  background: var(--surface-2);
  border-radius: var(--r-btn);
  font-size: 15px;
  color: var(--text-3);
  cursor: pointer;
  transition: background 0.18s;
}
.iconBtn:hover {
  background: oklch(0.96 0.005 80);
}

.btn:focus-visible,
.iconBtn:focus-visible,
.input:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible,
a:focus-visible {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

.input {
  width: 100%;
  font-family: var(--font-serif);
  font-size: 16px;
  color: var(--text);
  padding: 14px 18px;
  border: 1.5px solid var(--line-strong);
  border-radius: var(--r-panel);
  background: var(--surface);
  outline: none;
  transition: border-color 0.18s;
}
.input:focus {
  border-color: var(--focus);
}

/* segmented toggle (Tree / Outline) */
.segment {
  display: flex;
  background: oklch(0.95 0.005 80);
  border: 1px solid var(--line-2);
  border-radius: var(--r-btn);
  padding: 2px;
}
.segment button {
  border: none;
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 6px;
  background: transparent;
  color: var(--text-3);
}
.segment button[aria-pressed="true"] {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 1px 3px oklch(0.4 0.02 70 / 0.18);
}

/* pills + badges */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 9px;
  border-radius: var(--r-pill);
  background: var(--surface-2);
  border: 1px solid var(--line);
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 500;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.pill .dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--muted);
  flex: 0 0 auto;
}
.pill.pillOk {
  background: var(--ok-bg);
  border-color: var(--ok-border);
  color: var(--ok-text);
}
.pill.pillOk .dot {
  background: var(--ok-dot);
}
.pill.pillGen {
  background: var(--gen-bg);
  border-color: var(--gen-border);
  color: var(--gen-text);
}
.pill.pillGen .dot {
  background: var(--gen-dot);
}
.pill.pillBad {
  background: oklch(0.96 0.03 40);
  border-color: var(--con-border);
  color: oklch(0.5 0.12 38);
}
.pill.pillBad .dot {
  background: oklch(0.6 0.14 38);
}

.workerMetrics {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 12px;
  margin-top: 28px;
}

.eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent);
}

.metaLine {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-size: 10.5px;
  font-weight: 500;
  color: var(--text-3);
  white-space: nowrap;
}
.modelDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--dot, var(--m-default));
  flex: 0 0 auto;
}

.muted {
  color: var(--muted);
}

.error {
  border: 1px solid var(--con-border);
  border-radius: var(--r-btn);
  background: oklch(0.97 0.03 40);
  color: oklch(0.45 0.12 35);
  padding: 10px 13px;
  font-size: 13.5px;
  overflow-wrap: anywhere;
}

.srOnly {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ============================================================
   Centered scrolling screen (library / new / settings)
   ============================================================ */

.screen {
  flex: 1;
  min-height: 0;
  overflow: auto;
}

.screenInner {
  margin: 0 auto;
  padding: 52px 28px 72px;
}
.screenInner.narrow {
  max-width: 680px;
}
.screenInner.wide {
  max-width: 880px;
}
.screenInner.medium {
  max-width: 760px;
}

.display {
  font-family: var(--font-serif);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.12;
  color: var(--text-strong);
  margin: 0;
}
.display.lg {
  font-size: 34px;
}
.display.md {
  font-size: 30px;
}
.display.sm {
  font-size: 26px;
}

.lede {
  font-family: var(--font-serif);
  font-size: 16px;
  line-height: 1.5;
  color: var(--text-2);
  margin: 12px 0 0;
  max-width: 600px;
}


/* ============================================================
   Drawers (detail / investigation / workspace)
   ============================================================ */

.drawerScrim {
  position: fixed;
  inset: 0;
  z-index: 54;
  background: oklch(0.3 0.02 70 / 0.2);
}
.drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 468px;
  max-width: 100vw;
  z-index: 55;
  background: var(--surface-2);
  border-left: 1px solid var(--line-strong);
  box-shadow: var(--shadow-drawer);
  display: flex;
  flex-direction: column;
  animation: de-slidein 0.28s cubic-bezier(0.2, 0.7, 0.2, 1) both;
}
.drawerHead {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 17px 20px;
  border-bottom: 1px solid var(--line);
}
.drawerHeadMeta {
  display: flex;
  align-items: center;
  gap: 9px;
}
.drawerBody {
  flex: 1;
  overflow: auto;
  padding: 22px;
}
.drawerClaim {
{
  "name": "dialectical-engine-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test:src": "node --test \"**/*.test.mjs\" \"**/*.source-test.mjs\"",
    "test:unit": "vitest run",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:full": "playwright test"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}

import { defineConfig } from "vitest/config";

export default defineConfig({
  test: {
    environment: "jsdom",
    include: ["tests/unit/**/*.test.{ts,tsx}"],
    setupFiles: ["./tests/setup.ts"],
    restoreMocks: true
  }
});

import { defineConfig, devices } from "@playwright/test";

const port = Number(process.env.PLAYWRIGHT_PORT ?? 3100);
const baseURL = `http://127.0.0.1:${port}`;
const smokeWidths = [320, 375, 1440] as const;

export default defineConfig({
  testDir: "./tests/e2e",
  outputDir: "./tests/.artifacts/playwright",
  fullyParallel: false,
  forbidOnly: Boolean(process.env.CI),
  retries: process.env.CI ? 2 : 0,
  workers: 1,
  reporter: "line",
  use: {
    baseURL,
    browserName: "chromium",
    trace: "retain-on-failure"
  },
  projects: smokeWidths.map((width) => ({
    name: `chromium-${width}`,
    use: {
      ...devices["Desktop Chrome"],
      viewport: { width, height: 900 }
    }
  })),
  webServer: {
    command: `pnpm exec next dev -H 127.0.0.1 -p ${port}`,
    url: baseURL,
    reuseExistingServer: !process.env.CI,
    timeout: 120_000
  }
});

import { expect, test } from "@playwright/test";

test("boots the application", async ({ page }, testInfo) => {
  const expectedWidth = Number(testInfo.project.name.replace("chromium-", ""));

  expect(page.context().browser()?.browserType().name()).toBe("chromium");
  expect(page.viewportSize()).toEqual({ width: expectedWidth, height: 900 });

  const response = await page.goto("/", { waitUntil: "domcontentloaded" });

  expect(response).not.toBeNull();
  expect(response?.ok()).toBe(true);
  await expect(page.locator("body")).toBeVisible();
  expect((await page.locator("body").innerText()).trim().length).toBeGreaterThan(0);

  if (testInfo.project.name === "chromium-1440") {
    const goldenResponse = await page.goto("/settings", { waitUntil: "domcontentloaded" });

    expect(goldenResponse?.ok()).toBe(true);
    await expect(page).toHaveScreenshot("app-shell-1440.png", {
      animations: "disabled",
      fullPage: true
    });
  }
});


