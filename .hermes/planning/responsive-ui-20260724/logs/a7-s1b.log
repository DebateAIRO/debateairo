  --m-gpt: oklch(0.52 0.07 200);
  --m-gemini: oklch(0.58 0.13 255);
  --m-grok: oklch(0.4 0.02 285);
  --m-qwen: oklch(0.56 0.13 320);
  --m-default: oklch(0.55 0.04 70);

  /* fonts */
  --font-serif: var(--font-serif), \"Source Serif 4\", Georgia, serif;
  --font-sans: var(--font-sans), \"Hanken Grotesk\", ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-mono), \"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", monospace;

  /* radii + shadow */
  --r-card: 13px;
  --r-panel: 12px;
  --r-btn: 8px;
  --r-pill: 20px;
  --shadow-card: 0 4px 18px -8px oklch(0.3 0.02 70 / 0.25);
  --shadow-pop: 0 18px 44px -14px oklch(0.3 0.03 70 / 0.42);
  --shadow-drawer: -22px 0 54px -22px oklch(0.3 0.03 70 / 0.42);
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

::selection {
  background: oklch(0.88 0.07 75);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
  color: inherit;
}

/* custom scrollbars */
.scroll::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
.scroll::-webkit-scrollbar-thumb {
  background: oklch(0.88 0.006 80);
  border-radius: 6px;
  border: 3px solid var(--bg);
}
.scroll::-webkit-scrollbar-track {
  background: transparent;
}

/* ---- keyframes ---- */
@keyframes de-blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}
@keyframes de-shimmer {
  0% { background-position: -360px 0; }
  100% { background-position: 360px 0; }
}
@keyframes de-fadeup {
  0% { opacity: 0; transform: translateY(6px); }
  100% { opacity: 1; transform: none; }
}
@keyframes de-popin {
  0% { opacity: 0; transform: scale(0.95) translateY(5px); }
  100% { opacity: 1; transform: none; }
}
@keyframes de-slidein {
  0% { transform: translateX(28px); opacity: 0; }
  100% { transform: none; opacity: 1; }
}
@keyframes de-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.fadeup {
  animation: de-fadeup 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.skel {
  background: linear-gradient(
    90deg,
    oklch(0.93 0.005 80) 25%,
    oklch(0.965 0.004 80) 50%,
    oklch(0.93 0.005 80) 75%
  );
  background-size: 720px 100%;
  animation: de-shimmer 1.4s linear infinite;
}
