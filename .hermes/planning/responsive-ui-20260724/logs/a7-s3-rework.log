+
+  await fit.click({ timeout: 3_000 });
+  if (injectedProbe) {
+    await expect(page.locator('.s3ZoomCollisionViewport[data-s3-zoom-probe="true"]')).toHaveAttribute(
+      "data-fit-activated",
+      "true"
+    );
+  } else {
