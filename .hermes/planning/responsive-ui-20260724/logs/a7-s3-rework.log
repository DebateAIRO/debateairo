  min-width: 100%;
  min-height: 100%;
}
.canvasLinks {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
  overflow: visible;
}
.canvasEmpty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.nodeWrap {
  position: absolute;
  transition: left 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), top 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.node {
  position: relative;
  border: 1.5px solid var(--line-2);
  border-radius: var(--r-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  padding: 14px 16px;
  cursor: default;
  transition: box-shadow 0.2s, border-color 0.2s;
}
.node[role="button"] {
  cursor: pointer;
}
.node[role="button"]:hover {
  box-shadow: 0 8px 24px -10px oklch(0.3 0.02 70 / 0.28);
}
.node.selected {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

.nodeEyebrow {
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 8px;
}

.nodeClaim {
  font-family: var(--font-serif);
  font-weight: 600;
  font-size: 15px;
  line-height: 1.32;
  color: var(--text-strong);
  letter-spacing: -0.005em;
  overflow-wrap: anywhere;
}
