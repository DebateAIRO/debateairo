test("debate route covers connecting, generating, completed, error, no-tree, and single-shot", async ({
  page
}) => {
  await page.goto("/debate/s8-delayed", { waitUntil: "domcontentloaded" });
  await expect(page.locator(".screenInner")).toContainText(/Connecting|Loading/);
