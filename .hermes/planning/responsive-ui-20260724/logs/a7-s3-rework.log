/* ============================================================
   Debate view shell
   ============================================================ */

.debateView {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  /* safe-area env() requires the viewportFit: "cover" export in app/layout.tsx */
  padding-bottom: calc(var(--token-dock-clearance) + env(safe-area-inset-bottom, 0px));
}

.debateTopBar {
  display: flex;
  align-items: center;
  gap: 18px;
  height: 60px;
  flex: 0 0 60px;
  min-width: 0;
  padding: 0 22px;
  border-bottom: 1px solid var(--line);
  background: var(--surface-2);
  z-index: 30;
}

.debateTopIdentityRow {
  display: flex;
  align-items: center;
  gap: 18px;
  flex: 1;
  min-width: 0;
}

.debateTopClaim {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: center;
}

.debateTopTitle {
  flex: 1 1 auto;
  min-width: 0;
  font-family: var(--font-serif);
  font-size: 14.5px;
  font-weight: 600;
  color: var(--text-strong);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 520px;
}

.debateTopControlRow {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 1 auto;
  min-width: 0;
}

.debateTopBar :where(a, button, summary) {
  min-height: 44px;
}

.debateTopBar .iconBtn {
  width: 44px;
  height: 44px;
  min-width: 44px;
}

.debateTopBar .segment {
  flex: 0 0 auto;
}

.debateTopBar .segment button {
  min-width: 44px;
  min-height: 44px;
  padding: 5px 10px;
}

.topSwitch {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  min-width: 0;
  min-height: 44px;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0;
  white-space: nowrap;
}

.topSwitch > span:first-child {
  flex: 0 0 auto;
}

.debateInlineActions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.debateOverflow {
  display: none;
}

.debateOverflowMenu {
  display: flex;
  align-items: center;
  gap: 8px;
}

.debateOverflowAction {
  flex: 0 0 auto;
}

.scoringInsightsStatus {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex: 0 1 auto;
  min-width: 0;
  max-width: min(40vw, 360px);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: oklch(0.48 0.04 70);
  font-size: 12px;
}

.scoringInsightsStatus > span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

[data-scoring-state="loading"] .scoringInsightsStatus {
  color: var(--muted);
}

[data-scoring-state="error"] .scoringInsightsStatus {
  color: oklch(0.52 0.14 28);
}

[data-scoring-state="unavailable"] .scoringInsightsStatus {
  color: oklch(0.48 0.08 70);
}

.scoringInsightsPanel {
  flex: 0 0 auto;
  border-bottom: 1px solid oklch(0.91 0.02 75);
  background: oklch(0.97 0.01 75);
}

.scoringInsightsSummary {
  position: relative;
  min-height: 36px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 22px;
  cursor: pointer;
  list-style: none;
}

.scoringInsightsSummary::-webkit-details-marker {
  display: none;
}

.scoringInsightsSummary::after {
  content: "Open";
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--muted);
  text-transform: uppercase;
}

.scoringInsightsPanel[open] .scoringInsightsSummary::after {
  content: "Close";
}

.scoringInsightsPanelCompact .scoringInsightsSummary {
  cursor: default;
}

.scoringInsightsPanelCompact .scoringInsightsSummary::after {
  content: "";
}

.scoringInsightsDetail {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted);
  font-size: 12px;
}

.scoringInsightsBody {
  max-height: min(36vh, 360px);
  overflow: auto;
  border-top: 1px solid oklch(0.91 0.02 75);
  background: var(--surface);
}

.scoringInsightsBody .progressStrip,
.scoringInsightsBody .recommendationsPanel {
  border-bottom: 1px solid oklch(0.91 0.02 75);
}

.scoringInsightsBody > :last-child {
  border-bottom: 0;
}

/* progress strip */
.progressStrip {
  flex: 0 0 auto;
--- responsive ---

/* ============================================================
   Responsive
   ============================================================ */

@media (max-width: 920px) {
  .synthPanel {
    display: none;
  }
  .debateTopTitle {
    max-width: 220px;
  }
}

@media (max-width: 768px) {
  :where(button, input, textarea, select) {
    font-size: max(16px, 1em) !important;
  }
}

@media (max-width: 640px) {
  .composer {
    flex-direction: column;
  }
  .startBtn {
    padding: 12px 22px;
    justify-content: center;
  }
  .singleShotGrid,
  .singleShotColumns,
  .wsColumns {
    grid-template-columns: 1fr;
  }
  .drawer {
    width: 100%;
  }
  .scoringIssueStrip,
  .adaptiveDepthStrip {
    flex-direction: column;
    padding-left: 14px;
    padding-right: 14px;
  }
  .scoringIssueIntro,
  .adaptiveDepthActions {
    flex-basis: auto;
    width: 100%;
    min-width: 0;
    max-width: none;
  }
  .scoringInsightsSummary {
    min-height: 44px;
    align-items: flex-start;
    flex-direction: column;
    gap: 4px;
    padding: 8px 14px;
  }
  .scoringInsightsSummary::after {
    position: absolute;
    right: 14px;
    top: 10px;
  }
  .scoringInsightsDetail {
    max-width: calc(100% - 64px);
    white-space: normal;
    line-height: 1.3;
  }
  .scoringInsightsBody {
    max-height: 34vh;
  }
  .recommendationsPanel {
    padding-left: 14px;
    padding-right: 14px;
  }
  .recommendationsList {
    grid-template-columns: 1fr;
  }
  .toast {
    left: 14px;
    right: 14px;
    bottom: 76px;
    transform: none;
    justify-content: center;
  }
}
