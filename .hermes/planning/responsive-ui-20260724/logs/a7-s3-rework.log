test("debate views cover Thread, Split, Tree, Map, scoring states, and all zoom bands", async ({ page }) => {
  await openCompleteDebate(page);

  const views = [
    { name: "Thread", selector: ".thread" },
    { name: "Split", selector: ".split" },
    { name: "Tree", selector: ".canvas" },
    { name: "Map", selector: ".map" }
  ] as const;
  for (const view of views) {
    const button = page.getByRole("button", { name: view.name, exact: true });
    await expectFullyInsideViewport(button, page);
    await button.click();
    await expect(button).toHaveAttribute("aria-pressed", "true");
    await expect(page.locator(view.selector)).toBeVisible({ timeout: 3_000 });
    await expectNoHorizontalOverflow(page);
  }

  const scoring = page.locator("details.scoringInsightsPanel");
  await expect(scoring).toBeVisible();
  await scoring.locator("summary").click();
  await expect(scoring).toHaveAttribute("open", "");
  await scoring.locator("summary").click();
  await expect(scoring).not.toHaveAttribute("open", "");

  await page.getByRole("button", { name: "Tree", exact: true }).click();
