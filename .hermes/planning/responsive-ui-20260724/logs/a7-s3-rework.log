  await page.goto("/debate/s8-generating", { waitUntil: "domcontentloaded" });
  await expect(page.locator(".pill")).toContainText("Generating");
  expect(await page.locator(".node").count()).toBeGreaterThanOrEqual(4);

  await openCompleteDebate(page);
