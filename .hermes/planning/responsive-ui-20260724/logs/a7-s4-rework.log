+        transformedAncestors.push({
+          className: ancestor.className,
+          tagName: ancestor.tagName,
+          transform
+        });
+      }
+      ancestor = ancestor.parentElement;
+    }
+
+    return {
+      siblingBeforeSizer:
+        sticky.parentElement === sizer.parentElement &&
+        sticky.nextElementSibling === sizer,
+      transformedAncestors
+    };
