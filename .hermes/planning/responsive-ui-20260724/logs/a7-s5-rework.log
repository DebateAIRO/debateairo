}

.scoringInsightsSummary {
  position: relative;
  min-height: 36px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 22px;
  cursor: pointer;
  list-style: none;
}

.scoringInsightsSummary::-webkit-details-marker {
  display: none;
}

.scoringInsightsSummary::after {
  content: "Open";
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--muted);
  text-transform: uppercase;
}

.scoringInsightsPanel[open] .scoringInsightsSummary::after {
  content: "Close";
}

.scoringInsightsPanelCompact .scoringInsightsSummary {
  cursor: default;
}

.scoringInsightsPanelCompact .scoringInsightsSummary::after {
  content: "";
}

.scoringInsightsDetail {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted);
  font-size: 12px;
}

.scoringInsightsBody {
  max-height: min(36vh, 360px);
  overflow: auto;
