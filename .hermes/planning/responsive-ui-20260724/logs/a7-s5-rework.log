n\r\n  /* radii + shadow */\r\n  --r-card: 13px;\r\n  --r-panel: 12px;\r\n  --r-btn: 8px;\r\n  --r-pill: 20px;\r\n  --shadow-card: 0 4px 18px -8px oklch(0.3 0.02 70 / 0.25);\r\n  --shadow-pop: 0 18px 44px -14px oklch(0.3 0.03 70 / 0.42);\r\n  --shadow-drawer: -22px 0 54px -22px oklch(0.3 0.03 70 / 0.42);\r\n}\r\n\r\n* {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml {\r\n  -webkit-text-size-adjust: 100%;\r\n  text-size-adjust: 100%;\r\n}\r\n\r\nhtml,\r\nbody {\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\nbody {\r\n  background: var(--bg);\r\n  color: var(--text);\r\n  font-family: var(--font-sans);\r\n  -webkit-font-smoothing: antialiased;\r\n  text-rendering: optimizeLegibility;\r\n}\r\n\r\n::selection {\r\n  background: oklch(0.88 0.07 75);\r\n}\r\n\r\na {\r\n  color: inherit;\r\n  text-decoration: none;\r\n}\r\n\r\nbutton,\r\ninput,\r\ntextarea,\r\nselect {\r\n  font: inherit;\r\n  color: inherit;\r\n}\r\n\r\n/* custom scrollbars */\r\n.scroll::-webkit-scrollbar {\r\n  width: 10px;\r\n  height: 10px;\r\n}\r\n.scroll::-webkit-scrollbar-thumb {\r\n  background: oklch(0.88 0.006 80);\r\n  border-radius: 6px;\r\n  border: 3px solid var(--bg);\r\n}\r\n.scroll::-webkit-scrollbar-track {\r\n  background: transparent;\r\n}\r\n\r\n/* ---- keyframes ---- */\r\n@keyframes de-blink {\r\n  0%, 49% { opacity: 1; }\r\n  50%, 100% { opacity: 0; }\r\n}\r\n@keyframes de-shimmer {\r\n  0% { background-position: -360px 0; }\r\n  100% { background-position: 360px 0; }\r\n}\r\n@keyframes de-fadeup {\r\n  0% { opacity: 0; transform: translateY(6px); }\r\n  100% { opacity: 1; transform: none; }\r\n}\r\n@keyframes de-popin {\r\n  0% { opacity: 0; transform: scale(0.95) translateY(5px); }\r\n  100% { opacity: 1; transform: none; }\r\n}\r\n@keyframes de-slidein {\r\n  0% { transform: translateX(28px); opacity: 0; }\r\n  100% { transform: none; opacity: 1; }\r\n}\r\n@keyframes de-pulse {\r\n  0%, 100% { opacity: 1; }\r\n  50% { opacity: 0.45; }\r\n}\r\n\r\n.fadeup {\r\n  animation: de-fadeup 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;\r\n}\r\n\r\n.skel {\r\n  background: linear-gradient(\r\n    90deg,\r\n    oklch(0.93 0.005 80) 25%,\r\n    oklch(0.965 0.004 80) 50%,\r\n    oklch(0.93 0.005 80) 75%\r\n  );\r\n  background-size: 720px 100%;\r\n  animation: de-shimmer 1.4s linear infinite;\r\n}\r\n\r\n/* ============================================================\r\n   App shell + top bar\r\n   ============================================================ */\r\n\r\n.appShell {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  width: 100%;\r\n}\r\n\r\n.topBar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 18px;\r\n  height: 60px;\r\n  flex: 0 0 60px;\r\n  padding: 0 22px;\r\n  border-bottom: 1px solid var(--line);\r\n  background: var(--surface-2);\r\n  z-index: 30;\r\n}\r\n\r\n.brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 11px;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.brandDiamond {\r\n  width: 26px;\r\n  height: 26px;\r\n  transform: rotate(45deg);\r\n  background: var(--ink);\r\n  border-radius: 5px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.brandDiamondCore {\r\n  width: 8px;\r\n  height: 8px;\r\n  background: var(--bg);\r\n  border-radius: 1px;\r\n}\r\n\r\n.brandName {\r\n  display: block;\r\n  font-weight: 700;\r\n  font-size: 14px;\r\n  letter-spacing: -0.01em;\r\n  line-height: 1;\r\n  white-space: nowrap;\r\n  color: var(--text);\r\n}\r\n\r\n.brandDomain {\r\n  display: block;\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  color: var(--muted-2);\r\n  margin-top: 2px;\r\n}\r\n\r\n.topBarContext {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.topBarDivider {\r\n  width: 1px;\r\n  height: 26px;\r\n  background: var(--line-2);\r\n}\r\n\r\n.topBarTitle {\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n  color: var(--text-2);\r\n}\r\n\r\n.topBarActions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n/* ============================================================\r\n   Buttons, inputs, pills\r\n   ============================================================ */\r\n\r\n.btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-family: var(--font-sans);\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  color: var(--text-2);\r\n  background: var(--surface-2);\r\n  border: 1px solid var(--line-2);\r\n  border-radius: var(--r-btn);\r\n  padding: 7px 12px;\r\n  cursor: pointer;\r\n  transition: background 0.18s, border-color 0.18s, color 0.18s;\r\n}\r\n.btn:hover {\r\n  background: oklch(0.96 0.005 80);\r\n}\r\n.btn:disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.btnDark {\r\n  background: var(--ink);\r\n  border-color: var(--ink);\r\n  color: oklch(0.97 0.005 85);\r\n}\r\n.btnDark:hover {\r\n  background: var(--ink-hover);\r\n}\r\n\r\n.btnGhost {\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--text-3);\r\n  padding: 6px 8px;\r\n}\r\n.btnGhost:hover {\r\n  background: oklch(0.95 0.005 80);\r\n}\r\n\r\n.btnChallenge {\r\n  color: var(--con-text);\r\n  background: oklch(0.97 0.03 60);\r\n  border-color: oklch(0.88 0.05 55);\r\n}\r\n.btnChallenge:hover {\r\n  background: oklch(0.95 0.04 60);\r\n}\r\n\r\n.iconBtn {\r\n  width: 32px;\r\n  height: 32px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border: 1px solid var(--line-2);\r\n  background: var(--surface-2);\r\n  border-radius: var(--r-btn);\r\n  font-size: 15px;\r\n  color: var(--text-3);\r\n  cursor: pointer;\r\n  transition: background 0.18s;\r\n}\r\n.iconBtn:hover {\r\n  background: oklch(0.96 0.005 80);\r\n}\r\n\r\n.btn:focus-visible,\r\n.iconBtn:focus-visible,\r\n.input:focus-visible,\r\ninput:focus-visible,\r\ntextarea:focus-visible,\r\nselect:focus-visible,\r\na:focus-visible {\r\n  outline: 2px solid var(--focus);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.input {\r\n  width: 100%;\r\n  font-family: var(--font-serif);\r\n  font-size: 16px;\r\n  color: var(--text);\r\n  padding: 14px 18px;\r\n  border: 1.5px solid var(--line-strong);\r\n  border-radius: var(--r-panel);\r\n  background: var(--surface);\r\n  outline: none;\r\n  transition: border-color 0.18s;\r\n}\r\n.input:focus {\r\n  border-color: var(--focus);\r\n}\r\n\r\n/* segmented toggle (Tree / Outline) */\r\n.segment {\r\n  display: flex;\r\n  background: oklch(0.95 0.005 80);\r\n  border: 1px solid var(--line-2);\r\n  border-radius: var(--r-btn);\r\n  padding: 2px;\r\n}\r\n.segment button {\r\n  border: none;\r\n  cursor: pointer;\r\n  font-family: var(--font-sans);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  padding: 5px 12px;\r\n  border-radius: 6px;\r\n  background: transparent;\r\n  color: var(--text-3);\r\n}\r\n.segment b'... 62884 more characters,
