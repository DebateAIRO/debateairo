@@ -3,20 +3,129 @@
    Tree canvas
    ============================================================ */
 
+.canvasViewport {
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+  position: relative;
+  display: flex;
+}
+
 .canvas {
   flex: 1;
   min-width: 0;
+  min-height: 0;
   position: relative;
   overflow: auto;
+  touch-action: none;
+  overscroll-behavior: contain;
   background:
     radial-gradient(oklch(0.94 0.005 80) 1px, transparent 1px);
   background-size: 22px 22px;
 }
+
+.canvasStickyToggle {
+  position: sticky;
+  top: 12px;
+  left: 12px;
+  z-index: var(--z-canvas-sticky);
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  margin: 12px;
+  padding: 7px 10px;
+  border: 1px solid var(--line-2);
+  border-radius: 8px;
+  background: var(--surface);
+  color: var(--text-2);
+  box-shadow: var(--shadow-card);
+}
+
+.canvasSizer {
+  position: relative;
+  flex: 0 0 auto;
+}
+
 .canvasInner {
   position: relative;
-  min-width: 100%;
-  min-height: 100%;
+  transform-origin: 0 0;
+  transition: transform 0.18s ease;
+}
+
+.canvasZoomCluster {
+  position: absolute;
+  right: 12px;
+  bottom: var(--zoom-cluster-offset-b);
+  z-index: var(--z-zoom-cluster);
+  width: var(--zoom-cluster-w);
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding: 4px;
+  border: 1px solid var(--line-2);
+  border-radius: 10px;
+  background: color-mix(in oklch, var(--surface) 94%, transparent);
+  box-shadow: var(--shadow-card);
+  backdrop-filter: blur(8px);
+}
+
+.canvasZoomButton {
+  min-width: 44px;
+  min-height: 44px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid var(--line-2);
+  border-radius: 7px;
+  background: var(--surface);
+  color: var(--text-strong);
+  font-family: var(--font-mono);
+  font-size: 13px;
+  font-weight: 700;
+  line-height: 1;
+  cursor: pointer;
+}
+
+.canvasZoomButton:hover {
+  background: var(--surface-sunken);
+}
+
+.canvasZoomButton:focus-visible {
+  outline: 2px solid var(--focus);
+  outline-offset: 2px;
+}
+
+.canvasZoomButton[aria-pressed="true"] {
+  border-color: var(--focus);
+  background: var(--surface-sunken);
+}
+
+.canvasZoomPercent {
+  min-width: 44px;
+  min-height: 26px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--text-2);
+  font-family: var(--font-mono);
