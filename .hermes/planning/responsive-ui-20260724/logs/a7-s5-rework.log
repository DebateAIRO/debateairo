  font-size: 14.5px;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.synthPro {
  border-color: var(--pro-border);
  background: var(--pro-bg);
}
.synthPro .synthCardClaim {
  color: oklch(0.28 0.03 165);
}
.synthCon {
  border-color: var(--con-border);
  background: var(--con-bg);
}
.synthCon .synthCardClaim {
  color: oklch(0.32 0.05 50);
}
.synthVerdict {
  border-color: oklch(0.88 0.006 80);
  background: oklch(0.27 0.012 70);
  color: oklch(0.92 0.005 85);
}
.synthVerdictMeta {
  font-family: var(--font-mono);
  font-size: 9.5px;
  color: oklch(0.75 0.01 80);
  overflow-wrap: anywhere;
  text-align: right;
}
.synthVerdictBody {
  font-family: var(--font-serif);
  font-size: 14px;
  line-height: 1.55;
  color: oklch(0.93 0.005 85);
}
.synthLean {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 13px;
  padding-top: 12px;
  border-top: 1px solid oklch(0.4 0.01 70);
}
.synthLeanLabel,
.synthLeanValue {
  font-family: var(--font-mono);
  font-size: 10px;
}
.synthLeanLabel {
  color: oklch(0.72 0.01 80);
}
.synthLeanValue {
  color: oklch(0.78 0.05 75);
}
.synthLeanBar {
  flex: 1;
  height: 5px;
  border-radius: 3px;
}
.synthSections {
  display: flex;
  flex-direction: column;
  gap: 13px;
}
.synthSection {
  border: 1px solid var(--line-2);
  border-radius: var(--r-panel);
  background: var(--surface);
  padding: 14px 15px;
}
.synthSectionTitle {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-2);
  margin-bottom: 8px;
}
.synthSectionList {
  margin: 0;
  padding-left: 17px;
  font-family: var(--font-serif);
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-2);
}
.synthSectionList li + li {
  margin-top: 6px;
}

/* streaming cursor for synthesis claims */
.cursor::after {
  content: "";
  display: inline-block;
  width: 7px;
  height: 15px;
  margin-left: 2px;
  vertical-align: -2px;
  background: currentColor;
  animation: de-blink 1s step-end infinite;
}

@media (max-width: 920px) {
  .synthTab {
    position: fixed;
    left: 14px;
    bottom: var(--dock-offset-b);
    z-index: var(--z-sheet);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    max-width: calc(100vw - 14px - var(--dock-collapsed-w) - 30px);
    padding: 0 11px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: oklch(0.27 0.012 70);
    box-shadow: 0 8px 22px -12px oklch(0.2 0.02 70 / 0.5);
    color: oklch(0.94 0.005 85);
    cursor: pointer;
    white-space: nowrap;
  }
  .synthTabDiamond {
    flex: 0 0 9px;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: oklch(0.78 0.05 75);
    transform: rotate(45deg);
  }
  .synthTabLabel {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-overflow: ellipsis;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .synthTabVerdict {
    flex: 0 0 auto;
    font-family: var(--font-serif);
    font-size: 12px;
    color: oklch(0.78 0.05 75);
  }
  .debateView:has(.tokenForm) [data-synth-tab] {
    visibility: hidden;
    pointer-events: none;
  }
  .synthScrim {
    position: fixed;
    inset: 0;
    z-index: var(--z-sheet);
    display: block;
    padding: 0;
    border: 0;
    background: oklch(0.18 0.01 70 / 0.48);
    cursor: pointer;
  }
  .synthPanel.synthPanel {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: calc(var(--z-sheet) + 1);

