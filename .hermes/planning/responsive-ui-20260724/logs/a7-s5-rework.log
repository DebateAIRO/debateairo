.canvas {
  flex: 1;
  min-width: 0;
  position: relative;
  overflow: auto;
  background:
    radial-gradient(oklch(0.94 0.005 80) 1px, transparent 1px);
  background-size: 22px 22px;
}
.canvasInner {
  position: relative;
  min-width: 100%;
  min-height: 100%;
}
.canvasLinks {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
  overflow: visible;
}
.canvasEmpty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.nodeWrap {
  position: absolute;
  transition: left 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), top 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.node {
  position: relative;
  border: 1.5px solid var(--line-2);
  border-radius: var(--r-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  padding: 14px 16px;
  cursor: default;
  transition: box-shadow 0.2s, border-color 0.2s;
}
.node[role="button"] {
  cursor: pointer;
}
.node[role="button"]:hover {
  box-shadow: 0 8px 24px -10px oklch(0.3 0.02 70 / 0.28);
}
.node.selected {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

.nodeEyebrow {
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 8px;
}


.scrutinyBadge {
  position: absolute;
  top: -11px;
  left: 14px;
  display: flex;
  align-items: center;
  gap: 5px;
  background: var(--surface);
  border: 1.5px solid;
  padding: 2px 9px;
  border-radius: var(--r-pill);
  box-shadow: 0 2px 6px -3px oklch(0.4 0.04 70 / 0.4);
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.scrutinyDot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  animation: de-pulse 1.6s ease-in-out infinite;
}

@media (max-height: 640px) and (orientation: landscape) {
