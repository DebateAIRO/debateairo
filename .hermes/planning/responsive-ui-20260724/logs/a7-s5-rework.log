/* ============================================================
   Tree canvas
   ============================================================ */

.canvasViewport {
  flex: 1;
  min-width: 0;
  min-height: 0;
  position: relative;
  display: flex;
}

.canvas {
  flex: 1;
  min-width: 0;
  min-height: 0;
  position: relative;
  overflow: auto;
  touch-action: none;
  overscroll-behavior: contain;
  background:
    radial-gradient(oklch(0.94 0.005 80) 1px, transparent 1px);
  background-size: 22px 22px;
}

.canvasStickyToggle {
  position: sticky;
  top: 12px;
  left: 12px;
  z-index: var(--z-canvas-sticky);
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin: 12px;
  padding: 7px 10px;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  background: var(--surface);
  color: var(--text-2);
  box-shadow: var(--shadow-card);
}

.canvasSizer {
  position: relative;
  flex: 0 0 auto;
}

.canvasInner {
  position: relative;
  transform-origin: 0 0;
  transition: transform 0.18s ease;
}

.canvasZoomCluster {
  position: absolute;
  right: 12px;
  bottom: var(--zoom-cluster-offset-b);
  z-index: var(--z-zoom-cluster);
  width: var(--zoom-cluster-w);
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--line-2);
  border-radius: 10px;
  background: color-mix(in oklch, var(--surface) 94%, transparent);
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(8px);
}

.canvasZoomButton {
  min-width: 44px;
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line-2);
  border-radius: 7px;
  background: var(--surface);
  color: var(--text-strong);
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 700;
  line-height: 1;
  cursor: pointer;
}

.canvasZoomButton:hover {
  background: var(--surface-sunken);
}

.canvasZoomButton:focus-visible {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

.canvasZoomButton[aria-pressed="true"] {
  border-color: var(--focus);
  background: var(--surface-sunken);
}

.canvasZoomPercent {
  min-width: 44px;
  min-height: 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.canvasInner[data-zoom-band="overview"] :is(
  .nodeHeader,
  .nodeControls,
  .nodeRootMeta,
  .nodeProse,
  .scrutinyBadge,
  .node > .roleBadge
) {
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
}

.canvasLinks {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
  overflow: visible;
}
.canvasEmpty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.nodeWrap {
  position: absolute;
  transition: left 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), top 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.node {
  position: relative;
  border: 1.5px solid var(--line-2);
  border-radius: var(--r-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  padding: 14px 16px;
  cursor: default;
  transition: box-shadow 0.2s, border-color 0.2s;
}
.node[role="button"] {
  cursor: pointer;
}
.node[role="button"]:hover {
  box-shadow: 0 8px 24px -10px oklch(0.3 0.02 70 / 0.28);
}
.node.selected {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

.nodeEyebrow {
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 8px;
}

.nodeClaim {
  font-family: var(--font-serif);
  font-weight: 600;
  font-size: 15px;
  line-height: 1.32;
  color: var(--text-strong);
  letter-spacing: -0.005em;
  overflow-wrap: anywhere;
}
.nodeClaim.root {
  font-size: 19px;
}
.nodeClaim.streaming {
  font-size: 15px;
}

.streamCursor {
  display: inline-block;
  width: 7px;
  height: 15px;
  margin-left: 1px;
  vertical-align: -2px;
  background: var(--text);
  animation: de-blink 1s step-end infinite;
}

.nodeHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 9px;
}

.roleBadge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border: 1px solid;
  padding: 2px 8px;
  border-radius: 5px;
  white-space: nowrap;
}

.scoreBadge {
  display: inline-flex;
  align-items: center;
  min-height: 20px;
  padding: 2px 7px;
  border: 1px solid var(--line-2);
  border-radius: 5px;
  background: var(--surface-sunken);
  color: var(--text-2);
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 700;
  white-space: nowrap;
}
.scoreBadgeButton {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8px;
  max-width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}
.scoreBadgeButton:focus-visible {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
  border-radius: 6px;
}
.scoreBadge.strength {
  border-color: var(--score-strength-border);
  background: var(--score-strength-bg);
  color: var(--score-strength-text);
}
.scoreBadge.uncertainty {
  border-color: var(--score-uncertainty-border);
  background: var(--score-uncertainty-bg);
  color: var(--score-uncertainty-text);
}
.scoreBadge.impact {
  border-color: var(--score-impact-border);
  background: var(--score-impact-bg);
  color: var(--score-impact-text);
}
.scoreBadge.unavailable {
  border-color: var(--line-strong);
  background: var(--surface-sunken);
  color: var(--muted);
}

.nodePending {
  margin-top: 4px;
}

.nodeProse {
  font-family: var(--font-serif);
  font-size: 13px;
  line-height: 1.55;
  color: var(--text-2);
  margin-top: 9px;
  max-height: 128px;
  overflow: auto;
  padding-right: 4px;
}

.nodeControls {
  display: flex;
  align-items: center;
  gap: 3px;
  margin-top: 11px;
  padding-top: 9px;
  border-top: 1px solid oklch(0.92 0.006 80);
}
.nodeCtrl {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border: none;
  background: transparent;
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text-3);
  padding: 4px 8px;
  border-radius: 6px;
}
.nodeCtrl:hover {
  background: oklch(0.95 0.005 80);
}
.nodeCtrl.challenge {
  color: oklch(0.52 0.06 55);
}
.nodeCtrl.challenge:hover {
  background: oklch(0.96 0.03 60);
}

.nodeRootMeta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 11px;
  padding-top: 9px;
  border-top: 1px solid oklch(0.92 0.006 80);
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted);
  flex-wrap: wrap;
}
.nodeRootMeta .sep {
  opacity: 0.4;
}

.nodeEmpty {
  display: flex;
  align-items: center;
  gap: 8px;
}
.nodeEmptyMark {
  font-size: 14px;
  opacity: 0.5;
}
.nodeEmptyText {
  font-family: var(--font-serif);
  font-size: 13.5px;
  font-style: italic;
  color: var(--text-3);
}

.scrutinyBadge {
  position: absolute;
  top: -11px;
  left: 14px;
  display: flex;
  align-items: center;
  gap: 5px;
  background: var(--surface);
  border: 1.5px solid;
  padding: 2px 9px;
  border-radius: var(--r-pill);
  box-shadow: 0 2px 6px -3px oklch(0.4 0.04 70 / 0.4);
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.scrutinyDot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  animation: de-pulse 1.6s ease-in-out infinite;
}

@media (max-height: 640px) and (orientation: landscape) {
  .canvasStickyToggle,
  .canvasZoomCluster {
    pointer-events: none;
  }

  .canvasStickyToggle > input,
  .canvasZoomButton {
    pointer-events: auto;
  }

  .canvasZoomCluster {
    right: calc(var(--dock-w) + 30px);
    bottom: var(--dock-offset-b);
    width: auto;
    max-width: calc(100% - var(--dock-w) - 48px);
    flex-direction: row;
    flex-wrap: wrap;
  }
}

@media (min-width: 769px) and (max-height: 640px) and (orientation: landscape) {
  .canvasZoomCluster {
    top: 12px;
    bottom: auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  .canvasInner,
  .nodeWrap {
    transition: none !important;
  }
}

  content: "";
  display: inline-block;
  width: 7px;
  height: 15px;
  margin-left: 2px;
  vertical-align: -2px;
  background: currentColor;
  animation: de-blink 1s step-end infinite;
}

@media (max-width: 920px) {
  .synthTab {
    position: fixed;
    left: 14px;
    bottom: var(--dock-offset-b);
    z-index: var(--z-sheet);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    max-width: calc(100vw - 14px - var(--dock-collapsed-w) - 30px);
    padding: 0 11px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: oklch(0.27 0.012 70);
    box-shadow: 0 8px 22px -12px oklch(0.2 0.02 70 / 0.5);
    color: oklch(0.94 0.005 85);
    cursor: pointer;
    white-space: nowrap;
  }
  .synthTabDiamond {
    flex: 0 0 9px;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: oklch(0.78 0.05 75);
    transform: rotate(45deg);
  }
  .synthTabLabel {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-overflow: ellipsis;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .synthTabVerdict {
    flex: 0 0 auto;
    font-family: var(--font-serif);
    font-size: 12px;
    color: oklch(0.78 0.05 75);
  }
  .debateView:has(.tokenForm) [data-synth-tab] {
    visibility: hidden;
    pointer-events: none;
  }
  .synthScrim {
    position: fixed;
    inset: 0;
    z-index: var(--z-sheet);
    display: block;
    padding: 0;
    border: 0;
    background: oklch(0.18 0.01 70 / 0.48);
    cursor: pointer;
  }
  .synthPanel.synthPanel {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: calc(var(--z-sheet) + 1);
    display: block;
    flex: none;
    width: 100%;
    max-height: 70vh;
    max-height: 70dvh;
    overflow: auto;
    border-top: 1px solid var(--line-strong);
    border-left: 0;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -18px 44px -24px oklch(0.18 0.02 70 / 0.62);
    visibility: hidden;
    pointer-events: none;
    transform: translateY(100%);
    transition:
      transform 180ms ease,
      visibility 0s linear 180ms;
  }
  .synthPanel.synthPanelOpen {
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }
  .synthInner {
    padding: 18px 16px calc(24px + var(--safe-b));
  }
  .synthTitle {
    min-height: 36px;
  }
  .synthClose {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin: -8px -8px -8px auto;
    padding: 0;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
  }
  .synthClose:hover {
    background: var(--surface-2);
  }
}

@media (max-width: 920px) and (max-height: 640px) and (orientation: landscape) {
  .synthTab {
    bottom: max(var(--dock-offset-b), var(--zoom-cluster-offset-b));
  }
}

