-
-.brandName {
-  display: block;
-  font-weight: 700;
-  font-size: 14px;
-  letter-spacing: -0.01em;
-  line-height: 1;
-  white-space: nowrap;
-  color: var(--text);
-}
-
-.brandDomain {
