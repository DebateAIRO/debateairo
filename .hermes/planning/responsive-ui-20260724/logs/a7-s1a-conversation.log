-  --surface-sunken: oklch(0.975 0.004 80);
-  --ink: oklch(0.27 0.012 70);
-  --ink-hover: oklch(0.32 0.012 70);
-
-  /* text */
-  --text: oklch(0.27 0.012 70);
-  --text-strong: oklch(0.24 0.012 70);
-  --text-2: oklch(0.4 0.012 70);
-  --text-3: oklch(0.5 0.01 70);
-  --muted: oklch(0.55 0.01 70);
-  --muted-2: oklch(0.6 0.01 70);
-
-  /* lines */
-  --line: oklch(0.91 0.006 80);
-  --line-2: oklch(0.9 0.006 80);
-  --line-strong: oklch(0.86 0.008 80);
-
-  /* brand / accents */
-  --accent: oklch(0.6 0.05 60);
-  --link: oklch(0.45 0.05 255);
-  --focus: oklch(0.6 0.04 70);
-
-  /* pro (sage) */
-  --pro-text: oklch(0.45 0.07 165);
-  --pro-bg: oklch(0.978 0.016 165);
-  --pro-border: oklch(0.85 0.045 165);
-  --pro-line: oklch(0.66 0.07 172);
-
-  /* con (clay) */
-  --con-text: oklch(0.53 0.1 50);
-  --con-bg: oklch(0.982 0.018 60);
-  --con-border: oklch(0.87 0.05 55);
-  --con-line: oklch(0.7 0.09 55);
-
-  /* status */
-  --ok-dot: oklch(0.58 0.1 165);
-  --ok-text: oklch(0.42 0.07 165);
-  --ok-bg: oklch(0.96 0.02 165);
-  --ok-border: oklch(0.86 0.04 165);
-  --gen-dot: oklch(0.66 0.12 75);
-  --gen-text: oklch(0.5 0.08 65);
-  --gen-bg: oklch(0.97 0.03 75);
-  --gen-border: oklch(0.88 0.05 75);
-
-  /* score bands */
-  --score-strength-border: oklch(0.7 0.06 145);
-  --score-strength-bg: oklch(0.96 0.025 145);
-  --score-strength-text: oklch(0.224 0.08 145);
-  --score-uncertainty-border: oklch(0.72 0.055 75);
-  --score-uncertainty-bg: oklch(0.965 0.026 75);
-  --score-uncertainty-text: oklch(0.238 0.075 75);
-  --score-impact-border: oklch(0.68 0.065 245);
-  --score-impact-bg: oklch(0.965 0.024 245);
-  --score-impact-text: oklch(0.23 0.085 245);
-
-  /* model dots */
-  --m-claude: oklch(0.64 0.13 40);
-  --m-gpt: oklch(0.52 0.07 200);
-  --m-gemini: oklch(0.58 0.13 255);
-  --m-grok: oklch(0.4 0.02 285);
-  --m-qwen: oklch(0.56 0.13 320);
-  --m-default: oklch(0.55 0.04 70);
-
-  /* fonts */
-  --font-serif: var(--font-serif), "Source Serif 4", Georgia, serif;
-  --font-sans: var(--font-sans), "Hanken Grotesk", ui-sans-serif, system-ui, sans-serif;
-  --font-mono: var(--font-mono), "JetBrains Mono", ui-monospace, "SFMono-Regular", monospace;
-
-  /* radii + shadow */
-  --r-card: 13px;
-  --r-panel: 12px;
-  --r-btn: 8px;
-  --r-pill: 20px;
-  --shadow-card: 0 4px 18px -8px oklch(0.3 0.02 70 / 0.25);
-  --shadow-pop: 0 18px 44px -14px oklch(0.3 0.03 70 / 0.42);
-  --shadow-drawer: -22px 0 54px -22px oklch(0.3 0.03 70 / 0.42);
-}
-
-* {
-  box-sizing: border-box;
-}
-
-html,
-body {
-  margin: 0;
-  padding: 0;
-}
-
-body {
-  background: var(--bg);
-  color: var(--text);
-  font-family: var(--font-sans);
-  -webkit-font-smoothing: antialiased;
-  text-rendering: optimizeLegibility;
-}
-
-::selection {
-  background: oklch(0.88 0.07 75);
-}
-
-a {
-  color: inherit;
-  text-decoration: none;
-}
-
-button,
-input,
-textarea,
-select {
-  font: inherit;
-  color: inherit;
-}
-
-/* custom scrollbars */
-.scroll::-webkit-scrollbar {
-  width: 10px;
-  height: 10px;
-}
-.scroll::-webkit-scrollbar-thumb {
-  background: oklch(0.88 0.006 80);
-  border-radius: 6px;
-  border: 3px solid var(--bg);
-}
-.scroll::-webkit-scrollbar-track {
-  background: transparent;
-}
-
-/* ---- keyframes ---- */
-@keyframes de-blink {
-  0%, 49% { opacity: 1; }
-  50%, 100% { opacity: 0; }
-}
-@keyframes de-shimmer {
-  0% { background-position: -360px 0; }
-  100% { background-position: 360px 0; }
-}
-@keyframes de-fadeup {
-  0% { opacity: 0; transform: translateY(6px); }
-  100% { opacity: 1; transform: none; }
-}
-@keyframes de-popin {
-  0% { opacity: 0; transform: scale(0.95) translateY(5px); }
-  100% { opacity: 1; transform: none; }
-}
-@keyframes de-slidein {
-  0% { transform: translateX(28px); opacity: 0; }
-  100% { transform: none; opacity: 1; }
-}
-@keyframes de-pulse {
-  0%, 100% { opacity: 1; }
-  50% { opacity: 0.45; }
-}
-
-.fadeup {
-  animation: de-fadeup 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
-}
-
-.skel {
-  background: linear-gradient(
-    90deg,
-    oklch(0.93 0.005 80) 25%,
-    oklch(0.965 0.004 80) 50%,
-    oklch(0.93 0.005 80) 75%
-  );
-  background-size: 720px 100%;
-  animation: de-shimmer 1.4s linear infinite;
-}
-
-/* ============================================================
-   App shell + top bar
-   ============================================================ */
-
-.appShell {
-  display: flex;
-  flex-direction: column;
-  min-height: 100vh;
-  width: 100%;
-}
-
-.topBar {
-  display: flex;
-  align-items: center;
-  gap: 18px;
-  height: 60px;
-  flex: 0 0 60px;
-  padding: 0 22px;
-  border-bottom: 1px solid var(--line);
-  background: var(--surface-2);
-  z-index: 30;
-}
-
-.brand {
-  display: flex;
-  align-items: center;
-  gap: 11px;
-  flex: 0 0 auto;
-}
-
-.brandDiamond {
-  width: 26px;
-  height: 26px;
-  transform: rotate(45deg);
-  background: var(--ink);
-  border-radius: 5px;
-  display: flex;
-  align-items: center;
-  justify-content: center;
-  flex: 0 0 auto;
-}
-
-.brandDiamondCore {
-  width: 8px;
-  height: 8px;
-  background: var(--bg);
-  border-radius: 1px;
-}
-
-.brandName {
-  display: block;
-  font-weight: 700;
-  font-size: 14px;
-  letter-spacing: -0.01em;
-  line-height: 1;
-  white-space: nowrap;
-  color: var(--text);
-}
-
-.brandDomain {
-  display: block;
-  font-family: var(--font-mono);
-  font-size: 10px;
-  color: var(--muted-2);
-  margin-top: 2px;
-}
-
-.topBarContext {
-  display: flex;
-  align-items: center;
-  gap: 14px;
-  flex: 1;
-  min-width: 0;
-}
-
-.topBarDivider {
-  width: 1px;
-  height: 26px;
-  background: var(--line-2);
-}
-
-.topBarTitle {
-  font-size: 13.5px;
-  font-weight: 600;
-  color: var(--text-2);
-}
-
-.topBarActions {
-  display: flex;
-  align-items: center;
-  gap: 8px;
-  flex: 0 0 auto;
-}
-
-/* ============================================================
-   Buttons, inputs, pills
-   ============================================================ */
-
-.btn {
-  display: inline-flex;
-  align-items: center;
-  gap: 6px;
-  font-family: var(--font-sans);
-  font-size: 12.5px;
-  font-weight: 600;
-  color: var(--text-2);
-  background: var(--surface-2);
-  border: 1px solid var(--line-2);
-  border-radius: var(--r-btn);
-  padding: 7px 12px;
-  cursor: pointer;
-  transition: background 0.18s, border-color 0.18s, color 0.18s;
-}
-.btn:hover {
-  background: oklch(0.96 0.005 80);
-}
-.btn:disabled {
-  opacity: 0.5;
-  cursor: not-allowed;
-}
-
-.btnDark {
-  background: var(--ink);
-  border-color: var(--ink);
-  color: oklch(0.97 0.005 85);
-}
-.btnDark:hover {
-  background: var(--ink-hover);
-}
-
-.btnGhost {
-  background: transparent;
-  border: none;
-  color: var(--text-3);
-  padding: 6px 8px;
-}
-.btnGhost:hover {
-  background: oklch(0.95 0.005 80);
-}
-
-.btnChallenge {
-  color: var(--con-text);
-  background: oklch(0.97 0.03 60);
-  border-color: oklch(0.88 0.05 55);
-}
-.btnChallenge:hover {
-  background: oklch(0.95 0.04 60);
-}
-
-.iconBtn {
-  width: 32px;
-  height: 32px;
-  display: inline-flex;
-  align-items: center;
-  justify-content: center;
-  border: 1px solid var(--line-2);
-  background: var(--surface-2);
-  border-radius: var(--r-btn);
-  font-size: 15px;
-  color: var(--text-3);
-  cursor: pointer;
-  transition: background 0.18s;
-}
-.iconBtn:hover {
-  background: oklch(0.96 0.005 80);
-}
-
-.btn:focus-visible,
-.iconBtn:focus-visible,
-.input:focus-visible,
-input:focus-visible,
-textarea:focus-visible,
-select:focus-visible,
-a:focus-visible {
-  outline: 2px solid var(--focus);
-  outline-offset: 2px;
-}
-
-.input {
-  width: 100%;
-  font-family: var(--font-serif);
-  font-size: 16px;
-  color: var(--text);
-  padding: 14px 18px;
-  border: 1.5px solid var(--line-strong);
-  border-radius: var(--r-panel);
-  background: var(--surface);
-  outline: none;
-  transition: border-color 0.18s;
-}
-.input:focus {
-  border-color: var(--focus);
-}
-
-/* segmented toggle (Tree / Outline) */
-.segment {
-  display: flex;
-  background: oklch(0.95 0.005 80);
-  border: 1px solid var(--line-2);
-  border-radius: var(--r-btn);
-  padding: 2px;
-}
-.segment button {
-  border: none;
-  cursor: pointer;
-  font-family: var(--font-sans);
-  font-size: 12px;
-  font-weight: 600;
-  padding: 5px 12px;
-  border-radius: 6px;
-  background: transparent;
-  color: var(--text-3);
-}
-.segment button[aria-pressed="true"] {
-  background: var(--surface);
-  color: var(--ink);
-  box-shadow: 0 1px 3px oklch(0.4 0.02 70 / 0.18);
-}
-
-/* pills + badges */
-.pill {
-  display: inline-flex;
-  align-items: center;
-  gap: 6px;
-  padding: 3px 9px;
-  border-radius: var(--r-pill);
-  background: var(--surface-2);
-  border: 1px solid var(--line);
-  font-family: var(--font-mono);
-  font-size: 10px;
-  font-weight: 500;
-  color: var(--muted);
-  text-transform: uppercase;
-  letter-spacing: 0.04em;
-  white-space: nowrap;
-}
-.pill .dot {
-  width: 6px;
-  height: 6px;
-  border-radius: 50%;
-  background: var(--muted);
-  flex: 0 0 auto;
-}
-.pill.pillOk {
-  background: var(--ok-bg);
-  border-color: var(--ok-border);
-  color: var(--ok-text);
-}
-.pill.pillOk .dot {
-  background: var(--ok-dot);
-}
-.pill.pillGen {
-  background: var(--gen-bg);
-  border-color: var(--gen-border);
-  color: var(--gen-text);
-}
-.pill.pillGen .dot {
-  background: var(--gen-dot);
-}
-.pill.pillBad {
-  background: oklch(0.96 0.03 40);
-  border-color: var(--con-border);
-  color: oklch(0.5 0.12 38);
-}
-.pill.pillBad .dot {
-  background: oklch(0.6 0.14 38);
-}
-
-.workerMetrics {
-  display: grid;
-  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
-  gap: 12px;
-  margin-top: 28px;
-}
-
-.eyebrow {
-  font-family: var(--font-mono);
-  font-size: 11px;
-  text-transform: uppercase;
-  letter-spacing: 0.1em;
-  color: var(--accent);
-}
-
-.metaLine {
-  display: inline-flex;
-  align-items: center;
-  gap: 5px;
-  font-family: var(--font-mono);
-  font-size: 10.5px;
-  font-weight: 500;
-  color: var(--text-3);
-  white-space: nowrap;
-}
-.modelDot {
-  width: 7px;
-  height: 7px;
-  border-radius: 50%;
-  background: var(--dot, var(--m-default));
-  flex: 0 0 auto;
-}
-
-.muted {
-  color: var(--muted);
-}
-
-.error {
-  border: 1px solid var(--con-border);
-  border-radius: var(--r-btn);
-  background: oklch(0.97 0.03 40);
-  color: oklch(0.45 0.12 35);
-  padding: 10px 13px;
-  font-size: 13.5px;
-  overflow-wrap: anywhere;
-}
-
-.srOnly {
-  position: absolute;
-  width: 1px;
-  height: 1px;
-  padding: 0;
-  margin: -1px;
-  overflow: hidden;
-  clip: rect(0, 0, 0, 0);
-  white-space: nowrap;
-  border: 0;
-}
-
-/* ============================================================
-   Centered scrolling screen (library / new / settings)
-   ============================================================ */
-
-.screen {
-  flex: 1;
-  min-height: 0;
-  overflow: auto;
-}
-
-.screenInner {
-  margin: 0 auto;
-  padding: 52px 28px 72px;
-}
-.screenInner.narrow {
-  max-width: 680px;
-}
-.screenInner.wide {
-  max-width: 880px;
-}
-.screenInner.medium {
-  max-width: 760px;
-}
-
-.display {
-  font-family: var(--font-serif);
-  font-weight: 600;
-  letter-spacing: -0.02em;
-  line-height: 1.12;
-  color: var(--text-strong);
-  margin: 0;
-}
-.display.lg {
-  font-size: 34px;
-}
-.display.md {
-  font-size: 30px;
-}
-.display.sm {
-  font-size: 26px;
-}
-
-.lede {
-  font-family: var(--font-serif);
-  font-size: 16px;
-  line-height: 1.5;
-  color: var(--text-2);
-  margin: 12px 0 0;
-  max-width: 600px;
-}
-
-/* ============================================================
-   Library
-   ============================================================ */
-
-.composer {
-  display: flex;
-  gap: 10px;
-  align-items: stretch;
-  margin: 26px 0 12px;
-}
-.composer .input {
-  flex: 1;
-}
-.startBtn {
