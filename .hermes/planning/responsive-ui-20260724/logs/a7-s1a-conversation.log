-  list-style: none;
-}
-
-.scoringInsightsSummary::-webkit-details-marker {
-  display: none;
-}
-
-.scoringInsightsSummary::after {
-  content: "Open";
-  margin-left: auto;
-  font-family: var(--font-mono);
-  font-size: 10.5px;
-  color: var(--muted);
