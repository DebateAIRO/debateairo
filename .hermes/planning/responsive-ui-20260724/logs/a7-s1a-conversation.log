-  text-transform: uppercase;
-  letter-spacing: 0;
-  white-space: nowrap;
-}
-
-.topSwitch > span:first-child,
-.topSwitch .switch,
-.topSwitch .btn,
-.topSwitch .iconBtn {
-  flex: 0 0 auto;
