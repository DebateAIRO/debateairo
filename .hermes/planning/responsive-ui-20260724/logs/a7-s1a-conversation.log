-
-/* progress strip */
-.progressStrip {
-  flex: 0 0 auto;
-  height: 34px;
-  display: flex;
-  align-items: center;
-  gap: 14px;
-  padding: 0 22px;
-  background: oklch(0.97 0.01 75);
-  border-bottom: 1px solid oklch(0.91 0.02 75);
-}
-.progressLabel {
-  font-family: var(--font-mono);
-  font-size: 10.5px;
-  color: oklch(0.5 0.04 60);
-  text-transform: uppercase;
-  letter-spacing: 0.05em;
-}
-.progressTrack {
-  flex: 1;
-  height: 4px;
-  background: oklch(0.92 0.01 75);
-  border-radius: 3px;
-  overflow: hidden;
