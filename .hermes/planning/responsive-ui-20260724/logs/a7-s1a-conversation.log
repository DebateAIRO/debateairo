-  display: inline-flex;
-  align-items: center;
-  gap: 7px;
-  font-family: var(--font-sans);
-  font-size: 15px;
-  font-weight: 600;
-  border: none;
-  border-radius: var(--r-panel);
-  padding: 0 22px;
-  cursor: pointer;
-  color: oklch(0.62 0.01 70);
-  background: oklch(0.85 0.008 80);
-  transition: background 0.2s, color 0.2s;
-}
-.startBtn.ready {
-  color: oklch(0.97 0.005 85);
-  background: var(--ink);
-}
-.startBtn.ready:hover {
-  background: var(--ink-hover);
-}
-.startBtn:disabled {
-  cursor: not-allowed;
-}
-
-.advancedLink {
-  display: inline-flex;
-  align-items: center;
-  gap: 6px;
-  border: none;
-  background: transparent;
-  cursor: pointer;
-  font-family: var(--font-sans);
-  font-size: 13px;
-  font-weight: 500;
-  color: var(--text-3);
-  padding: 0;
-}
-
-.sectionHead {
