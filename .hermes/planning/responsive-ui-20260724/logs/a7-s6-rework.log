/* ============================================================
   Responsive
   ============================================================ */

@media (max-width: 920px) {
  .synthPanel {
    display: none;
  }
  .debateTopTitle {
    max-width: 220px;
  }
}

@media (max-width: 768px) {
  :where(button, input, textarea, select) {
    font-size: max(16px, 1em) !important;
  }
}

@media (max-width: 640px) {
  .composer {
    flex-direction: column;
  }
  .startBtn {
    padding: 12px 22px;
    justify-content: center;
  }
  .singleShotGrid,
  .singleShotColumns,
  .wsColumns {
    grid-template-columns: 1fr;
  }
  .drawer {
    width: 100%;
  }
  .scoringIssueStrip,
  .adaptiveDepthStrip {
    flex-direction: column;
    padding-left: 14px;
    padding-right: 14px;
  }
  .scoringIssueIntro,
  .adaptiveDepthActions {
    flex-basis: auto;
    width: 100%;
    min-width: 0;
    max-width: none;
  }
  .scoringInsightsSummary {
    min-height: 44px;
    align-items: flex-start;
    flex-direction: column;
    gap: 4px;
    padding: 8px 14px;
  }
  .scoringInsightsSummary::after {
    position: absolute;
    right: 14px;
    top: 10px;
