/* ============================================================
   App shell + top bar
   ============================================================ */

.appShell {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  min-height: 100dvh;
  width: 100%;
}

.topBar {
  display: flex;
  align-items: center;
  gap: 18px;
  height: 60px;
  flex: 0 0 60px;
  padding: 0 22px;
  border-bottom: 1px solid var(--line);
  background: var(--surface-2);
  z-index: 30;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  flex: 0 0 auto;
}

.brandDiamond {
  width: 26px;
  height: 26px;
  transform: rotate(45deg);
  background: var(--ink);
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.brandDiamondCore {
  width: 8px;
  height: 8px;
  background: var(--bg);
  border-radius: 1px;
}

.brandName {
  display: block;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: -0.01em;
  line-height: 1;
  white-space: nowrap;
  color: var(--text);
}

.brandDomain {
  display: block;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted-2);
  margin-top: 2px;
}

.topBarContext {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  min-width: 0;
}

.topBarDivider {
  width: 1px;
  height: 26px;
  background: var(--line-2);
}

.topBarTitle {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-2);
}

.topBarActions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
}

