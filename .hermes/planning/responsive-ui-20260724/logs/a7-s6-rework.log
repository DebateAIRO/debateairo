  /* score bands */
  --score-strength-border: oklch(0.7 0.06 145);
  --score-strength-bg: oklch(0.96 0.025 145);
  --score-strength-text: oklch(0.224 0.08 145);
  --score-uncertainty-border: oklch(0.72 0.055 75);
  --score-uncertainty-bg: oklch(0.965 0.026 75);
  --score-uncertainty-text: oklch(0.238 0.075 75);
  --score-impact-border: oklch(0.68 0.065 245);
  --score-impact-bg: oklch(0.965 0.024 245);
  --score-impact-text: oklch(0.23 0.085 245);

  /* model dots */
  --m-claude: oklch(0.64 0.13 40);
  --m-gpt: oklch(0.52 0.07 200);
  --m-gemini: oklch(0.58 0.13 255);
  --m-grok: oklch(0.4 0.02 285);
  --m-qwen: oklch(0.56 0.13 320);
  --m-default: oklch(0.55 0.04 70);

  /* fonts */
  --font-serif: var(--font-serif), "Source Serif 4", Georgia, serif;
  --font-sans: var(--font-sans), "Hanken Grotesk", ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-mono), "JetBrains Mono", ui-monospace, "SFMono-Regular", monospace;

  /* canonical responsive breakpoints */
  --bp-480: 480px;
  --bp-640: 640px;
  --bp-768: 768px;
  --bp-920: 920px;
  --bp-1200: 1200px;

  /* collision map */
  --safe-b: env(safe-area-inset-bottom, 0px);      /* requires viewportFit: "cover" (Â§3.1) */
  --dock-w: min(360px, calc(100vw - 36px));        /* EXPANDED (unlock form) width cap */
  --dock-collapsed-w: 168px;                       /* hard cap on the COLLAPSED dock button */
  --dock-max-h: 96px;                              /* CAP for the EXPANDED unlock form (wrap allowed,
                                                      internal scroll beyond cap); collapsed â‰ˆ 44px */
  --dock-offset-b: calc(18px + var(--safe-b));
  --zoom-cluster-w: 52px;                          /* 44px controls + padding, vertical stack */
  --zoom-cluster-offset-b: calc(var(--dock-offset-b) + var(--dock-max-h) + 12px);
  --token-dock-clearance: calc(18px + var(--dock-max-h));  /* .debateView padding-bottom input */
  --z-canvas-sticky: 4; --z-zoom-cluster: 5; --z-dock: 40; --z-sheet: 50;
  --z-drawer: 55; --z-pop: 60; --z-modal: 70;

  /* radii + shadow */
  --r-card: 13px;
