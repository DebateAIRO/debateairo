+      hitTag: hit?.tagName ?? null,
+      point,
+      stickyRect: toRect(sticky)
+    };
+  });
+
+  expect(hitTest.cardOwnsCenter, `${browserName}: ${JSON.stringify(hitTest)}`).toBe(true);
