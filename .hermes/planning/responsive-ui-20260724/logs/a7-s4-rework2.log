+      hitClass: hit instanceof HTMLElement ? hit.className : null,
+      hitLabel: hit instanceof HTMLElement ? hit.getAttribute("aria-label") : null,
+      hitTag: hit?.tagName ?? null,
+      point,
+      stickyRect: toRect(sticky)
+    };
+  });
+
