/* ============================================================
   Tree canvas
   ============================================================ */

.canvasViewport {
  flex: 1;
  min-width: 0;
  min-height: 0;
  position: relative;
  display: flex;
}

.canvas {
  flex: 1;
  min-width: 0;
  min-height: 0;
  position: relative;
  overflow: auto;
  touch-action: none;
  overscroll-behavior: contain;
  background:
    radial-gradient(oklch(0.94 0.005 80) 1px, transparent 1px);
  background-size: 22px 22px;
}

.canvasStickyToggle {
  position: sticky;
  top: 12px;
  left: 12px;
  z-index: var(--z-canvas-sticky);
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin: 12px;
  padding: 7px 10px;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  background: var(--surface);
  color: var(--text-2);
  box-shadow: var(--shadow-card);
}

.canvasSizer {
  position: relative;
  flex: 0 0 auto;
}

.canvasInner {
  position: relative;
  transform-origin: 0 0;
  transition: transform 0.18s ease;
}

.canvasZoomCluster {
  position: absolute;
  right: 12px;
  bottom: var(--zoom-cluster-offset-b);
  z-index: var(--z-zoom-cluster);
  width: var(--zoom-cluster-w);
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--line-2);
  border-radius: 10px;
  background: color-mix(in oklch, var(--surface) 94%, transparent);
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(8px);
}

.canvasZoomButton {
  min-width: 44px;
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line-2);
  border-radius: 7px;
  background: var(--surface);
  color: var(--text-strong);
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 700;
  line-height: 1;
  cursor: pointer;
}

.canvasZoomButton:hover {
  background: var(--surface-sunken);
}

.canvasZoomButton:focus-visible {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
}

.canvasZoomButton[aria-pressed="true"] {
  border-color: var(--focus);
  background: var(--surface-sunken);
}

.canvasZoomPercent {
  min-width: 44px;
  min-height: 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.canvasInner[data-zoom-band="overview"] :is(
  .nodeHeader,
  .nodeControls,
  .nodeRootMeta,
  .nodeProse,
  .scrutinyBadge,
  .node > .roleBadge
) {
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
}

.canvasLinks {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
  overflow: visible;
}
.canvasEmpty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.nodeWrap {
  position: absolute;
  transition: left 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), top 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.node {
  position: relative;
  padding: 2px 9px;
  border-radius: var(--r-pill);
  box-shadow: 0 2px 6px -3px oklch(0.4 0.04 70 / 0.4);
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.scrutinyDot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  animation: de-pulse 1.6s ease-in-out infinite;
}

@media (max-height: 640px) and (orientation: landscape) {
  .canvasZoomCluster {
    right: calc(var(--dock-w) + 30px);
    bottom: var(--dock-offset-b);
    width: auto;
    max-width: calc(100% - var(--dock-w) - 48px);
    flex-direction: row;
    flex-wrap: wrap;
  }
}

@media (prefers-reduced-motion: reduce) {
  .canvasInner,
  .nodeWrap {
    transition: none !important;
  }
}

