+      pathStatus: "ACTIVE",
+      claimType: "CLAIM"
+    }
+  ],
+  reviews: [{
+    nodeReviewId: "review:1",
+    authorRawArtifactRef: "artifact:author",
+    reviewRawArtifactRef: "artifact:reviewer",
+    outcome: "PASS",
+    reasons: ["sound"]
+  }],
+  judgements: [{
+    reducedJudgementId: "judgement:1",
+    rawArtifactRef: "artifact:reviewer",
+    tau: 0.75,
+    numberKind: "PROBABILITY",
+    producer: "judge"
