+        run_id, pipeline, pipeline_version, attempt_id, state, reason, input_hash, at_seq
+      ) VALUES ($1,'HARVEST',$2,$3,$4,$5,$6,$7)
+    `, [runId, HARVEST_PIPELINE_VERSION, attemptId, state, reason, inputHash, await allocateSequence(client)]);
+  }
