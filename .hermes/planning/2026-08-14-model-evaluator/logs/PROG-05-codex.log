+  projectEvaluatorObservations,
+  type EvaluatorHarvestSnapshot
+} from "../../packages/evaluator/src/index.js";
+
+const snapshot: EvaluatorHarvestSnapshot = {
+  runId: "run:harvest",
+  domainId: null,
+  observedAt: new Date("2026-08-15T10:00:00.000Z"),
+  rawArtifacts: [
