        (ledger.allocate_sequence(),NULL,NULL,'MODEL_CALL','test:unmetered','node:unmetered',
          'UNASSIGNED','OK','provider:test','input','contract',NULL,now(),now())
      RETURNING ledger_entry_id
    `, [attemptId, artifactId]);
