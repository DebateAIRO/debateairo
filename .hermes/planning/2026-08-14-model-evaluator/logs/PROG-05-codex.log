+export const HARVEST_PIPELINE_VERSION = 1 as const;
+export const HARVEST_DERIVATION_VERSION = 1 as const;
+
+export interface EvaluatorHarvestArtifact {
+  readonly rawArtifactId: string;
+  readonly attemptId: string;
