         ]);
-        ids.push(inserted.rows[0]!.relative_cost_cell_id);
+        const insertedId = inserted.rows[0]?.relative_cost_cell_id;
+        if (insertedId !== undefined) ids.push(insertedId);
       }
       return Object.freeze(ids);
