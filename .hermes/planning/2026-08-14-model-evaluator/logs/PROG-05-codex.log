+      answerOutcomeId: "outcome:1",
+      step: "AUTHORING",
+      value: 1
+    });
+  });
+
+  it("is byte-for-byte deterministic for the same snapshot", () => {
+    expect(projectEvaluatorObservations(snapshot)).toEqual(projectEvaluatorObservations(snapshot));
+  });
+});

