+    expect(leniency).toMatchObject({ value: 0.325, n: 2 });
+    expect(contradiction).toMatchObject({ value: 1, n: 2 });
+    expect(result.judgeRanks.map((rank) => rank.modelId)).toEqual(["judge:b", "judge:a"]);
+    expect(result.prowessCells
