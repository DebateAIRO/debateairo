  uncertaintyDrivers: jsonb("uncertainty_drivers"),
  scoreCaps: jsonb("score_caps"),
  holes: jsonb("holes"),
  branchIdentifier: text("branch_identifier"),
  reducerVersion: text("reducer_version"),
