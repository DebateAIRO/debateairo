+      WHERE observation_id=$1 OR supersedes_observation_id=$1
+    `, [consensus.rows[0]!.observation_id]);
+    expect(auditHistory.rows[0]!.count).toBe("2");
+    const contradictions = await database.pool.query<{ model_id: string; value: number }>(`
