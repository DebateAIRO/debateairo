+        '{"resolved_outcome":false}'::jsonb,'SETTLEMENT','EXTERNAL_ANSWER_OUTCOME',$2,$2,1,$3,
+        '{"item_key":"answer:1"}'::jsonb,$4,ledger.allocate_sequence()
