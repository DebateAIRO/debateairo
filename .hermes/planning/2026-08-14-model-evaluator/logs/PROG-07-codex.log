+      ) VALUES (
+        $1,'provider:author','model:author','v1',NULL,'AUTHORING','prowess.outcome.v1',0,
+        '{"resolved_outcome":false}'::jsonb,'SETTLEMENT','EXTERNAL_ANSWER_OUTCOME',$2::text,$2::uuid,1,$3,
