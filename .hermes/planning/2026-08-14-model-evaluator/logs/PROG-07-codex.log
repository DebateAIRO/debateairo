+    const otherLineage = identityJudgements.filter((row) => row.subjectMaker !== null
+      && row.authorMaker !== null && row.subjectMaker !== row.authorMaker);
+    const lineageValues = sameLineage.length === 0 || otherLineage.length === 0 ? []
