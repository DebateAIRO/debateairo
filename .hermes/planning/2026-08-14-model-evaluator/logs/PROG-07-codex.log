+      ORDER BY as_of,derivation_version
+    `, [[FIRST_AS_OF, SECOND_AS_OF]]);
+    expect(leaders.rows).toEqual([
+      { as_of: FIRST_AS_OF, derivation_version: "1", model_id: "judge:a" },
+      { as_of: SECOND_AS_OF, derivation_version: "1", model_id: "judge:b" },
