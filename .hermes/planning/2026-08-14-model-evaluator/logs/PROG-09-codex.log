+    })).resolves.toMatchObject({ state: "FAILED", failures: 1 });
+    expect(gateway.call).not.toHaveBeenCalled();
+    expect(records.receipts).toEqual([
+      expect.objectContaining({ state: "SKIPPED", reason: "CONSUMER_PROVIDER_ISOLATION_FAILED" })
