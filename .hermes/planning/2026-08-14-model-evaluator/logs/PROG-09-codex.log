    LIMIT $2
  `, [HARVEST_PIPELINE_VERSION, limit, HARVEST_MAX_CONSECUTIVE_FAILURES]);
  const repository = new EvaluatorHarvestRepository(input.pool);
  const results: (
    | EvaluatorHarvestResult
