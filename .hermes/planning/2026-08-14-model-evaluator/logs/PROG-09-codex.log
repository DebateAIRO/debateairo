+} from "../../packages/evaluator/src/index.js";
+
+const family: EvaluatorProviderFamilyRow = {
+  rowKey: "evaluatorProviderFamily",
+  registerVersion: 7,
+  sourceRef: "register:test:evaluator-family",
+  value: {
+    kind: "EVALUATOR_PROVIDER_FAMILY",
