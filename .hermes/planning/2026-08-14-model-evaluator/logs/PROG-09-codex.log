+      ...baseInput,
+      provider: gateway,
+      repository: retryLimited
+    })).resolves.toMatchObject({ state: "SKIPPED", retryLimited: 1 });
+    expect(gateway.call).not.toHaveBeenCalled();
+  });
+});

