      ) VALUES (gen_random_uuid(),$1,$2,$3,$4,'agree','["sound"]'::jsonb,ledger.allocate_sequence())
    `, [runId, authorNode, authorArtifact, reviewerArtifact]);
    await database.pool.query(`
      INSERT INTO ledger.reduced_judgement (
