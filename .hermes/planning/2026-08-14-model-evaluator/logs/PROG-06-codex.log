+      provider: gateway,
+      repository: records
+    })).resolves.toEqual({ state: "SKIPPED", reason: "ADDON_RETRY_LIMIT_REACHED" });
+    expect(gateway.call).not.toHaveBeenCalled();
+  });
+
+  it("validates worker caller input before entering the repository failure boundary", async () => {
+    const query = vi.fn();
