+      pool: { query } as unknown as Pool,
+      runId: " ",
+      family,
+      deployment: baseInput.deployment,
+      provider: provider()
+    })).rejects.toThrow("EVALUATOR_ADDON_RUN_ID_INVALID");
+    expect(query).not.toHaveBeenCalled();
+  });
+});

