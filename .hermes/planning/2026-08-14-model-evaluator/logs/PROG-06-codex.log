+      'casual', 'ASKER', 'test:addon', 'low', '{}'::jsonb, 1, $1::jsonb, 0,
+      '{}'::jsonb, 1, 'test', '{}'::jsonb, ledger.allocate_sequence()
+    ) RETURNING run_id
+  `, [JSON.stringify(fixtureDiscoveredPanel(1))]);
