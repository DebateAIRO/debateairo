    })).resolves.toMatchObject({ state: "UNTAGGED", reason: "TAGGER_PROVIDER_ISOLATION_FAILED" });
    expect(gateway.call).not.toHaveBeenCalled();
    expect(records.events.at(-1)).toEqual(expect.objectContaining({ state: "FAILED" }));
  });
