+      'local/evaluator', $3, 'local/evaluator', '{}', '{}'::jsonb, 'PARSED',
+      repeat('b', 64), repeat('c', 64), repeat('a', 64), ledger.allocate_sequence()
+    ) RETURNING raw_artifact_id
