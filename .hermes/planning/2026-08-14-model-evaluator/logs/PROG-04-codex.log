+      admissions.push({ kind: "existing", input });
+      return {
+        decision: "MATCHED_EXISTING",
+        normalizedName: "computing & software",
+        domainId: "domain:software",
+        candidates: [{ domainId: "domain:software", normalizedName: "computing & software", similarity: 1 }],
