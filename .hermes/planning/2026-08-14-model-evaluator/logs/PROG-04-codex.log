+async function assertAdmissionArtifact(
+  client: PoolClient,
+  input: Omit<AdmitDomainProposalInput, "proposedName" | "provenanceRef">
+): Promise<void> {
+  if (input.rawArtifactRef === null) return;
+  const artifact = await client.query<{
+    run_id: string | null;
+    provider: string;
+    model_id: string;
+    model_version: string | null;
+  }>(`
