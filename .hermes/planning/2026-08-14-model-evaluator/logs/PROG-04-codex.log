+  async recordTagPipelineEvent(input: TagPipelineEventInput): Promise<string> {
+    requireNonblank(input.runId, "EVALUATOR_TAG_RUN_ID_INVALID");
+    requireNonblank(input.reason, "EVALUATOR_TAG_EVENT_REASON_INVALID");
