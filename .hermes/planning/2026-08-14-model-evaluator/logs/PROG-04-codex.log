+    input.domainId, JSON.stringify(input.candidates), DOMAIN_GUARDRAIL_VERSION,
+    input.rawArtifactRef, input.reason, await allocateSequence(client)
+  ]);
+  return admission.rows[0]!.domain_admission_id;
+}
