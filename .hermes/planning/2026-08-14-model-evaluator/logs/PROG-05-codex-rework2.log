  const rawQuestion = run.rows[0]?.question_line;
  if (rawQuestion === undefined) {
    return Object.freeze({ state: "UNTAGGED", reason: "TAGGER_RUN_UNRESOLVED" });
  }
  return runEvaluatorQuestionTagger({
