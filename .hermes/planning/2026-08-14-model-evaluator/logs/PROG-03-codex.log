+      "ADMITTED_NEW",
+      "REJECTED_NEAR_DUPLICATE"
+    ]);
+    const count = await database.pool.query<{ count: string }>(`
+      SELECT count(*)::text AS count FROM evaluator.domain
+      WHERE normalized_name IN ('robotics', 'robotic')
+    `);
