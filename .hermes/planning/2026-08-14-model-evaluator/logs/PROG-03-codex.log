+    ) VALUES ($1, lower($1), 'STARTER', 1, $2, now(), ledger.allocate_sequence())
+    RETURNING domain_id
+  `, [canonicalName, provenanceRef]);
+  return { domainId: result.rows[0]!.domain_id };
+}
