                AND prior.step='AUTHORING' AND prior.metric=$6
                AND prior.truth_basis='CONSENSUS' AND prior.source_kind='NODE_STRENGTH'
              LIMIT 1
            `, [row.runId, row.provider, row.modelId, row.modelVersion, row.domainId, row.metric]);
