+          selectedAt: options.evaluatorDevMenuClock?.() ?? new Date()
+        });
+        return reply.status(201).send(selection);
+      } catch (error) {
+        if (error instanceof TypedDomainError && [
+          "EVALUATOR_CATALOG_UNAVAILABLE",
+          "EVALUATOR_CONSUMER_MODEL_NOT_ENUMERATED"
+        ].includes(error.code)) {
