+      selectConsumerModel
+    };
+    const api = buildApi({ application: askApplication(), evaluatorDevMenu, evaluatorDevMenuRegisterVersion: 1 });
+
+    expect((await api.inject({ method: "GET", url: "/v1/dev/evaluator" })).statusCode).toBe(401);
+    const read = await api.inject({
