diff --git a/DebateAI-V3/tests/integration/evaluator-dev-menu-database.test.ts b/DebateAI-V3/tests/integration/evaluator-dev-menu-database.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..27507c871cba4f1478988a919491de9c056262e5
