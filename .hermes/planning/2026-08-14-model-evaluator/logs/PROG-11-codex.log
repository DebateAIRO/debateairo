@@ -14,6 +14,7 @@
 export * from "./blind-sample.js";
 export * from "./consumer.js";
 export * from "./consumer-postgres.js";
+export * from "./dev-menu.js";
 
 export const EVALUATOR_PROVIDER_FAMILY_ROW_KEY = "evaluatorProviderFamily" as const;
