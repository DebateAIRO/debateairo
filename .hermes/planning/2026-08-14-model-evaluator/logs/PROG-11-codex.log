+  ...(evaluatorDevMenu === undefined ? {} : {
+    evaluatorDevMenu,
+    evaluatorDevMenuRegisterVersion: environment.REGISTER_VERSION
+  })
+});
 await api.listen({ host: environment.API_HOST, port: environment.API_PORT });
