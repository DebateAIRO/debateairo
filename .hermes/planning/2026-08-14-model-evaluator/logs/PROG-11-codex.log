+}, 120_000);
+
+afterAll(async () => database?.stop());
+
+describe("evaluator dev-menu projections", () => {
+  it("shows real catalog, grown/starter provenance, harvested rows, profile ranks, parked receipts, and UNBOUND state", async () => {
