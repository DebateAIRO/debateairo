  adjacent_domain_flags jsonb NOT NULL CHECK (jsonb_typeof(adjacent_domain_flags)='array'),
  generated_raw_artifact_ref uuid NOT NULL REFERENCES ledger.raw_artifact(raw_artifact_id),
